{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Rocci Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "--disable-extensions",
        "${workspaceFolder}/crates/rocci-template/tests/fixtures"
      ],
      "env": {
        "VSCODE_DEBUG_MODE": "1"
      },
      "outFiles": [
        "${workspaceFolder}/editors/vscode/out/**/*.js"
      ],
      "preLaunchTask": "build-rocci-lsp-and-extension"
    }
  ]
}
