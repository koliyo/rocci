@page {
    route: "/",
    layout: "docs",
    meta: {
        title: "Hybrid counter",
        description: "CDN HTML with a SQLite-backed island and timezone click feed",
    },
}

@roc {
import pf.Env
import pf.Path
import pf.Sqlite
import pf.Stderr
import Origin
}

@context { db : Sqlite.Db }

@init {
    db_path =
        match Env.var!("DB_PATH") {
            Ok(path) => Path.from_os_str(path)
            Err(_) => Path.utf8("./counter.db")
        }
    db = Sqlite.open!(Sqlite.default_config(db_path))?
    Sqlite.execute!(
        {
            db,
            query: "CREATE TABLE IF NOT EXISTS counter (id INTEGER PRIMARY KEY, value INTEGER NOT NULL)",
            params: {},
        },
    )?
    Sqlite.execute!(
        {
            db,
            query: "INSERT OR IGNORE INTO counter (id, value) VALUES (1, 0)",
            params: {},
        },
    )?
    Sqlite.execute!(
        {
            db,
            query: "CREATE TABLE IF NOT EXISTS clicks (id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, handle TEXT NOT NULL, tz TEXT NOT NULL, country TEXT NOT NULL, city TEXT NOT NULL, region TEXT NOT NULL)",
            params: {},
        },
    )?
    { db: db }
}

@on:post("/actions/counter/sync") = |{ db }, request| {
    _ = request
    now_row : { now : I64 }
    now_row = Sqlite.query!(
        {
            db,
            query: "SELECT CAST(strftime('%s', 'now') AS INTEGER) AS now",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    now = now_row.now
    count_row : { value : I64 }
    count_row = Sqlite.query!(
        {
            db,
            query: "SELECT value FROM counter WHERE id = 1",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    rows : List({ ts : I64, handle : Str, tz : Str, country : Str, city : Str, region : Str })
    rows = Sqlite.query_many!(
        {
            db,
            query: "SELECT ts, handle, tz, country, city, region FROM clicks ORDER BY id DESC LIMIT 20",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    clicks = List.map(
        rows,
        |row| {
            place = Origin.lookup(row.tz)
            {
                handle: row.handle,
                flag: place.flag,
                place: Origin.place_label({
                    country: row.country,
                    city: row.city,
                    region: row.region,
                    flag: place.flag,
                }),
                ago: Origin.relative_ago(now, row.ts),
                ts: row.ts.to_str(),
            }
        },
    )
    counterCard({ count: count_row.value, clicks })
}

@on:post("/actions/counter/increment") = |{ db }, request| {
    body =
        match request.body().with_limit(8 * 1024).read_all!() {
            Ok(bytes) => Str.from_utf8_lossy(bytes)
            Err(_) => ""
        }
    tz_raw = Origin.signal_str(body, "tz")
    handle_raw = Origin.signal_str(body, "handle")
    tz = if tz_raw == "" { "UTC" } else { tz_raw }
    handle = if handle_raw == "" { "Visitor" } else { handle_raw }
    place = Origin.lookup(tz)
    now_row : { now : I64 }
    now_row = Sqlite.query!(
        {
            db,
            query: "SELECT CAST(strftime('%s', 'now') AS INTEGER) AS now",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    now = now_row.now
    recent : List({ ts : I64 })
    recent = Sqlite.query_many!(
        {
            db,
            query: "SELECT ts FROM clicks WHERE handle = :handle ORDER BY id DESC LIMIT 1",
            params: { handle: handle },
            limits: Sqlite.default_query_limits,
        },
    )?
    last =
        match List.get(recent, 0) {
            Ok(row) => row.ts
            Err(_) => 0.I64
        }
    _ =
        if now - last < 1.I64 {
            {}
        } else {
            Sqlite.execute!(
                {
                    db,
                    query: "INSERT INTO clicks (ts, handle, tz, country, city, region) VALUES (:ts, :handle, :tz, :country, :city, :region)",
                    params: {
                        ts: now,
                        handle: handle,
                        tz: tz,
                        country: place.country,
                        city: place.city,
                        region: place.region,
                    },
                },
            )?
            Sqlite.execute!(
                {
                    db,
                    query: "DELETE FROM clicks WHERE id NOT IN (SELECT id FROM clicks ORDER BY id DESC LIMIT 20)",
                    params: {},
                },
            )?
            Sqlite.execute!(
                {
                    db,
                    query: "UPDATE counter SET value = value + 1 WHERE id = 1",
                    params: {},
                },
            )?
            {}
        }
    count_row : { value : I64 }
    count_row = Sqlite.query!(
        {
            db,
            query: "SELECT value FROM counter WHERE id = 1",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    rows : List({ ts : I64, handle : Str, tz : Str, country : Str, city : Str, region : Str })
    rows = Sqlite.query_many!(
        {
            db,
            query: "SELECT ts, handle, tz, country, city, region FROM clicks ORDER BY id DESC LIMIT 20",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    clicks = List.map(
        rows,
        |row| {
            mapped = Origin.lookup(row.tz)
            {
                handle: row.handle,
                flag: mapped.flag,
                place: Origin.place_label({
                    country: row.country,
                    city: row.city,
                    region: row.region,
                    flag: mapped.flag,
                }),
                ago: Origin.relative_ago(now, row.ts),
                ts: row.ts.to_str(),
            }
        },
    )
    match Stderr.line!("counter increment count=${count_row.value.to_str()}") {
        Ok({}) => {}
        Err(_) => {}
    }
    counterCard({ count: count_row.value, clicks })
}

@on:post("/actions/counter/reset") = |{ db }| {
    Sqlite.execute!(
        {
            db,
            query: "UPDATE counter SET value = 0 WHERE id = 1",
            params: {},
        },
    )?
    Sqlite.execute!(
        {
            db,
            query: "DELETE FROM clicks",
            params: {},
        },
    )?
    match Stderr.line!("counter reset") {
        Ok({}) => {}
        Err(_) => {}
    }
    counterCard({ count: 0.I64, clicks: [] })
}

@component
CounterCard = |{ count, clicks }| {
    @css {
        section {
            margin: 1.25rem 0 0;
            padding: 1.15rem 1.25rem;
            border: 1px solid var(--rd-color-border);
            border-radius: 16px;
            background: var(--rd-color-surface);
        }
        .eyebrow {
            margin: 0 0 0.35rem;
            color: var(--rd-color-accent);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        output {
            display: block;
            color: var(--rd-color-text);
            font-family: ui-monospace, monospace;
            font-size: 4rem;
            font-weight: 650;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.04em;
        }
        .actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 1.25rem;
            flex-wrap: wrap;
        }
        button {
            appearance: none;
            border: 0;
            border-radius: 10px;
            padding: 0.7rem 1rem;
            background: var(--rd-color-accent);
            color: var(--rd-color-bg);
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }
        button.secondary {
            border: 1px solid var(--rd-color-border);
            background: transparent;
            color: var(--rd-color-muted);
        }
        .feed {
            margin: 1.35rem 0 0;
            padding: 0;
            list-style: none;
        }
        .feed li {
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 0.65rem 0.85rem;
            align-items: baseline;
            padding: 0.55rem 0;
            border-top: 1px solid var(--rd-color-border);
            font-size: 0.92rem;
        }
        .feed .flag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 2rem;
            padding: 0.15rem 0.35rem;
            border-radius: 6px;
            background: var(--rd-color-bg);
            border: 1px solid var(--rd-color-border);
            color: var(--rd-color-text);
            font-family: ui-monospace, monospace;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.04em;
        }
        .feed .who {
            font-weight: 650;
            color: var(--rd-color-text);
        }
        .feed .where {
            color: var(--rd-color-muted);
            font-size: 0.85rem;
        }
        .feed time {
            color: var(--rd-color-muted);
            font-size: 0.8rem;
            white-space: nowrap;
        }
        .privacy {
            margin: 1rem 0 0;
            color: var(--rd-color-muted);
            font-size: 0.8rem;
            line-height: 1.45;
        }
        .empty {
            margin: 1rem 0 0;
            color: var(--rd-color-muted);
            font-size: 0.9rem;
        }
    }
    <section
        id="counter"
        class="counter-card"
        data-signals="{tz: '', handle: ''}"
        data-init="$tz = Intl.DateTimeFormat().resolvedOptions().timeZone; $handle = sessionStorage.getItem('rocci-handle') || (sessionStorage.setItem('rocci-handle', ['Amber','Coral','Cedar','Indigo','Moss','Pearl','Sage','Sol'][Math.floor(Math.random()*8)] + ' ' + ['Lynx','Heron','Otter','Falcon','Cedar','Koi','Moth','Wren'][Math.floor(Math.random()*8)]), sessionStorage.getItem('rocci-handle')); @post('/actions/counter/sync')"
    >
        <p class="eyebrow">Shared count</p>
        <output>{count.to_str()}</output>
        <div class="actions">
            <button type="button" data-on:click=@post("/actions/counter/increment")>
                Increment
            </button>
            <button class="secondary" type="button" data-on:click=@post("/actions/counter/reset")>
                Reset
            </button>
        </div>
        @if List.is_empty(clicks) {
            <p class="empty">No clicks yet - be the first.</p>
        } @else {
            <ul class="feed" aria-label="Recent increments">
                @for click in clicks {
                    <li>
                        <span class="flag" aria-hidden="true">{click.flag}</span>
                        <div>
                            <div class="who">{click.handle}</div>
                            <div class="where">{click.place}</div>
                        </div>
                        <time datetime={click.ts}>{click.ago}</time>
                    </li>
                }
            </ul>
        }
        <p class="privacy">
            Origin comes from your browser timezone and a session nickname - no IP address is stored.
        </p>
    </section>
}

# Hybrid counter

Prose stays Markdown. The card below is pre-rendered into the CDN HTML at build
time (`count` is `0` in that snapshot). On load, the island syncs the live
count and last twenty clicks. Increment posts timezone and handle signals;
the service maps IANA timezones to country and city, then morphs `#counter`.

See [About](/about/) for a neighboring page that stays static.

@render {
    counterCard({ count: 0.I64, clicks: [] })
}
