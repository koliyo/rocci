@page {
    route: "/guides/rocdown/",
    draft: Bool.false,
    meta: {
        title: "Rocdown",
        description: "Markdown content with explicit Roc and Rocci islands",
    },
}

@roc {
published = "2026-08-15"

feature_count = 3.I64
}

@css {
    * { box-sizing: border-box; }
    body {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #f3f7f5;
        font-synthesis: none;
        margin: 0;
        min-height: 100vh;
        background:
            radial-gradient(circle at 78% 8%, rgba(55, 242, 159, 0.13), transparent 31rem),
            linear-gradient(145deg, #0a1713 0%, #07110e 55%, #071512 100%);
    }
    main {
        width: min(40rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 2.5rem 0 4rem;
    }
    h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2.4rem, 6vw, 3.4rem);
        letter-spacing: -0.04em;
        line-height: 1.1;
    }
    h2 {
        margin: 2rem 0 0.6rem;
        font-size: 1.35rem;
        letter-spacing: -0.02em;
    }
    p {
        margin: 0 0 1rem;
        color: #c9d8d2;
        font-size: 1.05rem;
        line-height: 1.65;
    }
    a {
        color: #48eda4;
        text-decoration-color: rgba(72, 237, 164, 0.4);
        text-underline-offset: 0.18em;
    }
    a:hover { color: #79f4bd; }
    pre {
        margin: 0 0 1.25rem;
        padding: 1rem 1.1rem;
        overflow-x: auto;
        border: 1px solid rgba(109, 236, 177, 0.2);
        border-radius: 12px;
        background: rgba(11, 30, 24, 0.72);
    }
    code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.92rem;
        color: #f8fffb;
    }
}

@component
FeatureCount = |{ count }| {
    @css {
        .feature-count {
            display: inline-flex;
            margin: 0 0 1.5rem;
            padding: 0.35rem 0.75rem;
            border: 1px solid rgba(109, 236, 177, 0.28);
            border-radius: 999px;
            background: rgba(72, 237, 164, 0.1);
            color: #48eda4;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.04em;
        }
    }
    <p class="feature-count">{count.to_str()} core ideas</p>
}

# Rocdown

Rocdown is a content-first format. Email us at docs@example.com or mention
@roclang normally.

@render {
    featureCount({ count: feature_count })
}

## Displayed code

This fence is documentation and is never evaluated:

```roc
answer = 42
```

The page remains static unless it references an island or defines server
routes.
