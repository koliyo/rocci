import Html
import Origin

Click : { flag : Str, place : Str, ago : Str, ts : Str, chosen : Bool }

empty_clicks : List(Click)
empty_clicks = []

## Morph target for the shared count (buttons and feed stay outside so SSE does not remount them).
@component
CounterCount = |{ count }| {
    @css {
        .counter-card {
            margin-top: 2rem;
            padding: 1.5rem 1.75rem;
            border: 1px solid var(--line, rgba(109, 236, 177, 0.2));
            border-radius: 16px;
            background: var(--surface, rgba(11, 30, 24, 0.72));
        }
        .eyebrow {
            margin: 0 0 0.35rem;
            color: var(--accent, #48eda4);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        output {
            display: block;
            color: var(--ink, #f8fffb);
            font-family: ui-monospace, monospace;
            font-size: 3.5rem;
            font-weight: 650;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.04em;
        }
    }
    <section id="counter" class="counter-card">
        <p class="eyebrow">Live shared count</p>
        <output>{count.to_str()}</output>
    </section>
}

## Morph target: recent clicks (up to 50 rows, five visible).
@component
CounterFeed = |{ clicks }| {
    @css {
        .feed-scroll {
            margin: 1.35rem 0 0;
            max-height: 11rem;
            overflow-y: auto;
            overscroll-behavior: contain;
        }
        .feed {
            margin: 0;
            padding: 0;
            list-style: none;
        }
        .feed li {
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 0.65rem 0.85rem;
            align-items: baseline;
            padding: 0.55rem 0;
            border-top: 1px solid var(--line, rgba(109, 236, 177, 0.2));
            font-size: 0.92rem;
        }
        .feed .flag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 2rem;
            padding: 0.15rem 0.35rem;
            border-radius: 6px;
            background: var(--canvas, rgba(7, 17, 14, 0.9));
            border: 1px solid var(--line, rgba(109, 236, 177, 0.2));
            color: var(--ink, #f8fffb);
            font-family: ui-monospace, monospace;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.04em;
        }
        .feed .where {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem 0.5rem;
            align-items: baseline;
            color: var(--ink, #f8fffb);
            font-size: 0.92rem;
        }
        .feed .chosen {
            display: inline-flex;
            align-items: center;
            padding: 0.1rem 0.4rem;
            border-radius: 999px;
            border: 1px solid var(--line, rgba(109, 236, 177, 0.2));
            color: var(--accent, #48eda4);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
        .feed time {
            color: var(--muted, #8da39a);
            font-size: 0.8rem;
            white-space: nowrap;
        }
        .empty {
            margin: 1.35rem 0 0;
            color: var(--muted, #8da39a);
            font-size: 0.9rem;
        }
    }
    <div id="counter-feed">
        @if List.is_empty(clicks) {
            <p class="empty">No clicks yet - be the first visitor.</p>
        } @else {
            <div class="feed-scroll">
                <ul class="feed" aria-label="Recent increments">
                    @for click in clicks {
                        <li>
                            <span class="flag" aria-hidden="true">{click.flag}</span>
                            <div class="where">
                                <span>{click.place}</span>
                                @if click.chosen {
                                    <span class="chosen">chosen</span>
                                }
                            </div>
                            <time datetime={click.ts}>{click.ago}</time>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
}

## Island fragment: count, controls (optional Reset), then feed. SSE morphs `#counter` and `#counter-feed` only.
@component
CounterIsland = |{ count, clicks, show_reset ?? False }| {
    @css {
        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: end;
            margin-top: 1.25rem;
        }
        .place-field {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            min-width: 12rem;
            flex: 1 1 12rem;
        }
        .place-field span {
            color: var(--muted, #8da39a);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .place-field select {
            appearance: none;
            border: 1px solid var(--line, rgba(109, 236, 177, 0.2));
            border-radius: 10px;
            padding: 0.7rem 0.9rem;
            background: var(--canvas, rgba(7, 17, 14, 0.9));
            color: var(--ink, #f8fffb);
            font: inherit;
        }
        button {
            appearance: none;
            border: 0;
            border-radius: 10px;
            padding: 0.7rem 1rem;
            background: var(--accent, #48eda4);
            color: var(--canvas, #06100c);
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }
        button.secondary {
            border: 1px solid var(--line, rgba(109, 236, 177, 0.2));
            background: transparent;
            color: var(--muted, #8da39a);
        }
        .privacy {
            margin: 1rem 0 0;
            color: var(--muted, #8da39a);
            font-size: 0.8rem;
            line-height: 1.45;
        }
    }
    <>
        <div
            data-signals="{tz: '', origin: ''}"
            data-init="$tz = Intl.DateTimeFormat().resolvedOptions().timeZone"
        ></div>
        <CounterCount count={count} />
        <div class="controls">
            <label class="place-field">
                <span>Place</span>
                <select
                    id="origin"
                    name="origin"
                    data-bind:origin
                    aria-label="Optional place override"
                >
                    <option value="">Automatic location (browser timezone)</option>
                    @for item in Origin.choices {
                        <option value={item.tz}>{item.label}</option>
                    }
                </select>
            </label>
            <button type="button" data-on:click=@post("/actions/counter/increment")>
                Increment
            </button>
            @if show_reset {
                <button
                    class="secondary"
                    type="button"
                    data-on:click=@post("/actions/counter/reset")
                >
                    Reset
                </button>
            }
        </div>
        <CounterFeed clicks={clicks} />
        <p class="privacy">
            Place comes from your browser timezone or a place you choose above.
            Either can be set by the client and is not verified — including
            without using this picker. No IP address is stored.
        </p>
    </>
}

@fixture{target: CounterCount}
counterCountTest = { count: 3.I64 }

@test{fixture: counterCountTest}
counterCountIsThree = counterCountTest.count == 3

@fixture{target: CounterFeed}
counterFeedTest = {
    clicks: [
        {
            flag: "SE",
            place: "Stockholm, Sweden",
            ago: "just now",
            ts: "0",
            chosen: True,
        },
    ],
}

@fixture{target: CounterIsland}
counterIslandTest = { count: 3.I64, clicks: empty_clicks, show_reset: False }

## Returned from `@get:live`: count and feed morph by id; controls stay on the page.
@component
LiveSlice = |{ count, clicks }|
    <>
        <CounterCount count={count} />
        <CounterFeed clicks={clicks} />
    </>

@fixture{target: LiveSlice}
liveSliceTest = { count: 3.I64, clicks: empty_clicks }
