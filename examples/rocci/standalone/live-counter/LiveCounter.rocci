import pf.Env
import pf.Path
import pf.Sqlite
import pf.Stderr
import Html
import Origin
import LiveCounterUi

## SQLite handle opened in `@init`. Shared with `@get:live` and commands.
@context { db : Sqlite.Db }

## Open or create `counter.db` (`DB_PATH` override). Failure exits the process.
@init {
    db_path =
        match Env.var!("DB_PATH") {
            Ok(path) => Path.from_os_str(path)
            Err(_) => Path.utf8("./counter.db")
        }
    db = Sqlite.open!(Sqlite.default_config(db_path))?
    Sqlite.execute!(
        {
            db,
            query: "CREATE TABLE IF NOT EXISTS counter (id INTEGER PRIMARY KEY, value INTEGER NOT NULL)",
            params: {},
        },
    )?
    Sqlite.execute!(
        {
            db,
            query: "INSERT OR IGNORE INTO counter (id, value) VALUES (1, 0)",
            params: {},
        },
    )?
    ensure_clicks!(db)?
    { db: db }
}

## Document GET `/`. Renders the page; the live card is a separate live fragment.
@get:view("/") = |{ db }| {
    count = read_count!(db)?
    clicks = read_clicks!(db)?
    counterPage({ count, clicks })
}

## Shared `#counter` and `#counter-feed` fragments for `GET /sse`.
@get:live("/sse") = |{ db }| {
    count = read_count!(db)?
    clicks = read_clicks!(db)?
    LiveCounterUi.liveSlice({ count, clicks })
}

## Increment and record click origin; commands intentionally return no representation.
@post:command("/actions/counter/increment") = |{ db }, request| {
    body =
        match request.body().with_limit(8 * 1024).read_all!() {
            Ok(bytes) => Str.from_utf8_lossy(bytes)
            Err(_) => ""
        }
    origin_pick = Origin.signal_str(body, "origin")
    tz_browser = Origin.signal_str(body, "tz")
    chosen = origin_pick != ""
    tz =
        if chosen {
            origin_pick
        } else if tz_browser == "" {
            "UTC"
        } else {
            tz_browser
        }
    place = Origin.lookup(tz)
    now = now_secs!(db)?
    chosen_flag : I64
    chosen_flag = if chosen { 1.I64 } else { 0.I64 }
    Sqlite.execute!(
        {
            db,
            query: "INSERT INTO clicks (ts, tz, country, city, region, chosen) VALUES (:ts, :tz, :country, :city, :region, :chosen)",
            params: {
                ts: now,
                tz: tz,
                country: place.country,
                city: place.city,
                region: place.region,
                chosen: chosen_flag,
            },
        },
    )?
    Sqlite.execute!(
        {
            db,
            query: "DELETE FROM clicks WHERE id NOT IN (SELECT id FROM clicks ORDER BY id DESC LIMIT 50)",
            params: {},
        },
    )?
    count = increment_count!(db)?
    match Stderr.line!("counter increment count=${count.to_str()}") {
        Ok({}) => {}
        Err(_) => {}
    }
    {}
}

## Reset count to zero (keeps click history); the live stream publishes the change.
@post:command("/actions/counter/reset") = |{ db }| {
    count = reset_count!(db)?
    match Stderr.line!("counter reset count=${count.to_str()}") {
        Ok({}) => {}
        Err(_) => {}
    }
    {}
}

clicks_ddl = "id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, tz TEXT NOT NULL, country TEXT NOT NULL, city TEXT NOT NULL, region TEXT NOT NULL, chosen INTEGER NOT NULL DEFAULT 0"

ensure_clicks! = |db| {
    create = "CREATE TABLE IF NOT EXISTS clicks (${clicks_ddl})"
    Sqlite.execute!({ db, query: create, params: {} })?
    row : { sql : Str }
    row = Sqlite.query!(
        {
            db,
            query: "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'clicks'",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    if Str.contains(row.sql, "chosen INTEGER") {
        Ok({})
    } else {
        Sqlite.execute!({ db, query: "DROP TABLE IF EXISTS clicks", params: {} })?
        Sqlite.execute!({ db, query: create, params: {} })?
        Ok({})
    }
}

now_secs! = |db| {
    row : { now : I64 }
    row = Sqlite.query!(
        {
            db,
            query: "SELECT CAST(strftime('%s', 'now') AS INTEGER) AS now",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    Ok(row.now)
}

read_count! = |db| {
    row : { value : I64 }
    row = Sqlite.query!(
        {
            db,
            query: "SELECT value FROM counter WHERE id = 1",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    Ok(row.value)
}

read_clicks! = |db| {
    now = now_secs!(db)?
    rows : List({ ts : I64, tz : Str, country : Str, city : Str, region : Str, chosen : I64 })
    rows = Sqlite.query_many!(
        {
            db,
            query: "SELECT ts, tz, country, city, region, chosen FROM clicks ORDER BY id DESC LIMIT 50",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    Ok(
        List.map(
            rows,
            |row| {
                mapped = Origin.lookup(row.tz)
                {
                    flag: mapped.flag,
                    place: Origin.place_label({
                        country: row.country,
                        city: row.city,
                        region: row.region,
                        flag: mapped.flag,
                    }),
                    ago: Origin.relative_ago(now, row.ts),
                    ts: row.ts.to_str(),
                    chosen: row.chosen != 0.I64,
                }
            },
        ),
    )
}

increment_count! = |db| {
    Sqlite.execute!(
        {
            db,
            query: "UPDATE counter SET value = value + 1 WHERE id = 1",
            params: {},
        },
    )?
    read_count!(db)
}

reset_count! = |db| {
    Sqlite.execute!(
        {
            db,
            query: "UPDATE counter SET value = 0 WHERE id = 1",
            params: {},
        },
    )?
    read_count!(db)
}

@component
CounterPage = |{ count, clicks }|
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Live counter</title>
            <script type="module" src="/assets/datastar.js"></script>
        </head>
        <body>
            <main>
                <nav>
                    <strong>Rocci</strong>
                    <span>Starter app</span>
                </nav>
                <header>
                    <h1>Live counter</h1>
                    <p class="lede">Two browsers share one SQLite count and recent click origins over an explicit stream. Commands return no representation; GET /sse morphs the count and feed in every tab. Reset is optional on the island.</p>
                </header>
                <LiveCounterUi.CounterIsland
                    count={count}
                    clicks={clicks}
                    show_reset={True}
                />
                <footer>The count is stored in SQLite and shared by every visitor.</footer>
            </main>
        </body>
    </html>

@fixture{target: CounterPage}
counterPageTest = { count: 3.I64, clicks: LiveCounterUi.empty_clicks }

@css {
    * { box-sizing: border-box; }
    body {
        color-scheme: dark;
        font-family: system-ui, sans-serif;
        color: #f3f7f5;
        margin: 0;
        min-height: 100vh;
        background:
            radial-gradient(circle at 80% 0%, rgba(72, 237, 164, 0.12), transparent 24rem),
            linear-gradient(145deg, #0a1713, #07110e);
        --accent: #48eda4;
        --ink: #f8fffb;
        --muted: #8da39a;
        --line: rgba(109, 236, 177, 0.2);
        --surface: rgba(11, 30, 24, 0.72);
        --canvas: #06100c;
    }
    main {
        width: min(40rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 2.5rem 0 4rem;
    }
    nav {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 2.5rem;
        color: #8da39a;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    nav strong {
        color: #48eda4;
        font-size: 1.1rem;
        letter-spacing: 0.16em;
    }
    h1 {
        margin: 0 0 0.6rem;
        font-size: 2.4rem;
        letter-spacing: -0.04em;
        line-height: 1.1;
    }
    .lede {
        margin: 0;
        max-width: 32rem;
        color: #a8bbb3;
        font-size: 1.05rem;
        line-height: 1.55;
    }
    footer {
        margin-top: 3rem;
        color: #6f857c;
        font-size: 0.85rem;
    }
}
