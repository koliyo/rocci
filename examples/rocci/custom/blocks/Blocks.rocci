import pf.Env
import pf.Path
import pf.Sqlite
import Game
import Html

## SQLite handle opened in `@init`. Solo board only; no room tables.
@context { db : Sqlite.Db }

## Open `blocks.db` (`DB_PATH` override) and seed one solo bag.
@init {
    db_path =
        match Env.var!("DB_PATH") {
            Ok(path) => Path.from_os_str(path)
            Err(_) => Path.utf8("./blocks.db")
        }
    db = Sqlite.open!(Sqlite.default_config(db_path))?
    Sqlite.execute!(
        {
            db,
            query: "CREATE TABLE IF NOT EXISTS solo (id INTEGER PRIMARY KEY CHECK (id = 1), board TEXT NOT NULL, piece TEXT NOT NULL, bag TEXT NOT NULL, seed INTEGER NOT NULL, board_revision INTEGER NOT NULL, sequence INTEGER NOT NULL, back_to_back INTEGER NOT NULL, eliminated INTEGER NOT NULL)",
            params: {},
        },
    )?
    opened = Game.draw_piece([], 1)
    params : SoloInsert
    params = {
        board: Game.empty_board,
        piece: opened.piece,
        bag: Game.encode_bag(opened.bag),
        seed: opened.seed,
    }
    Sqlite.execute!(
        {
            db,
            query: "INSERT OR IGNORE INTO solo (id, board, piece, bag, seed, board_revision, sequence, back_to_back, eliminated) VALUES (1, :board, :piece, :bag, :seed, 0, 0, 0, 0)",
            params,
        },
    )?
    { db: db }
}

SoloInsert : { board : Str, piece : Str, bag : Str, seed : I64 }
SoloRow : { board : Str, piece : Str, bag : Str, seed : I64, board_revision : I64, sequence : I64, back_to_back : I64, eliminated : I64 }
LockParams : { board : Str, piece : Str, bag : Str, seed : I64, board_revision : I64, sequence : I64, back_to_back : I64, eliminated : I64 }

## Solo play document. Shared room HTTP lives in `main.roc` from Phase 2.
@view("/") = |{ db }| {
    row = load_solo!(db)?
    playPage({ view: view_from_row(row) })
}

## JSON lock acknowledgement for the canvas island. Does not morph `#blocks-arena-state`.
@command("/command/lock") = |{ db }, request| {
    json = read_json_body!(request)
    apply_lock!(db, json)?
}

## Restart the solo board from a fresh bag.
@command("/command/reset") = |{ db }| {
    reset_solo!(db)?
}

load_solo! = |db| {
    row : SoloRow
    row = Sqlite.query!(
        {
            db,
            query: "SELECT board, piece, bag, seed, board_revision, sequence, back_to_back, eliminated FROM solo WHERE id = 1",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    Ok(row)
}

save_solo! = |db, row| {
    params : LockParams
    params = row
    Sqlite.execute!(
        {
            db,
            query: "UPDATE solo SET board = :board, piece = :piece, bag = :bag, seed = :seed, board_revision = :board_revision, sequence = :sequence, back_to_back = :back_to_back, eliminated = :eliminated WHERE id = 1",
            params,
        },
    )
}

reset_solo! = |db| {
    opened = Game.draw_piece([], 1)
    save_solo!(
        db,
        {
            board: Game.empty_board,
            piece: opened.piece,
            bag: Game.encode_bag(opened.bag),
            seed: opened.seed,
            board_revision: 0,
            sequence: 0,
            back_to_back: 0,
            eliminated: 0,
        },
    )?
    load_solo!(db).map_ok(ack_from_row)
}

apply_lock! = |db, json| {
    row = load_solo!(db)?
    sequence = json_i64(json, "sequence")
    if sequence == row.sequence and sequence != 0 {
        Ok(ack_from_row(row))
    } else if sequence != row.sequence + 1 {
        Ok(conflict(row, "DuplicateSequence"))
    } else if row.eliminated != 0 {
        Ok(conflict(row, "WrongPhase"))
    } else if json_i64(json, "board_revision") != row.board_revision {
        Ok(conflict(row, "StaleRevision"))
    } else {
        piece = json_str(json, "piece")
        if piece != row.piece {
            Ok(conflict(row, "UnknownPiece"))
        } else {
            rot = json_i64(json, "rotation")
            x = json_i64(json, "x")
            y = json_i64(json, "y")
            b2b = row.back_to_back != 0
            match Game.lock(row.board, piece, rot, x, y, b2b) {
                Err(UnknownPiece) => Ok(conflict(row, "UnknownPiece"))
                Err(BadRotation) => Ok(conflict(row, "BadRotation"))
                Err(InvalidGeometry) => Ok(conflict(row, "InvalidGeometry"))
                Ok(placed) => {
                    bag = Game.decode_bag(row.bag)
                    drawn = Game.draw_piece(bag, row.seed)
                    eliminated = if Game.spawn_ok(placed.board, drawn.piece) { 0 } else { 1 }
                    next = {
                        board: placed.board,
                        piece: drawn.piece,
                        bag: Game.encode_bag(drawn.bag),
                        seed: drawn.seed,
                        board_revision: row.board_revision + 1,
                        sequence,
                        back_to_back: if placed.back_to_back { 1 } else { 0 },
                        eliminated,
                    }
                    save_solo!(db, next)?
                    Ok(ack_from_row(next))
                }
            }
        }
    }
}

ack_from_row = |row|
    {
        ok: 1.I64,
        error: "",
        board: row.board,
        revision: row.board_revision,
        piece: row.piece,
        sequence: row.sequence,
        eliminated: row.eliminated,
    }

conflict = |row, error|
    {
        ok: 0.I64,
        error,
        board: row.board,
        revision: row.board_revision,
        piece: row.piece,
        sequence: row.sequence,
        eliminated: row.eliminated,
    }

view_from_row = |row| {
    status = if row.eliminated != 0 { "eliminated" } else { "alive" }
    {
        phase: "round",
        revision: row.board_revision,
        deadline_ms: 0.I64,
        round: 1.I64,
        piece: row.piece,
        winner: "",
        reason: "",
        seats: [
            {
                seat: 0.I64,
                status,
                board: row.board,
                target: 0.I64,
                queue: 0.I64,
                ready: 0.I64,
                piece: row.piece,
                you: 1.I64,
            },
        ],
    }
}

read_json_body! = |request| {
    match request.body().with_limit(4 * 1024).read_all!() {
        Ok(bytes) => Str.from_utf8_lossy(bytes)
        Err(_) => "{}"
    }
}

json_str = |json, key| {
    needle = "\"${key}\":"
    parts = Str.split_on(json, needle)
    match List.get(parts, 1) {
        Ok(after) => json_string_value(skip_ws(after))
        Err(_) => ""
    }
}

json_i64 = |json, key| {
    needle = "\"${key}\":"
    parts = Str.split_on(json, needle)
    match List.get(parts, 1) {
        Ok(after) =>
            match I64.from_str(take_num(skip_ws(after))) {
                Ok(n) => n
                Err(_) => 0
            }
        Err(_) => 0
    }
}

skip_ws = |text| skip_ws_bytes(Str.to_utf8(text))

skip_ws_bytes = |bytes|
    match List.get(bytes, 0) {
        Ok(byte) if byte == 32 or byte == 9 or byte == 10 or byte == 13 =>
            skip_ws_bytes(List.drop_first(bytes, 1))
        _ => Str.from_utf8_lossy(bytes)
    }

json_string_value = |text|
    if Str.starts_with(text, "\"") {
        read_json_string(Str.to_utf8(Str.drop_prefix(text, "\"")), 0, [], False)
    } else {
        ""
    }

read_json_string = |bytes, index, acc, escape|
    match List.get(bytes, index) {
        Err(_) => Str.from_utf8_lossy(acc)
        Ok(34) if escape == False => Str.from_utf8_lossy(acc)
        Ok(92) if escape == False => read_json_string(bytes, index + 1, acc, True)
        Ok(byte) if escape =>
            read_json_string(
                bytes,
                index + 1,
                List.append(
                    acc,
                    match byte {
                        34 => 34
                        92 => 92
                        110 => 10
                        116 => 9
                        114 => 13
                        _ => byte
                    },
                ),
                False,
            )
        Ok(byte) => read_json_string(bytes, index + 1, List.append(acc, byte), False)
    }

take_num = |text| take_num_bytes(Str.to_utf8(text), [])

take_num_bytes = |bytes, acc|
    match List.get(bytes, 0) {
        Ok(head) if (head >= 48 and head <= 57) or (head == 45 and List.is_empty(acc)) =>
            take_num_bytes(List.drop_first(bytes, 1), List.append(acc, head))
        _ => Str.from_utf8_lossy(acc)
    }

empty_board = Game.empty_board

sample_lobby = { player_count: 3.I64, full: False }

sample_seat = {
    seat: 0.I64,
    status: "alive",
    board: empty_board,
    target: 1.I64,
    queue: 0.I64,
    ready: 0.I64,
    piece: "T",
    you: 1.I64,
}

sample_active = {
    phase: "round",
    revision: 4.I64,
    deadline_ms: 0.I64,
    round: 1.I64,
    piece: "T",
    winner: "",
    reason: "",
    seats: [sample_seat],
}

sample_queued = {
    phase: "round",
    revision: 8.I64,
    deadline_ms: 0.I64,
    round: 1.I64,
    piece: "I",
    winner: "",
    reason: "",
    seats: [{ ..sample_seat, queue: 3.I64, ready: 1.I64, piece: "I" }],
}

sample_eliminated = {
    phase: "round",
    revision: 12.I64,
    deadline_ms: 0.I64,
    round: 1.I64,
    piece: "O",
    winner: "",
    reason: "",
    seats: [{ ..sample_seat, status: "eliminated", piece: "O" }],
}

sample_result = {
    phase: "result",
    revision: 13.I64,
    deadline_ms: 0.I64,
    round: 1.I64,
    piece: "T",
    winner: "Seat 0",
    reason: "Last player standing",
    seats: [{ ..sample_seat, status: "alive" }],
}

@component
Lobby = |{ player_count, full }|
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Rocci Blocks</title>
            <link rel="stylesheet" href="/assets/blocks.css" />
        </head>
        <body>
            <main class="lobby">
                <nav>
                    <strong>ROC</strong>
                    <span>Falling-block arena</span>
                </nav>
                <header>
                    <p class="eyebrow">Rocci Blocks</p>
                    <h1>Falling-block arena.</h1>
                    <p class="lede">One public room, eight seats, lock-driven authority. This preview is solo: motion stays in the browser, each lock is validated in Roc.</p>
                </header>
                <p class="count">{player_count.to_str()} ready, 8 max.</p>
                <div class="actions">
                    @if full {
                        <p class="count">Seats full — spectate instead.</p>
                    } @else {
                        <a class="button" href="/">Play</a>
                    }
                </div>
            </main>
        </body>
    </html>

@component
ArenaState = |{ view }|
    <div
        id="blocks-arena-state"
        data-revision={view.revision.to_str()}
        data-phase={view.phase}
        data-deadline-ms={view.deadline_ms.to_str()}
        data-round={view.round.to_str()}
    >
        @for seat in view.seats {
            <div
                data-seat={seat.seat.to_str()}
                data-status={seat.status}
                data-board={seat.board}
                data-target={seat.target.to_str()}
                data-queue={seat.queue.to_str()}
                data-ready={seat.ready.to_str()}
                data-piece={seat.piece}
                data-you={seat.you.to_str()}
            ></div>
        }
    </div>

@component
Hud = |{ view }|
    <aside id="blocks-hud" class="hud">
        <p class="eyebrow">Rocci Blocks</p>
        @match view.phase {
            "result" => <p class="overlay">Result</p>
            "lobby" => <p>Lobby</p>
            "countdown" => <p>Countdown</p>
            _ => <p>Round {view.round.to_str()}</p>
        }
        @for seat in view.seats {
            <p class={if seat.you != 0 { "you" } else { "" }}>
                Seat {seat.seat.to_str()} · {seat.status} · queue {seat.queue.to_str()}
            </p>
        }
    </aside>

@component
EliminatedBanner = |{}|
    <p class="overlay" id="eliminated-banner">Topped out — watching the round.</p>

@component
ResultCard = |{ winner, reason }|
    <section id="blocks-result" class="result">
        <p class="eyebrow">Result</p>
        <h2>{winner}</h2>
        <p>{reason}</p>
    </section>

@component
SteerPad = |{}|
    <div class="steer" aria-label="Controls">
        <button type="button" class="secondary" data-steer="ccw">CCW</button>
        <button type="button" class="secondary" data-steer="rot">CW</button>
        <button type="button" class="secondary" data-steer="left">Left</button>
        <button type="button" class="secondary" data-steer="right">Right</button>
        <button type="button" class="secondary" data-steer="down">Down</button>
        <button type="button" data-steer="drop">Drop</button>
    </div>

@component
PlayPage = |{ view }|
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Rocci Blocks</title>
            <link rel="stylesheet" href="/assets/blocks.css" />
            <script type="module" src="/assets/blocks-client.js"></script>
        </head>
        <body>
            <main class="play">
                <nav>
                    <strong>ROC</strong>
                    <span>Solo preview · lock-validated</span>
                </nav>
                <div class="stage">
                    <canvas id="blocks-canvas" width="300" height="600" aria-label="Board"></canvas>
                    <SteerPad />
                    @match (List.get(view.seats, 0)) {
                        Ok(seat) if seat.status == "eliminated" => <EliminatedBanner />
                        _ => <></>
                    }
                </div>
                <div class="side">
                    <Hud view={view} />
                    @match view.phase {
                        "result" => <ResultCard winner={view.winner} reason={view.reason} />
                        _ => <></>
                    }
                    <ArenaState view={view} />
                    <button class="secondary" type="button" data-reset>Reset</button>
                </div>
            </main>
        </body>
    </html>

@fixture{target: Lobby}
lobbyTest = sample_lobby

@fixture{target: ArenaState}
arenaActiveTest = { view: sample_active }

@fixture{target: ArenaState}
arenaQueuedTest = { view: sample_queued }

@fixture{target: ArenaState}
arenaEliminatedTest = { view: sample_eliminated }

@fixture{target: Hud}
hudQueuedTest = { view: sample_queued }

@fixture{target: EliminatedBanner}
eliminatedBannerTest = {}

@fixture{target: ResultCard}
resultCardTest = { winner: "Seat 0", reason: "Last player standing" }

@fixture{target: PlayPage}
playActiveTest = { view: sample_active }

@fixture{target: PlayPage}
playQueuedTest = { view: sample_queued }

@fixture{target: PlayPage}
playEliminatedTest = { view: sample_eliminated }

@fixture{target: PlayPage}
playResultTest = { view: sample_result }
