import Game
import Html

empty_board = Game.empty_board

sample_lobby = { player_count: 3.I64, full: False }

sample_seat = {
    seat: 0.I64,
    status: "alive",
    board: empty_board,
    target: 1.I64,
    queue: 0.I64,
    ready: 0.I64,
    piece: "T",
    you: 1.I64,
}

sample_active = {
    phase: "round",
    revision: 4.I64,
    deadline_ms: 0.I64,
    round: 1.I64,
    piece: "T",
    winner: "",
    reason: "",
    now_ms: 0.I64,
    watching: 0.I64,
    seats: [sample_seat],
}

sample_queued = {
    phase: "round",
    revision: 8.I64,
    deadline_ms: 0.I64,
    round: 1.I64,
    piece: "I",
    winner: "",
    reason: "",
    now_ms: 0.I64,
    watching: 0.I64,
    seats: [{ ..sample_seat, queue: 3.I64, ready: 1.I64, piece: "I" }],
}

sample_eliminated = {
    phase: "round",
    revision: 12.I64,
    deadline_ms: 0.I64,
    round: 1.I64,
    piece: "O",
    winner: "",
    reason: "",
    now_ms: 0.I64,
    watching: 0.I64,
    seats: [{ ..sample_seat, status: "eliminated", piece: "O" }],
}

sample_result = {
    phase: "result",
    revision: 13.I64,
    deadline_ms: 0.I64,
    round: 1.I64,
    piece: "T",
    winner: "Seat 0",
    reason: "Last player standing",
    now_ms: 0.I64,
    watching: 0.I64,
    seats: [{ ..sample_seat, status: "alive" }],
}

## Lobby document. Join/leave live in `main.roc`.
@component
Lobby = |{ player_count, full }|
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Rocci Blocks</title>
            <link rel="stylesheet" href="/play/blocks/assets/blocks.css" />
        </head>
        <body>
            <main class="lobby">
                <nav>
                    <strong>ROC</strong>
                    <span>Falling-block arena</span>
                </nav>
                <header>
                    <p class="eyebrow">Rocci Blocks</p>
                    <h1>Falling-block arena.</h1>
                    <p class="lede">One public room. Roc validates every lock. Two to eight players; late arrivals wait for the next round.</p>
                </header>
                <p class="count">{player_count.to_str()} seated, 8 max.</p>
                <div class="actions">
                    <a class="button secondary" href="/play/blocks/watch">Spectate</a>
                    @if full {
                        <p class="count">Seats full this round.</p>
                    } @else {
                        <form method="post" action="/play/blocks/join">
                            <button type="submit">Join</button>
                        </form>
                    }
                </div>
            </main>
        </body>
    </html>

@component
ArenaState = |{ view }|
    <div
        id="blocks-arena-state"
        data-revision={view.revision.to_str()}
        data-phase={view.phase}
        data-deadline-ms={view.deadline_ms.to_str()}
        data-round={view.round.to_str()}
    >
        @for seat in view.seats {
            <div
                data-seat={seat.seat.to_str()}
                data-status={seat.status}
                data-board={seat.board}
                data-target={seat.target.to_str()}
                data-queue={seat.queue.to_str()}
                data-ready={seat.ready.to_str()}
                data-piece={seat.piece}
                data-board-revision={seat.board_revision.to_str()}
                data-you={seat.you.to_str()}
            ></div>
        }
    </div>

@component
Hud = |{ view }|
    <aside id="blocks-hud" class="hud">
        <p class="eyebrow">Rocci Blocks</p>
        @match view.phase {
            "result" => <p class="overlay">Result</p>
            "lobby" => <p>Lobby</p>
            "countdown" => <p>Countdown</p>
            _ => <p>Round {view.round.to_str()}</p>
        }
        @for seat in view.seats {
            <p class={if seat.you != 0 { "you" } else { "" }}>
                Seat {seat.seat.to_str()} · {seat.status} · queue {seat.queue.to_str()}
            </p>
        }
        @if view.watching != 0 {
            <a class="button secondary" href="/play/blocks/">Back</a>
        } @else {
            <form method="post" action="/play/blocks/leave">
                <button class="secondary" type="submit">Leave</button>
            </form>
        }
    </aside>

@component
EliminatedBanner = |{}|
    <p class="overlay" id="eliminated-banner">Topped out — watching the round.</p>

@component
ResultCard = |{ winner, reason }|
    <section id="blocks-result" class="result">
        <p class="eyebrow">Result</p>
        <h2>{winner}</h2>
        <p>{reason}</p>
    </section>

@component
SteerPad = |{}|
    <div class="steer" aria-label="Controls">
        <button type="button" class="secondary" data-steer="ccw">CCW</button>
        <button type="button" class="secondary" data-steer="rot">CW</button>
        <button type="button" class="secondary" data-steer="left">Left</button>
        <button type="button" class="secondary" data-steer="right">Right</button>
        <button type="button" class="secondary" data-steer="down">Down</button>
        <button type="button" data-steer="drop">Drop</button>
    </div>

@component
KeepAlive = |{ ts }|
    <span id="blocks-keepalive" hidden data-ts={ts.to_str()}></span>

@component
CapacityReached = |{}|
    <p id="blocks-capacity">Spectator capacity reached. Try again later.</p>

@component
GamePatch = |{ view }|
    <>
        <ArenaState view={view} />
        <Hud view={view} />
        <KeepAlive ts={view.now_ms} />
        <p id="blocks-capacity" hidden></p>
        @match view.phase {
            "result" => <ResultCard winner={view.winner} reason={view.reason} />
            _ => <section id="blocks-result" class="result" hidden></section>
        }
    </>

@component
PlayPage = |{ view }|
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Rocci Blocks</title>
            <link rel="stylesheet" href="/play/blocks/assets/blocks.css" />
            <script type="module" src="/play/blocks/assets/datastar.js"></script>
            <script type="module" src="/play/blocks/assets/blocks-client.js"></script>
        </head>
        <body data-init=@get("/play/blocks/stream")>
            <main class="play">
                <nav>
                    <strong>ROC</strong>
                    <span>Lock-validated arena</span>
                </nav>
                <div class="stage">
                    <canvas id="blocks-canvas" width="300" height="600" aria-label="Board"></canvas>
                    @if view.watching == 0 {
                        <SteerPad />
                    }
                    @match (List.get(view.seats, 0)) {
                        Ok(seat) if seat.status == "eliminated" and seat.you != 0 => <EliminatedBanner />
                        _ => <></>
                    }
                </div>
                <div class="side">
                    <Hud view={view} />
                    @match view.phase {
                        "result" => <ResultCard winner={view.winner} reason={view.reason} />
                        _ => <section id="blocks-result" class="result" hidden></section>
                    }
                    <ArenaState view={view} />
                    <KeepAlive ts={view.now_ms} />
                    <p id="blocks-capacity" hidden></p>
                    @if view.phase == "lobby" and view.watching == 0 {
                        <form method="post" action="/play/blocks/command/ready">
                            <button type="submit">Ready</button>
                        </form>
                    }
                </div>
            </main>
        </body>
    </html>

@fixture{target: Lobby}
lobbyTest = sample_lobby

@fixture{target: ArenaState}
arenaActiveTest = { view: sample_active }

@fixture{target: ArenaState}
arenaQueuedTest = { view: sample_queued }

@fixture{target: ArenaState}
arenaEliminatedTest = { view: sample_eliminated }

@fixture{target: Hud}
hudQueuedTest = { view: sample_queued }

@fixture{target: EliminatedBanner}
eliminatedBannerTest = {}

@fixture{target: ResultCard}
resultCardTest = { winner: "Seat 0", reason: "Last player standing" }

@fixture{target: PlayPage}
playActiveTest = { view: sample_active }

@fixture{target: PlayPage}
playQueuedTest = { view: sample_queued }

@fixture{target: PlayPage}
playEliminatedTest = { view: sample_eliminated }

@fixture{target: PlayPage}
playResultTest = { view: sample_result }

@fixture{target: GamePatch}
gamePatchTest = { view: sample_active }

@fixture{target: KeepAlive}
keepAliveTest = { ts: 10000.I64 }

@fixture{target: CapacityReached}
capacityReachedTest = {}
