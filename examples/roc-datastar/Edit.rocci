import Html
import Signals

@component
panel = |{ mode, contact }| {
    <div id="contact" class="panel">
        @match mode {
            Viewing => <ContactCard contact={contact} />
            Editing => <ContactForm contact={contact} />
        }
    </div>
}

@component
contactCard = |{ contact }| {
    <>
        <p>First Name: {contact.first}</p>
        <p>Last Name: {contact.last}</p>
        <p>Email: {contact.email}</p>
        <div class="actions">
            <button
                data-indicator:_fetching=""
                data-attr:disabled="$_fetching"
                data-on:click="@get('/edit/contact/edit')"
            >Edit</button>
            <button
                class="secondary"
                data-indicator:_fetching=""
                data-attr:disabled="$_fetching"
                data-on:click="@patch('/edit/contact/reset')"
            >Reset</button>
        </div>
    </>
}

@component
contactForm = |{ contact }| {
    <>
        <label>
            First Name
            <input
                type="text"
                data-bind:firstName=""
                data-signals:firstName={Signals.js_str(contact.first)}
                data-attr:disabled="$_fetching"
            />
        </label>
        <label>
            Last Name
            <input
                type="text"
                data-bind:lastName=""
                data-signals:lastName={Signals.js_str(contact.last)}
                data-attr:disabled="$_fetching"
            />
        </label>
        <label>
            Email
            <input
                type="email"
                data-bind:email=""
                data-signals:email={Signals.js_str(contact.email)}
                data-attr:disabled="$_fetching"
            />
        </label>
        <div class="actions">
            <button
                data-indicator:_fetching=""
                data-attr:disabled="$_fetching"
                data-on:click="@put('/edit/contact')"
            >Save</button>
            <button
                class="secondary"
                data-indicator:_fetching=""
                data-attr:disabled="$_fetching"
                data-on:click="@get('/edit/contact/cancel')"
            >Cancel</button>
        </div>
    </>
}

sample_contact = {
    first: "John",
    last: "Doe",
    email: "john@roc-lang.org",
}

@fixture{target: panel}
panelTest = { mode: Viewing, contact: sample_contact }

@fixture{target: contactCard}
contactCardTest = { contact: sample_contact }

@fixture{target: contactForm}
contactFormTest = { contact: sample_contact }
