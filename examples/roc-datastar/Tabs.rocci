import Html

@component
demo = |{ tabs, panel }| {
    <div id="tabs" class="panel">
        <div role="tablist" class="tablist">
            @for tab in tabs {
                <button
                    role="tab"
                    class={if tab.selected { "tab selected" } else { "tab" }}
                    aria-selected={if tab.selected { "true" } else { "false" }}
                    data-on:click={"@get('/tabs/${tab.id}')"}
                >
                    {tab.label}
                </button>
            }
        </div>
        <div role="tabpanel" class="tabpanel">
            <p>{panel}</p>
        </div>
    </div>
}

@fixture{target: demo}
demoTest = {
    tabs: [
        { id: "0", label: "Tab 0", selected: True },
        { id: "1", label: "Tab 1", selected: False },
        { id: "2", label: "Tab 2", selected: False },
    ],
    panel: "Rocci lowers @for to List.map. The selected tab is just another field on that list.",
}
