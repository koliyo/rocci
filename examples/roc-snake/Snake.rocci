import Html

@component
lobbyPage = |{ player_count, full }| {
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Rocci Snake</title>
            <link rel="stylesheet" href="/assets/app.css" />
        </head>
        <body>
            <main class="lobby">
                <nav>
                    <strong>ROC</strong>
                    <span>Roc · basic-webserver · Datastar</span>
                </nav>
                <header>
                    <p class="eyebrow">Shared multiplayer on a 100×100 grid</p>
                    <h1>Snake.</h1>
                    <p class="lede">A Datastar multiplayer stress demo: one authoritative world, long-lived SSE patches, and a tiny JS input island. Walls kill, fruit grows you, and snakes lengthen every couple of seconds. Join or spectate. WASD, arrows, or the on-screen pad to steer.</p>
                </header>
                <p class="count">{player_count.to_str()} in the game, 8 max.</p>
                <div class="actions">
                    <a class="button secondary" href="/play">Spectate</a>
                    @if full {
                        <p class="count">Game full — spectate instead.</p>
                    } @else {
                        <form method="post" action="/api/join">
                            <button type="submit">Join game</button>
                        </form>
                    }
                </div>
            </main>
        </body>
    </html>
}

@component board = |{ cells }| {
    <div id="board" class="board">
        @for cell in cells {
            <i class={cell.class}></i>
        }
    </div>
}

@component miniMap = |{ marks }| {
    <div id="minimap" class="minimap">
        @for mark in marks {
            <i class={mark.class} style={mark.style}></i>
        }
    </div>
}

@component statusHud = |{ info }| {
    <aside id="hud" class="hud">
        <p class="eyebrow">{info.role}</p>
        <p class="cam">{info.cam.x.to_str()}, {info.cam.y.to_str()}</p>
        @if info.respawning {
            <p class="overlay">Respawning in {info.respawn_secs.to_str()}s</p>
        }
        <ul>
            @for player in info.players {
                <li class={player.row_class}>
                    <span class={player.swatch_class}></span>
                    <span>{player.label}</span>
                    <span class="score">{player.score.to_str()}</span>
                </li>
            }
        </ul>
        @if info.can_leave {
            <form method="post" action="/api/leave">
                <button class="secondary" type="submit">Leave</button>
            </form>
        } @else {
            <a class="button secondary" href="/">Back</a>
        }
    </aside>
}

@component playPage = |{ cells, info, marks }| {
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Rocci Snake</title>
            <link rel="stylesheet" href="/assets/app.css" />
            <script type="module" src="/assets/datastar.js"></script>
            <script type="module" src="/assets/snake-input.js"></script>
        </head>
        <body data-init="@get('/sse')">
            <main class="play">
                <nav>
                    <strong>ROC</strong>
                    <span>100×100 · 8 ticks/s</span>
                </nav>
                <div class="stage">
                    <Board cells={cells} />
                    @if info.can_leave {
                        <SteerPad />
                    }
                </div>
                <div class="side">
                    <MiniMap marks={marks} />
                    <StatusHud info={info} />
                </div>
            </main>
        </body>
    </html>
}

@component steerPad = |{}| {
    <div class="steer" aria-label="Steer">
        <button type="button" class="secondary" data-steer="up">Up</button>
        <button type="button" class="secondary" data-steer="left">Left</button>
        <button type="button" class="secondary" data-steer="right">Right</button>
        <button type="button" class="secondary" data-steer="down">Down</button>
    </div>
}

@component gamePatch = |{ cells, info, marks }| {
    <>
        <Board cells={cells} />
        <MiniMap marks={marks} />
        <StatusHud info={info} />
    </>
}

sample_cells = [
    { class: "cell" },
    { class: "cell food" },
    { class: "cell head c1" },
    { class: "cell body c1" },
]

sample_marks = [
    { class: "mark head c1", style: "left:10%;top:10%" },
    { class: "mark food", style: "left:40%;top:25%" },
    { class: "view", style: "left:0%;top:0%;width:20%;height:20%" },
]

sample_hud = {
    role: "You are Jade",
    cam: { x: 40, y: 40 },
    respawning: False,
    respawn_secs: 0,
    can_leave: True,
    players: [
        { row_class: "you", swatch_class: "swatch c1", label: "Jade (you)", score: 3 },
        { row_class: "", swatch_class: "swatch c2", label: "Blue", score: 1 },
    ],
}

@fixture{target: lobbyPage}
lobbyPageTest = { player_count: 3, full: False }

@fixture{target: board}
boardTest = { cells: sample_cells }

@fixture{target: miniMap}
miniMapTest = { marks: sample_marks }

@fixture{target: statusHud}
statusHudTest = { info: sample_hud }

@fixture{target: playPage}
playPageTest = { cells: sample_cells, info: sample_hud, marks: sample_marks }

@fixture{target: steerPad}
steerPadTest = {}

@fixture{target: gamePatch}
gamePatchTest = { cells: sample_cells, info: sample_hud, marks: sample_marks }
