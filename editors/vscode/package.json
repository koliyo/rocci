{
  "name": "rocci",
  "displayName": "Rocci",
  "description": "Rocci template language support for VS Code",
  "license": "MIT",
  "publisher": "koliyo",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.81.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/main.js",
  "scripts": {
    "vscode:package": "vsce package --no-yarn",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.5.1",
    "@types/vscode": "^1.81.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/vsce": "^2.21.1",
    "esbuild": "^0.19.5",
    "eslint": "^8.41.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "contributes": {
    "configurationDefaults": {
      "[rocci]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "languages": [
      {
        "id": "rocci",
        "aliases": [
          "Rocci"
        ],
        "extensions": [
          ".rocci"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "rocci.restartLspServer",
        "title": "Rocci: Restart LSP server"
      }
    ],
    "configuration": {
      "title": "Rocci",
      "properties": {
        "rocci.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to rocci-language-server. Empty uses debug build, bundled dist/bin, or PATH."
        },
        "rocci.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Rocci language server."
        }
      }
    }
  }
}
