{
  "name": "rocci",
  "displayName": "Rocci",
  "description": "Rocci template language support for VS Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/koliyo/rocci"
  },
  "license": "MIT",
  "publisher": "koliyo",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.81.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/main.js",
  "scripts": {
    "vscode:package": "vsce package --no-yarn",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test:unit": "mocha --ui tdd --timeout 5000 \"out/test/unit/**/*.js\"",
    "test": "npm run compile && npm run esbuild && npm run test:unit && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.134.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "contributes": {
    "configurationDefaults": {
      "[rocci]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[rocdown]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "languages": [
      {
        "id": "rocci",
        "aliases": [
          "Rocci"
        ],
        "extensions": [
          ".rocci"
        ],
        "icon": {
          "light": "./icons/rocci-file-light.svg",
          "dark": "./icons/rocci-file.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rocdown",
        "aliases": [
          "Rocdown"
        ],
        "extensions": [
          ".rocdown"
        ],
        "icon": {
          "light": "./icons/rocci-file-light.svg",
          "dark": "./icons/rocci-file.svg"
        },
        "configuration": "./rocdown-language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "rocci.restartLspServer",
        "title": "Rocci: Restart LSP server"
      },
      {
        "command": "rocci.preview",
        "title": "Rocci: Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "rocci.stopPreview",
        "title": "Rocci: Stop Preview",
        "icon": "$(stop)",
        "enablement": "rocci.preview.active"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rocci.preview",
          "when": "editorLangId == rocci || editorLangId == rocdown",
          "group": "navigation"
        }
      ],
      "editor/title/run": [
        {
          "command": "rocci.preview",
          "when": "editorLangId == rocci || editorLangId == rocdown"
        }
      ]
    },
    "configuration": {
      "title": "Rocci",
      "properties": {
        "rocci.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to rocci-language-server. Empty uses debug build, bundled dist/bin, or PATH."
        },
        "rocci.preview.rocciPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the rocci binary. Empty uses bundled dist/bin, PATH, or workspace target/debug."
        },
        "rocci.preview.rocdownPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the rocdown binary. Empty uses bundled dist/bin, PATH, or workspace target/debug."
        },
        "rocci.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Rocci language server."
        }
      }
    }
  }
}
