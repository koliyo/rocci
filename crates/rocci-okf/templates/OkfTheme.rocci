import Html
import PageOutline
import ConceptMeta

@component KnowledgeShell = |{ outline, has_outline, meta, has_meta }, nav, body| {
    <div class="rd-shell">
        <div class="okf-chrome" id="okf-nav">{nav}</div>
        <main id="okf-main">
            @if has_outline {
                <details class="okf-outline-menu">
                    <summary>On this page</summary>
                    <div class="okf-outline-panel">
                        <PageOutline.pageOutline outline={outline} />
                    </div>
                </details>
            }
            @if has_meta {
                <ConceptMeta.conceptMeta meta={meta} />
            }
            <article class="rd-article">{body}</article>
        </main>
        @if has_outline {
            <aside class="rd-toc" id="okf-toc" aria-label="On this page">
                <PageOutline.pageOutline outline={outline} />
            </aside>
        }
    </div>
}
