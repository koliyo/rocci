import Html

@css {
    :scope {
        --canvas: #faf9f6;
        --surface: #ffffff;
        --surface-raised: #fffdf9;
        --ink: #201e1c;
        --muted: #6d6862;
        --faint: #918a82;
        --line: #e7e2dc;
        --line-strong: #d7d0c7;
        --accent: #e64b2f;
        --accent-strong: #b92f19;
        --accent-soft: #fff0e9;
        --code: #282522;
        --code-ink: #f8f3ed;
        --header-height: 4.25rem;
        color-scheme: light dark;
        background: var(--canvas);
        color: var(--ink);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 16px;
        line-height: 1.65;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
    }

    * { box-sizing: border-box; }
    body { margin: 0; min-width: 20rem; background: var(--canvas); }
    a { color: inherit; }
    img { max-width: 100%; height: auto; }

    .skip-link {
        position: fixed;
        z-index: 100;
        top: .75rem;
        left: .75rem;
        padding: .65rem .9rem;
        border-radius: .5rem;
        background: var(--ink);
        color: var(--surface);
        transform: translateY(-160%);
    }
    .skip-link:focus { transform: translateY(0); }

    .site-header {
        position: sticky;
        z-index: 20;
        top: 0;
        height: var(--header-height);
        border-bottom: 1px solid color-mix(in srgb, var(--line) 88%, transparent);
        background: color-mix(in srgb, var(--canvas) 92%, transparent);
        backdrop-filter: blur(14px);
    }
    .header-inner {
        width: min(100%, 94rem);
        height: 100%;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: .7rem;
        color: var(--ink);
        font-size: 1.05rem;
        font-weight: 760;
        letter-spacing: -.025em;
        text-decoration: none;
    }
    .brand-mark {
        width: 1.7rem;
        height: 1.7rem;
        display: grid;
        place-items: center;
        border-radius: .48rem .48rem .48rem .12rem;
        background: var(--accent);
        color: #fff;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: .88rem;
        font-weight: 800;
        transform: rotate(-2deg);
    }
    .header-rule { width: 1px; height: 1.4rem; background: var(--line-strong); }
    .header-subtitle { color: var(--muted); font-size: .88rem; }
    .header-actions { margin-left: auto; display: flex; align-items: center; gap: .55rem; }
    .header-link {
        display: inline-flex;
        min-height: 2.25rem;
        align-items: center;
        padding: .35rem .72rem;
        border: 1px solid var(--line);
        border-radius: .55rem;
        background: var(--surface);
        color: var(--muted);
        font-size: .82rem;
        font-weight: 650;
        text-decoration: none;
    }
    .header-link:hover { border-color: var(--line-strong); color: var(--ink); }

    .site-grid {
        width: min(100%, 94rem);
        min-height: calc(100vh - var(--header-height));
        margin: 0 auto;
        display: grid;
        grid-template-columns: 17rem minmax(0, 1fr) 13.5rem;
    }
    .sidebar {
        position: sticky;
        top: var(--header-height);
        height: calc(100vh - var(--header-height));
        padding: 2rem 1.35rem 3rem 1.5rem;
        overflow-y: auto;
        border-right: 1px solid var(--line);
    }
    .nav-section + .nav-section { margin-top: 1.65rem; }
    .nav-label {
        margin: 0 0 .42rem .68rem;
        color: var(--faint);
        font-size: .68rem;
        font-weight: 760;
        letter-spacing: .105em;
        text-transform: uppercase;
    }
    .nav-items { display: grid; gap: .08rem; }
    .nav-link {
        display: block;
        padding: .42rem .68rem;
        border-radius: .45rem;
        color: var(--muted);
        font-size: .88rem;
        line-height: 1.35;
        text-decoration: none;
    }
    .nav-link:hover { background: var(--surface); color: var(--ink); }
    .nav-link.is-current {
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 680;
    }

    .content-column { min-width: 0; padding: 3.4rem clamp(1.5rem, 5vw, 5rem) 5rem; }
    .article { width: min(100%, 46rem); margin: 0 auto; }
    .article > :first-child { margin-top: 0; }
    .article .rd-header-1 {
        margin: 0 0 1.15rem;
        color: var(--ink);
        font-size: clamp(2.35rem, 5vw, 4.35rem);
        font-weight: 790;
        line-height: .98;
        letter-spacing: -.055em;
    }
    .article .rd-header-1 + .rd-paragraph {
        margin-top: 0;
        color: var(--muted);
        font-size: 1.15rem;
        line-height: 1.6;
    }
    .article .rd-header-2 {
        margin: 3.4rem 0 1rem;
        padding-top: .45rem;
        color: var(--ink);
        font-size: 1.58rem;
        font-weight: 745;
        line-height: 1.2;
        letter-spacing: -.025em;
    }
    .article .rd-header-3 {
        margin: 2.25rem 0 .7rem;
        color: var(--ink);
        font-size: 1.12rem;
        font-weight: 720;
        line-height: 1.3;
    }
    .article .rd-paragraph { margin: 1rem 0; }
    .article .rd-strong { color: var(--ink); font-weight: 720; }
    .article .rd-link {
        color: var(--accent-strong);
        font-weight: 560;
        text-decoration-color: color-mix(in srgb, var(--accent) 42%, transparent);
        text-decoration-thickness: .08em;
        text-underline-offset: .18em;
    }
    .article .rd-link:hover { color: var(--accent); text-decoration-color: currentColor; }
    .article .rd-list, .article .rd-list-ordered { margin: 1rem 0; padding-left: 1.35rem; }
    .article .rd-list-item, .article .rd-task-item { margin: .38rem 0; padding-left: .18rem; }
    .article .rd-blockquote {
        margin: 1.4rem 0;
        padding: 1rem 1.15rem;
        border: 1px solid #f3c9b9;
        border-left: .25rem solid var(--accent);
        border-radius: .2rem .65rem .65rem .2rem;
        background: var(--accent-soft);
        color: color-mix(in srgb, var(--ink) 86%, var(--accent));
    }
    .article .rd-blockquote .rd-paragraph { margin: 0; }
    .article .rd-code {
        padding: .12em .34em;
        border: 1px solid var(--line);
        border-radius: .35rem;
        background: var(--surface-raised);
        color: #a52d1a;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .87em;
    }
    .article .rd-code-block {
        margin: 1.35rem 0;
        padding: 1.1rem 1.2rem;
        overflow-x: auto;
        border: 1px solid #3b3733;
        border-radius: .72rem;
        background: var(--code);
        box-shadow: 0 .7rem 2rem rgba(50, 35, 25, .08);
    }
    .article .rd-code-block .rd-code {
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--code-ink);
        font-size: .86rem;
        line-height: 1.65;
    }
    .article .rd-table {
        width: 100%;
        margin: 1.4rem 0;
        border-spacing: 0;
        border: 1px solid var(--line);
        border-radius: .68rem;
        overflow: hidden;
        background: var(--surface);
        font-size: .9rem;
    }
    .article .rd-table-header {
        padding: .7rem .82rem;
        border-bottom: 1px solid var(--line-strong);
        background: var(--surface-raised);
        color: var(--ink);
        font-weight: 700;
        text-align: left;
    }
    .article .rd-table-cell { padding: .72rem .82rem; border-bottom: 1px solid var(--line); vertical-align: top; }
    .article .rd-table-row:last-child .rd-table-cell { border-bottom: 0; }
    .article .rd-thematic-break { margin: 3rem 0; border: 0; border-top: 1px solid var(--line); }

    .outline {
        position: sticky;
        top: var(--header-height);
        height: calc(100vh - var(--header-height));
        padding: 2.15rem 1.5rem 2rem 1.2rem;
        overflow-y: auto;
    }
    .outline-label {
        margin: 0 0 .65rem;
        color: var(--faint);
        font-size: .68rem;
        font-weight: 760;
        letter-spacing: .105em;
        text-transform: uppercase;
    }
    .outline-items { display: grid; gap: .45rem; border-left: 1px solid var(--line); }
    .outline-link {
        margin-left: -1px;
        padding-left: .8rem;
        border-left: 1px solid transparent;
        color: var(--muted);
        font-size: .78rem;
        line-height: 1.35;
        text-decoration: none;
    }
    .outline-link:hover { border-color: var(--accent); color: var(--ink); }
    .outline-link.level-3 { padding-left: 1.35rem; color: var(--faint); }

    .article-footer {
        width: min(100%, 46rem);
        margin: 4rem auto 0;
        padding-top: 1.2rem;
        border-top: 1px solid var(--line);
        color: var(--faint);
        font-size: .8rem;
    }
    .article-footer a { color: var(--muted); }
    .mobile-menu { display: none; }

    :focus-visible { outline: .18rem solid color-mix(in srgb, var(--accent) 70%, white); outline-offset: .18rem; }

    @media (max-width: 70rem) {
        .site-grid { grid-template-columns: 16.5rem minmax(0, 1fr); }
        .outline { display: none; }
    }
    @media (max-width: 48rem) {
        .header-inner { padding: 0 1rem; }
        .header-rule, .header-subtitle, .header-link { display: none; }
        .site-grid { display: block; }
        .sidebar { display: none; }
        .content-column { padding: 2.3rem 1.25rem 4rem; }
        .article .rd-header-1 { font-size: clamp(2.25rem, 13vw, 3.35rem); }
        .mobile-menu { position: relative; display: block; margin-left: auto; }
        .mobile-menu summary {
            padding: .38rem .7rem;
            border: 1px solid var(--line);
            border-radius: .5rem;
            background: var(--surface);
            color: var(--muted);
            font-size: .82rem;
            font-weight: 680;
            cursor: pointer;
            list-style: none;
        }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-menu[open] .mobile-panel { display: block; }
        .mobile-panel {
            position: fixed;
            top: var(--header-height);
            right: 0;
            left: 0;
            max-height: calc(100vh - var(--header-height));
            padding: 1.3rem 1rem 2rem;
            overflow-y: auto;
            border-bottom: 1px solid var(--line);
            background: var(--canvas);
            box-shadow: 0 1rem 2.5rem rgba(35, 25, 20, .12);
        }
    }

    @media (prefers-color-scheme: dark) {
        :scope {
            --canvas: #191817;
            --surface: #22201e;
            --surface-raised: #282522;
            --ink: #f3eee8;
            --muted: #b8b0a8;
            --faint: #8c847c;
            --line: #383431;
            --line-strong: #4a4540;
            --accent: #ff765a;
            --accent-strong: #ff987f;
            --accent-soft: #35231f;
            --code: #11100f;
            --code-ink: #f6ede5;
        }
        .article .rd-blockquote { border-color: #5b352c; }
        .article .rd-code { color: #ff9a84; }
    }

    @media print {
        .site-header, .sidebar, .outline, .article-footer { display: none; }
        .site-grid { display: block; }
        .content-column { padding: 0; }
        .article { max-width: none; }
        .article .rd-link { color: inherit; }
    }
}

@component SiteShell = |{ site, nav, route, title, description, outline }, content| {
    <html lang={site.language}>
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <meta name="color-scheme" content="light dark" />
            <title>{title} · {site.title}</title>
            @if description != "" {
                <meta name="description" content={description} />
            } @else if site.description != "" {
                <meta name="description" content={site.description} />
            }
            @if site.base_url != "" {
                <link rel="canonical" href={"${site.base_url}${route}"} />
                <meta property="og:url" content={"${site.base_url}${route}"} />
            }
            <meta property="og:type" content="website" />
            <meta property="og:title" content={title} />
            <meta property="og:site_name" content={site.title} />
            @if description != "" {
                <meta property="og:description" content={description} />
            }
            @if site.social_image != "" {
                <meta property="og:image" content={"${site.base_url}${site.social_image}"} />
                <meta name="twitter:card" content="summary_large_image" />
            }
        </head>
        <body>
            <a class="skip-link" href="#main-content">Skip to content</a>
            <header class="site-header">
                <div class="header-inner">
                    <a class="brand" href="/" aria-label={"${site.title} home"}>
                        <span class="brand-mark" aria-hidden="true">r</span>
                        <span>{site.title}</span>
                    </a>
                    <span class="header-rule" aria-hidden="true"></span>
                    <span class="header-subtitle">Roc-native interface tools</span>
                    <div class="header-actions">
                        @if site.repository != "" {
                            <a class="header-link" href={site.repository}>Source ↗</a>
                        }
                    </div>
                    <details class="mobile-menu">
                        <summary>Menu</summary>
                        <div class="mobile-panel">
                            <nav aria-label="Documentation">
                                @for section in nav {
                                    <section class="nav-section">
                                        <p class="nav-label">{section.label}</p>
                                        <div class="nav-items">
                                            @for item in section.items {
                                                <a
                                                    class={if item.href == route { "nav-link is-current" } else { "nav-link" }}
                                                    href={item.href}
                                                    aria-current={if item.href == route { "page" } else { "false" }}
                                                >{item.title}</a>
                                            }
                                        </div>
                                    </section>
                                }
                            </nav>
                        </div>
                    </details>
                </div>
            </header>
            <div class="site-grid">
                <aside class="sidebar">
                    <nav aria-label="Documentation">
                        @for section in nav {
                            <section class="nav-section">
                                <p class="nav-label">{section.label}</p>
                                <div class="nav-items">
                                    @for item in section.items {
                                        <a
                                            class={if item.href == route { "nav-link is-current" } else { "nav-link" }}
                                            href={item.href}
                                            aria-current={if item.href == route { "page" } else { "false" }}
                                        >{item.title}</a>
                                    }
                                </div>
                            </section>
                        }
                    </nav>
                </aside>
                <main class="content-column" id="main-content">
                    <article class="article">{content}</article>
                    <footer class="article-footer">
                        Rocci is experimental software. Verify APIs against the current source before production use.
                    </footer>
                </main>
                <aside class="outline" aria-label="On this page">
                    @if !List.isEmpty(outline) {
                        <>
                            <p class="outline-label">On this page</p>
                            <div class="outline-items">
                                @for heading in outline {
                                    <a
                                        class={if heading.level == "3" { "outline-link level-3" } else { "outline-link" }}
                                        href={"#${heading.id}"}
                                    >{heading.title}</a>
                                }
                            </div>
                        </>
                    }
                </aside>
            </div>
        </body>
    </html>
}
