import Html

@component
SiteShell = |{ title }, content| {
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <title>{title}</title>
        </head>
        <body>
            <a class="skip-link" href="#main-content">Skip to content</a>
            <main id="main-content">{content}</main>
        </body>
    </html>
}
