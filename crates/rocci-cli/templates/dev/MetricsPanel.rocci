import Html

MetricsSpan : {
    name : Str,
    duration_ms : U64,
    note : [Some Str, None],
}

@component InspectorTabs = |{ tab }| {
    <nav class="inspector-tabs" role="tablist">
        @if tab == "performance" {
            <a role="tab" aria-selected="true" href="/__rocci/dev?tab=performance">Performance</a>
        } @else {
            <a role="tab" aria-selected="false" href="/__rocci/dev?tab=performance">Performance</a>
        }
        @if tab == "source" {
            <a role="tab" aria-selected="true" href="/__rocci/dev?tab=source">Source</a>
        } @else {
            <a role="tab" aria-selected="false" href="/__rocci/dev?tab=source">Source</a>
        }
        @if tab == "console" {
            <a role="tab" aria-selected="true" href="/__rocci/dev?tab=console">Console</a>
        } @else {
            <a role="tab" aria-selected="false" href="/__rocci/dev?tab=console">Console</a>
        }
    </nav>
}

@component PerformanceBody = |{ total_ms, spans }| {
    <div class="inspector-body tab-performance">
        <h1>Profiling</h1>
        <p class="total">
            <span class="value">{total_ms.to_str()}</span>
            <span class="unit">ms total</span>
        </p>
        @if List.is_empty(spans) {
            <p class="empty">No timing spans recorded.</p>
        } @else {
            <table>
                <thead>
                    <tr>
                        <th>Stage</th>
                        <th>ms</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for span in spans {
                        <tr>
                            <td>{span.name}</td>
                            <td class="ms">{span.duration_ms.to_str()}</td>
                            <td>
                                @match span.note {
                                    Some(note) => <span class="note">{note}</span>
                                    None => <span></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@component SourceBody = |{ route, path, view, body, available, reason }| {
    <div class="inspector-body tab-source">
        <div class="source-chrome">
            <form class="source-form" method="get" action="/__rocci/dev">
                <input type="hidden" name="route" value={route} />
                <input type="hidden" name="tab" value="source" />
                <label class="view-label">
                    View
                    <select name="view" onchange="this.form.submit()">
                        @if view == "source" {
                            <option value="source" selected="">Original source</option>
                        } @else {
                            <option value="source">Original source</option>
                        }
                        @if view == "ast" {
                            <option value="ast" selected="">AST</option>
                        } @else {
                            <option value="ast">AST</option>
                        }
                        @if view == "roc" {
                            <option value="roc" selected="">Generated Roc</option>
                        } @else {
                            <option value="roc">Generated Roc</option>
                        }
                        @if view == "html" {
                            <option value="html" selected="">Generated HTML</option>
                        } @else {
                            <option value="html">Generated HTML</option>
                        }
                    </select>
                </label>
                <noscript>
                    <button type="submit">Show</button>
                </noscript>
            </form>
            <p class="file-path">{path}</p>
            @if !available {
                <p class="unavailable">{reason}</p>
            }
        </div>
        <div class="code-pane">
            @if available {
                <pre><code>{body}</code></pre>
            }
        </div>
    </div>
}

@component ConsoleBody = |{}| {
    <div class="inspector-body tab-console">
        <p class="console-placeholder">Runtime log stream is not attached yet.</p>
    </div>
}

@component MetricsPanel = |{ total_ms, spans, route, tab, path, view, body, available, reason }| {
    <section class="inspector-panel">
        <InspectorTabs tab={tab} />
        @match tab {
            "source" =>
                <SourceBody
                    route={route}
                    path={path}
                    view={view}
                    body={body}
                    available={available}
                    reason={reason}
                />
            "console" => <ConsoleBody />
            _ => <PerformanceBody total_ms={total_ms} spans={spans} />
        }
    </section>
}

@component MetricsPage = |{ total_ms, spans, route, tab, path, view, body, available, reason }|
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <meta name="color-scheme" content="light dark" />
            <title>Inspector</title>
        </head>
        <body>
            <MetricsPanel
                total_ms={total_ms}
                spans={spans}
                route={route}
                tab={tab}
                path={path}
                view={view}
                body={body}
                available={available}
                reason={reason}
            />
        </body>
    </html>

@fixture{target: MetricsPanel}
samplePanel = {
    total_ms: 42,
    spans: [
        { name: "read", duration_ms: 1, note: None },
        { name: "parse", duration_ms: 4, note: None },
