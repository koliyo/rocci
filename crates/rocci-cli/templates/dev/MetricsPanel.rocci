@css {
    * { box-sizing: border-box; }
    html, body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: light-dark(#f7f7f8, #21252b);
        color: light-dark(#18181b, #d7dae0);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    .inspector-panel {
        box-sizing: border-box;
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        font-size: 13px;
        line-height: 1.4;
    }
    .inspector-tabs {
        flex: 0 0 auto;
        display: flex;
        gap: 0;
        border-bottom: 1px solid light-dark(#e4e4e7, #3e4451);
        padding: 0 8px;
    }
    .inspector-tabs a {
        padding: 10px 12px;
        text-decoration: none;
        color: light-dark(#71717a, #9da5b4);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
        border-bottom: 2px solid transparent;
    }
    .inspector-tabs a[aria-selected="true"] {
        color: inherit;
        border-bottom-color: light-dark(#3b82f6, #61afef);
    }
    .inspector-body {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 16px 14px 20px;
    }
    .inspector-body.tab-performance,
    .inspector-body.tab-console {
        overflow: auto;
    }
    .source-chrome {
        flex: 0 0 auto;
    }
    .code-pane {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }
    .inspector-body h1 {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 650;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: light-dark(#71717a, #9da5b4);
    }
    .total {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin: 0 0 14px;
    }
    .total .value {
        font-size: 28px;
        font-weight: 650;
        font-variant-numeric: tabular-nums;
        font-family: ui-monospace, Menlo, monospace;
    }
    .total .unit,
    .empty,
    .console-placeholder {
        color: light-dark(#71717a, #9da5b4);
    }
    .console-placeholder {
        margin: 0;
    }
    table {
        width: 100%;
        border-collapse: collapse;
    }
    th, td {
        padding: 6px 0;
        text-align: left;
        border-bottom: 1px solid light-dark(#e4e4e7, #3e4451);
        vertical-align: top;
    }
    th {
        font-size: 11px;
        font-weight: 600;
        color: light-dark(#71717a, #9da5b4);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    td.ms {
        font-variant-numeric: tabular-nums;
        font-family: ui-monospace, Menlo, monospace;
        width: 4.5em;
    }
    .note {
        font-size: 11px;
        color: light-dark(#3b82f6, #61afef);
    }
    .source-form {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin: 0 0 8px;
    }
    .view-label {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: light-dark(#71717a, #9da5b4);
    }
    .view-label select {
        font: inherit;
        text-transform: none;
        letter-spacing: 0;
        font-weight: 500;
        color: inherit;
        background: light-dark(#fff, #2c313c);
        border: 1px solid light-dark(#d4d4d8, #3e4451);
        border-radius: 4px;
        padding: 4px 8px;
    }
    .file-path {
        margin: 0 0 8px;
        font-family: ui-monospace, Menlo, monospace;
        font-size: 11px;
        color: light-dark(#71717a, #9da5b4);
        word-break: break-all;
    }
    .unavailable {
        margin: 0 0 8px;
        color: light-dark(#b45309, #e5c07b);
    }
    pre {
        margin: 0;
        padding: 10px 12px;
        overflow: visible;
        background: light-dark(#ececee, #15181e);
        border-radius: 6px;
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 12px;
        line-height: 1.45;
        white-space: pre;
    }
    pre code {
        font: inherit;
    }
}
