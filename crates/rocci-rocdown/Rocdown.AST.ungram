// Rocdown document AST.
//
// Tree spec for crates/rocci-rocdown/src/ast.rs. Generate node types from this
// file. Do not generate the scanner. Comrak still owns Markdown sugar
// recognition. Rocdown still owns document-root scanning. Spans are attached
// by codegen.
//
// Lowering rules (owned structs, not a CST):
//   - Top-level `|` of node names → enum of tuple variants matching today
//     (`Item::Block(BlockCall)`). Variant names that differ from the payload
//     type are in Rocdown.AST.toml `[item_variants]`.
//   - Sequence of labeled fields → struct. Unlabeled tokens are omitted.
//   - `T*` → `Vec<T>`. `T?` → `Option<T>`. Recursive struct fields → `Box`.
//   - Every generated struct gets `pub span: Span` except `ParamField`, which
//     is shipped without an overall span (`name` + `name_span` + `value`).
//   - Leaf `Name = 'token'` uses the sidecar rust type. Do not guess Span vs
//     String+Span. Rocdown `Ident` is not `rocci_template::Ident`.
//   - Derives: `Clone, Debug, PartialEq, Eq`.
//   - `PageMeta` / `HeadingInfo` / `LinkInfo` stay out of this tree.
//
// Classification lives in Rocdown.AST.toml:
//   generated  — article / module nodes the parser constructs
//   foreign    — `rocci_template::*` (do not re-emit ComponentDecl)
//   opaque     — hand-written `MdNode`
//   doc-only   — Markdown article layer and source-shape aliases
//
// Nested `:name` bodies are holes: `LineContent` / `BraceSection` /
// `EndSection` store spans; `parse_fragment` rebuilds inner `Item`s.

/// A `.rocdown` file.
Document =
  items:Item*

/// Shipped document node. Flat enum; not `ModuleItem | Block`.
Item =
  MdNode
| PageDecl
| RocDecl
| RenderDecl
| ComponentDecl
| FixtureDecl
| CssDecl
| ContextDecl
| InitDecl
| OnDecl
| UseDecl
| TemplateItem
| BlockCall

/// doc-only grouping. Not a Rust type. Payloads are Item variants.
ModuleItem =
  PageDecl
| RocDecl
| RenderDecl
| ComponentDecl
| FixtureDecl
| CssDecl
| ContextDecl
| InitDecl
| OnDecl
| UseDecl

PageDecl = '@' 'page' body:BracePayload
RocDecl = '@' 'roc' body:BracePayload
RenderDecl = '@' 'render' expr:BracePayload
UseDecl = '@' 'use' path:StringLit

/// foreign → rocci_template::ComponentDecl
ComponentDecl = 'rocci-component'
/// foreign → rocci_template::FixtureDecl
FixtureDecl = 'rocci-fixture'
/// foreign → rocci_template::CssDecl
CssDecl = 'rocci-css'
/// foreign → rocci_template::ContextDecl
ContextDecl = 'rocci-context'
/// foreign → rocci_template::InitDecl
InitDecl = 'rocci-init'
/// foreign → rocci_template::OnDecl
OnDecl = 'rocci-on'
/// foreign → rocci_template::TemplateItem
TemplateItem = 'rocci-template-item'

/// Opaque `{ ... }` whose insides are Roc or CSS, not nested Rocdown.
BracePayload = '{' '}'

/// opaque → generated `MdNode` from Rocdown.Markdown.ungram (Comrak projection).
MdNode = 'md-node'

/// Uniform article node. Sugar headings/images lower to this too.
BlockCall =
  name:Ident
  params:BracketRecord?
  content:BlockContent?

BracketRecord =
  '['
  fields:ParamField*
  ']'

ParamField =
  name:Ident
  ':'
  value:ParamValue

ParamValue =
  StringLit
| BoolLit
| NumberLit
| Ident
| BracketRecord
| BracketList

BracketList =
  '['
  items:ParamValue*
  ']'

BlockContent =
  LineContent
| BraceSection
| EndSection

/// Rest of the line after `:name` / `:name[params]`. Opaque span.
LineContent = 'line-content'

/// Nested document hole. `{{` / `}}` is the usual fence.
BraceSection =
  '{{'
  '}}'

/// Named closer hole. Follows the article prefix: `:end.tabs`.
EndSection =
  marker:EndMarker

EndMarker =
  ':'
  'end'
  '.'
  name:Ident

Ident = 'ident'
StringLit = 'string'
BoolLit = 'bool'
NumberLit = 'number'

/// doc-only: target article layer from the block-model plan.
/// Runtime Markdown is `Item::Markdown(MdNode)`. Do not invent `Item::Paragraph`.
Block =
  BlockCall
| Paragraph
| List
| BlockQuote
| CodeBlock
| Table
| ThematicBreak
| TemplateSplice
| HtmlIsland

/// Markdown inlines inside line content. Comrak-owned until a later ungram.
Inline = 'md-inline'

Paragraph = inlines:Inline*
List = ordered:BoolLit items:ListItem*
ListItem = blocks:Block*
BlockQuote = blocks:Block*
CodeBlock =
  info:StringLit
  literal:StringLit
Table = rows:TableRow*
TableRow = header:BoolLit cells:TableCell*
TableCell = inlines:Inline*
ThematicBreak = 'thematic-break'

/// Document-root `@if` / `@for` / `@match` / `@let`. Same payload as TemplateItem.
TemplateSplice = 'rocci-splice'

/// Document-root `<Tag>`. Same payload as TemplateItem.
HtmlIsland = 'html-island'
