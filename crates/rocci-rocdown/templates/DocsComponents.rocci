import Html

@css {
    :scope.rd-docs-block,
    .rd-docs-block { margin: 1.25rem 0; }
    :scope.rd-docs-aside,
    .rd-docs-aside {
        padding: 0.9rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.6rem;
        background: var(--surface);
    }
    :scope.rd-docs-note,
    .rd-docs-note {
        border-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 34%, var(--surface));
    }
    :scope.rd-docs-note .rd-docs-label,
    .rd-docs-note .rd-docs-label { color: var(--accent-strong); }
    :scope.rd-docs-tip,
    .rd-docs-tip {
        border-color: #98c379;
        background: color-mix(in srgb, #98c379 34%, var(--surface));
    }
    :scope.rd-docs-tip .rd-docs-label,
    .rd-docs-tip .rd-docs-label { color: #98c379; }
    :scope.rd-docs-caution,
    :scope.rd-docs-warning,
    .rd-docs-caution,
    .rd-docs-warning {
        border-color: #e5c07b;
        background: color-mix(in srgb, #e5c07b 34%, var(--surface));
    }
    :scope.rd-docs-caution .rd-docs-label,
    :scope.rd-docs-warning .rd-docs-label,
    .rd-docs-caution .rd-docs-label,
    .rd-docs-warning .rd-docs-label { color: #e5c07b; }
    :scope.rd-docs-danger,
    .rd-docs-danger {
        border-color: #e06c75;
        background: color-mix(in srgb, #e06c75 34%, var(--surface));
    }
    :scope.rd-docs-danger .rd-docs-label,
    .rd-docs-danger .rd-docs-label { color: #e06c75; }
    :scope.rd-docs-deprecated,
    .rd-docs-deprecated {
        border-color: #c678dd;
        background: color-mix(in srgb, #c678dd 34%, var(--surface));
    }
    :scope.rd-docs-deprecated .rd-docs-label,
    .rd-docs-deprecated .rd-docs-label { color: #c678dd; }
    .rd-docs-label {
        margin: 0 0 0.35rem;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 750;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .rd-docs-title { margin: 0 0 0.4rem; font-weight: 700; }
    .rd-docs-body > :first-child { margin-top: 0; }
    .rd-docs-body > :last-child { margin-bottom: 0; }
    .rd-docs-summary { font-weight: 700; cursor: pointer; }
    :scope.rd-docs-card,
    .rd-docs-card {
        display: block;
        padding: 0.9rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.6rem;
        text-decoration: none;
        background: var(--surface);
    }
    .rd-docs-card-title { display: block; font-weight: 700; }
    .rd-docs-card-summary { display: block; color: var(--muted); margin-top: 0.25rem; }
    .rd-docs-card-grid {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: 1fr;
    }
    .rd-docs-tree { overflow-x: auto; }
    .rd-docs-tab { margin: 1rem 0; }
    .rd-docs-tab-label { margin: 0 0 0.4rem; font-size: 1rem; }
    .rd-docs-badge-label {
        display: inline-block;
        padding: 0.15rem 0.55rem;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
    }
    .rd-docs-steps { padding-left: 0; margin: 1.25rem 0; counter-reset: rd-step; list-style: none; }
    .rd-docs-step {
        display: grid;
        grid-template-columns: 1.6rem minmax(0, 1fr);
        margin: 0.75rem 0;
        counter-increment: rd-step;
    }
    .rd-docs-step::before {
        content: counter(rd-step) ".";
        grid-column: 1;
        grid-row: 1;
        font-weight: 700;
    }
    .rd-docs-step > .rd-docs-verify,
    .rd-docs-step > .rd-docs-title {
        grid-column: 2;
        margin: 0 0 0.15rem;
    }
    .rd-docs-step:not(:has(.rd-docs-verify)) > .rd-docs-title {
        grid-row: 1;
    }
    .rd-docs-step > .rd-docs-body {
        grid-column: 2;
    }
    .rd-docs-verify {
        display: inline-block;
        margin: 0 0 0.35rem;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 750;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .rd-docs-figure { margin: 1.25rem 0; }
    .rd-docs-caption, .rd-docs-credit { color: var(--muted); }
    .rd-docs-compatibility { overflow-x: auto; }
    @media (min-width: 48rem) {
        .rd-docs-card-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (forced-colors: active) {
        .rd-docs-aside, .rd-docs-card, .rd-docs-badge-label {
            border: 1px solid currentColor;
        }
    }
    @media print {
        .rd-docs-tab { break-inside: avoid; }
        .rd-docs-aside { border: 1px solid currentColor; background: transparent; }
    }
}

@component Aside = |{ kind, label, title, aria }, content| {
    @if aria == "" {
        <aside class={"rd-docs-aside rd-docs-block rd-docs-${kind}"} data-rocci-docs={kind}>
            <p class="rd-docs-label">{label}</p>
            @if title != "" {
                <p class="rd-docs-title">{title}</p>
            }
            <div class="rd-docs-body">{content}</div>
        </aside>
    } @else {
        <aside class={"rd-docs-aside rd-docs-block rd-docs-${kind}"} data-rocci-docs={kind} aria-label={aria}>
            <p class="rd-docs-label">{label}</p>
            @if title != "" {
                <p class="rd-docs-title">{title}</p>
            }
            <div class="rd-docs-body">{content}</div>
        </aside>
    }
}

@component Note = |{ title }, content|
    <Aside kind="note" label="Note" title={title} aria="">{content}</Aside>

@component Tip = |{ title }, content|
    <Aside kind="tip" label="Tip" title={title} aria="">{content}</Aside>

@component Caution = |{ title }, content|
    <Aside kind="caution" label="Caution" title={title} aria="">{content}</Aside>

@component Danger = |{ title }, content|
    <Aside kind="danger" label="Danger" title={title} aria="">{content}</Aside>

@component Deprecated = |{ title }, content|
    <Aside kind="deprecated" label="Deprecated" title={title} aria="Deprecated">{content}</Aside>

@component Details = |{ summary, open }, content| {
    @if open {
        <details class="rd-docs-details rd-docs-block" data-rocci-docs="details" open="open">
            <summary class="rd-docs-summary">{summary}</summary>
            <div class="rd-docs-body">{content}</div>
        </details>
    } @else {
        <details class="rd-docs-details rd-docs-block" data-rocci-docs="details">
            <summary class="rd-docs-summary">{summary}</summary>
            <div class="rd-docs-body">{content}</div>
        </details>
    }
}

@component Steps = |{}, content|
    <div class="rd-docs-steps rd-docs-block" data-rocci-docs="steps">{content}</div>

@component Step = |{ title, verify }, content| {
    <div class="rd-docs-step" data-rocci-docs="step">
        @if verify {
            <p class="rd-docs-verify">Verify</p>
        }
        @if title != "" {
            <p class="rd-docs-title">{title}</p>
        }
        <div class="rd-docs-body">{content}</div>
    </div>
}

@component Figure = |{ caption, credit }, content| {
    <figure class="rd-docs-figure rd-docs-block" data-rocci-docs="figure">
        {content}
        @if caption != "" {
            <figcaption class="rd-docs-caption">{caption}</figcaption>
        }
        @if credit != "" {
            <p class="rd-docs-credit">{credit}</p>
        }
    </figure>
}

@component Definition = |{ title }, content|
    <dl class="rd-docs-definition rd-docs-block" data-rocci-docs="definition">
        <dt>{title}</dt>
        <dd>{content}</dd>
    </dl>

@component Tabs = |{ group, kind }, content|
    <div class="rd-docs-tabs rd-docs-block" data-rocci-docs="tabs" data-tabs-group={group} data-tabs-kind={kind}>{content}</div>

@component Tab = |{ id, label }, content|
    <section class="rd-docs-tab" data-rocci-docs="tab" data-tab-id={id} aria-label={label}>
        <h3 class="rd-docs-tab-label">{label}</h3>
        {content}
    </section>

@component LinkCard = |{ href, title, summary }| {
    <a class="rd-docs-card rd-docs-block" data-rocci-docs="link-card" href={href}>
        <span class="rd-docs-card-title">{title}</span>
        @if summary != "" {
            <span class="rd-docs-card-summary">{summary}</span>
        }
    </a>
}

@component CardGrid = |{}, content|
    <div class="rd-docs-card-grid rd-docs-block" data-rocci-docs="card-grid">{content}</div>

@component FileTree = |{}, content|
    <div class="rd-docs-tree rd-docs-block" data-rocci-docs="file-tree" aria-label="File tree">{content}</div>

@component Badge = |{ label }|
    <p class="rd-docs-badge rd-docs-block" data-rocci-docs="badge">
        <span class="rd-docs-badge-label">{label}</span>
    </p>

@component Compatibility = |{ caption }, content| {
    <div class="rd-docs-compatibility rd-docs-block" data-rocci-docs="compatibility">
        @if caption != "" {
            <p class="rd-docs-caption">{caption}</p>
        }
        {content}
    </div>
}

@component Example = |{}, content|
    <figure class="rd-docs-example rd-docs-block" data-rocci-docs="example">{content}</figure>

@component Include = |{}, content|
    <>{content}</>
