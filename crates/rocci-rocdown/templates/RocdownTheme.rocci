import Html
import Breadcrumbs
import NavList
import PageOutline

@css {
    :scope {
        --rd-color-bg: var(--canvas);
        --rd-color-surface: var(--surface);
        --rd-color-text: var(--ink);
        --rd-color-muted: var(--muted);
        --rd-color-accent: var(--accent);
        --rd-color-border: var(--line);
    }

    .skip-link {
        position: fixed;
        z-index: 100;
        top: .75rem;
        left: .75rem;
        padding: .65rem .9rem;
        border-radius: .5rem;
        background: var(--ink);
        color: var(--surface);
        transform: translateY(-160%);
    }
    .skip-link:focus { transform: translateY(0); }

    .site-header {
        position: sticky;
        z-index: 20;
        top: 0;
        height: calc(var(--header-height) + env(safe-area-inset-top, 0px));
        padding-top: env(safe-area-inset-top, 0px);
        border-bottom: 1px solid color-mix(in srgb, var(--line) 88%, transparent);
        background: color-mix(in srgb, var(--canvas) 92%, transparent);
        backdrop-filter: blur(14px);
    }
    .header-inner {
        width: min(100%, 94rem);
        height: 100%;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: .7rem;
        color: var(--ink);
        font-size: 1.05rem;
        font-weight: 760;
        letter-spacing: -.025em;
        text-decoration: none;
    }
    .brand-mark {
        width: 1.7rem;
        height: 1.7rem;
        display: grid;
        place-items: center;
        border-radius: .48rem .48rem .48rem .12rem;
        background: var(--accent);
        color: #fff;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: .88rem;
        font-weight: 800;
        transform: rotate(-2deg);
    }
    .header-rule { width: 1px; height: 1.4rem; background: var(--line-strong); }
    .header-subtitle { color: var(--muted); font-size: .88rem; }
    .lanes {
        display: flex;
        flex-wrap: wrap;
        gap: .15rem .2rem;
        margin-left: .35rem;
    }
    .lanes:not(:has(.lane-link)) { display: none; }
    .lane-link {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
        padding: .35rem .7rem;
        border-radius: .45rem;
        color: var(--muted);
        font-size: .82rem;
        font-weight: 650;
        text-decoration: none;
    }
    .lane-link:hover { color: var(--ink); background: var(--surface); }
    .lane-link.is-current {
        color: var(--accent-strong);
        background: var(--accent-soft);
    }
    .header-actions { margin-left: auto; display: flex; align-items: center; gap: .55rem; }
    .header-link {
        display: inline-flex;
        min-height: 2.25rem;
        align-items: center;
        padding: .35rem .72rem;
        border: 1px solid var(--line);
        border-radius: .55rem;
        background: var(--surface);
        color: var(--muted);
        font-size: .82rem;
        font-weight: 650;
        text-decoration: none;
    }
    .header-link:hover { border-color: var(--line-strong); color: var(--ink); }
    .goto-open {
        display: inline-flex;
        min-height: 2.25rem;
        align-items: center;
        padding: .35rem .72rem;
        border: 1px solid var(--line);
        border-radius: .55rem;
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        font-size: .82rem;
        font-weight: 650;
        cursor: pointer;
    }
    .goto-open:hover { border-color: var(--line-strong); color: var(--ink); }

    .site-grid {
        width: min(100%, 94rem);
        min-height: calc(100vh - var(--header-height) - var(--rocci-chrome-bottom, 0px));
        margin: 0 auto;
        display: grid;
        grid-template-columns: 17rem minmax(0, 1fr) 13.5rem;
    }
    .sidebar {
        position: sticky;
        top: var(--header-height);
        height: calc(100vh - var(--header-height) - var(--rocci-chrome-bottom, 0px));
        padding: 2rem 1.35rem 3rem 1.5rem;
        overflow-y: auto;
        border-right: 1px solid var(--line);
    }
    .nav-section { margin: 0; }
    .nav-section + .nav-section { margin-top: .28rem; }
    .nav-section summary {
        list-style: none;
        cursor: pointer;
        position: relative;
        padding-right: 1.75rem;
    }
    .nav-section summary::-webkit-details-marker { display: none; }
    .nav-section summary::after {
        content: "+";
        position: absolute;
        right: .68rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--faint);
        font-weight: 500;
    }
    .nav-section[open] > summary::after { content: "−"; }
    .nav-label {
        margin: 0 0 .42rem .68rem;
        color: var(--faint);
        font-size: .68rem;
        font-weight: 760;
        letter-spacing: .105em;
        text-transform: uppercase;
    }
    .nav-items { display: grid; gap: .08rem; }
    .nav-link {
        display: block;
        padding: .42rem .68rem;
        border-radius: .45rem;
        color: var(--muted);
        font-size: .88rem;
        line-height: 1.35;
        text-decoration: none;
    }
    .nav-link:hover { background: var(--surface); color: var(--ink); }
    .nav-link.is-current {
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 680;
    }
    .nav-category {
        color: var(--ink);
        font-weight: 680;
    }
    .nav-section[open] > summary .nav-category:not(.is-current) {
        color: var(--accent-strong);
    }
    .nav-child {
        margin-left: .7rem;
        padding-left: 1rem;
        border-left: 1px solid var(--line);
        border-radius: 0 .45rem .45rem 0;
        font-size: .82rem;
    }

    .content-column { min-width: 0; padding: 3.4rem clamp(1.5rem, 5vw, 5rem) 5rem; }

    .outline {
        position: sticky;
        top: var(--header-height);
        height: calc(100vh - var(--header-height) - var(--rocci-chrome-bottom, 0px));
        padding: 2.15rem 1.5rem 2rem 1.2rem;
        overflow-y: auto;
        user-select: none;
    }
    .outline-label {
        margin: 0 0 .65rem;
        color: var(--faint);
        font-size: .68rem;
        font-weight: 760;
        letter-spacing: .105em;
        text-transform: uppercase;
    }
    .outline-items { display: grid; gap: .45rem; border-left: 1px solid var(--line); }
    .outline-link {
        margin-left: -1px;
        padding-left: .8rem;
        border-left: 1px solid transparent;
        color: var(--muted);
        font-size: .78rem;
        line-height: 1.35;
        text-decoration: none;
    }
    .outline-link:hover { border-color: var(--accent); color: var(--ink); }
    .outline-link.level-3 { padding-left: 1.35rem; color: var(--faint); }
    .outline:not(:has(.outline-link)) .outline-label,
    .outline:not(:has(.outline-link)) .outline-items { display: none; }

    .breadcrumbs {
        width: min(100%, 46rem);
        margin: 0 auto 1.4rem;
        color: var(--muted);
        font-size: .82rem;
    }
    .breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem .55rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .breadcrumbs a { color: var(--muted); text-decoration: none; }
    .breadcrumbs a:hover { color: var(--ink); }
    .breadcrumbs .crumb-current { color: var(--ink); font-weight: 650; }
    .breadcrumbs li:not(:last-child)::after {
        content: "/";
        margin-left: .55rem;
        color: var(--faint);
    }

    .journey {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: .75rem 1.5rem;
        margin: 0 0 1.5rem;
    }
    .journey a {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
        color: var(--ink);
        font-weight: 650;
        text-decoration: none;
    }
    .journey a:hover { color: var(--accent-strong); }
    .journey-next { margin-left: auto; }

    .breadcrumbs:not(:has(li)),
    .journey:not(:has(a)) { display: none; }

    .article-footer {
        width: min(100%, 46rem);
        margin: 4rem auto 0;
        padding-top: 1.2rem;
        border-top: 1px solid var(--line);
        color: var(--faint);
        font-size: .8rem;
    }
    .article-footer a { color: var(--muted); }
    .mobile-menu { display: none; }

    @media (max-width: 70rem) {
        .site-grid { grid-template-columns: 16.5rem minmax(0, 1fr); }
        .outline { display: none; }
    }
    @media (max-width: 48rem) {
        .header-inner { padding: 0 1rem; }
        .header-rule, .header-subtitle, .header-link, .lanes { display: none; }
        .site-grid { display: block; }
        .sidebar { display: none; }
        .content-column { padding: 2.3rem 1.25rem 4rem; }
        .mobile-menu { position: relative; display: block; margin-left: auto; }
        .mobile-menu summary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2.75rem;
            min-width: 2.75rem;
            padding: 0 .85rem;
            border: 1px solid var(--line);
            border-radius: .5rem;
            background: var(--surface);
            color: var(--muted);
            font-size: .82rem;
            font-weight: 680;
            cursor: pointer;
            list-style: none;
        }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-panel { display: none; }
        .mobile-menu[open] .mobile-panel { display: block; }
        .mobile-panel {
            position: fixed;
            top: calc(var(--header-height) + env(safe-area-inset-top, 0px));
            right: 0;
            left: 0;
            max-height: calc(100vh - var(--header-height) - env(safe-area-inset-top, 0px) - var(--rocci-chrome-bottom, 0px));
            max-height: calc(100dvh - var(--header-height) - env(safe-area-inset-top, 0px) - var(--rocci-chrome-bottom, 0px));
            padding: 1.3rem max(1rem, env(safe-area-inset-right, 0px)) max(2rem, env(safe-area-inset-bottom, 0px)) max(1rem, env(safe-area-inset-left, 0px));
            overflow-y: auto;
            border-bottom: 1px solid var(--line);
            background: var(--canvas);
            box-shadow: 0 1rem 2.5rem rgba(35, 25, 20, .12);
        }
        .mobile-panel .outline {
            display: block;
            position: static;
            height: auto;
            overflow: visible;
            margin-top: 1.25rem;
        }
        .mobile-panel .outline:not(:has(.outline-link)) { display: none; }
    }

    /* OKF Concept Metadata & Governance UI */
    .okf-concept-meta {
        margin: 0 0 2.2rem;
        padding: 1.25rem 1.4rem;
        border: 1px solid var(--line);
        border-radius: .68rem;
        background: var(--surface);
        box-shadow: 0 .25rem 1rem rgba(0, 0, 0, .02);
        user-select: none;
    }
    .okf-badge-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .4rem .5rem;
        margin-bottom: .85rem;
    }
    .okf-badge {
        display: inline-flex;
        align-items: center;
        padding: .2rem .55rem;
        border-radius: .35rem;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .74rem;
        font-weight: 650;
        line-height: 1.2;
        letter-spacing: -.01em;
    }
    .okf-type {
        background: var(--surface-raised);
        color: var(--ink);
        border: 1px solid var(--line-strong);
    }
    .okf-status-stable {
        background: color-mix(in srgb, #98c379 16%, var(--surface));
        color: #98c379;
        border: 1px solid color-mix(in srgb, #98c379 40%, transparent);
    }
    .okf-status-draft {
        background: color-mix(in srgb, #d19a66 16%, var(--surface));
        color: #d19a66;
        border: 1px solid color-mix(in srgb, #d19a66 40%, transparent);
    }
    .okf-status-deprecated {
        background: color-mix(in srgb, #e06c75 16%, var(--surface));
        color: #e06c75;
        border: 1px solid color-mix(in srgb, #e06c75 40%, transparent);
    }
    .okf-auth-normative {
        background: color-mix(in srgb, #61afef 16%, var(--surface));
        color: #61afef;
        border: 1px solid color-mix(in srgb, #61afef 40%, transparent);
    }
    .okf-auth-descriptive {
        background: var(--surface-raised);
        color: var(--muted);
        border: 1px solid var(--line);
    }
    .okf-auth-exploratory {
        background: color-mix(in srgb, #c678dd 16%, var(--surface));
        color: #c678dd;
        border: 1px solid color-mix(in srgb, #c678dd 40%, transparent);
    }
    .okf-trust-human {
        background: color-mix(in srgb, #98c379 14%, var(--surface));
        color: #98c379;
        border: 1px solid color-mix(in srgb, #98c379 35%, transparent);
    }
    .okf-trust-generated {
        background: color-mix(in srgb, #d19a66 14%, var(--surface));
        color: #d19a66;
        border: 1px solid color-mix(in srgb, #d19a66 35%, transparent);
    }
    .okf-trust-unverified {
        background: var(--surface-raised);
        color: var(--faint);
        border: 1px dashed var(--line-strong);
    }
    .okf-badge-stale {
        background: color-mix(in srgb, #e06c75 14%, var(--surface));
        color: #e06c75;
        border: 1px solid color-mix(in srgb, #e06c75 35%, transparent);
    }

    .okf-alert-banner {
        display: flex;
        gap: .65rem;
        align-items: flex-start;
        margin: .85rem 0;
        padding: .75rem .95rem;
        border-radius: .45rem;
        background: color-mix(in srgb, #d19a66 12%, var(--surface));
        border: 1px solid color-mix(in srgb, #d19a66 45%, transparent);
        border-left: .28rem solid #d19a66;
        color: var(--ink);
        font-size: .86rem;
        line-height: 1.5;
    }
    .okf-alert-icon { font-size: 1.05rem; line-height: 1; flex-shrink: 0; }
    .okf-alert-content { flex: 1; }

    .okf-meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: .55rem 1rem;
        margin: .85rem 0;
        font-size: .82rem;
        color: var(--muted);
    }
    .okf-meta-label {
        font-weight: 650;
        color: var(--ink);
        margin-right: .35rem;
    }
    .okf-meta-grid code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .84em;
        background: var(--surface-raised);
        padding: .1em .3em;
        border-radius: .25rem;
        border: 1px solid var(--line);
    }

    .okf-sources-drawer {
        margin-top: .9rem;
        padding-top: .75rem;
        border-top: 1px solid var(--line);
        font-size: .83rem;
    }
    .okf-sources-drawer summary {
        cursor: pointer;
        color: var(--ink);
        font-weight: 650;
        user-select: none;
    }
    .okf-sources-drift-note {
        font-weight: 500;
        color: var(--muted);
        margin-left: .4rem;
        font-size: .8rem;
    }
    .okf-sources-table {
        width: 100%;
        margin-top: .65rem;
        border-collapse: collapse;
        font-size: .8rem;
    }
    .okf-sources-table th, .okf-sources-table td {
        padding: .5rem .65rem;
        text-align: left;
        border-bottom: 1px solid var(--line);
    }
    .okf-sources-table th {
        background: var(--surface-raised);
        color: var(--muted);
        font-weight: 650;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .okf-sources-table code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .82em;
    }

    .okf-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
        margin-top: .75rem;
    }
    .okf-tag {
        font-size: .74rem;
        color: var(--muted);
        background: var(--surface-raised);
        padding: .12rem .45rem;
        border-radius: .3rem;
        border: 1px solid var(--line);
    }

    /* OKF Review Dashboard */
    .okf-review-view {
        width: 100%;
    }
    .okf-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
        gap: .85rem;
        margin: 1.6rem 0 2.2rem;
    }
    .okf-stat-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: .68rem;
        padding: 1.1rem .85rem;
        text-align: center;
        box-shadow: 0 .15rem .6rem rgba(0, 0, 0, .02);
    }
    .okf-stat-value {
        font-size: 1.95rem;
        font-weight: 800;
        letter-spacing: -.03em;
        line-height: 1.1;
        color: var(--ink);
        margin-bottom: .25rem;
    }
    .okf-stat-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .06em;
    }
    .okf-stat-card.is-action .okf-stat-value {
        color: #d19a66;
    }

    .okf-filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .5rem;
        margin: 1.8rem 0 1rem;
    }
    .okf-filter-btn {
        display: inline-flex;
        align-items: center;
        padding: .42rem .85rem;
        border: 1px solid var(--line);
        border-radius: .5rem;
        background: var(--surface);
        color: var(--muted);
        font-size: .83rem;
        font-weight: 650;
        cursor: pointer;
        transition: all .15s ease;
    }
    .okf-filter-btn:hover {
        border-color: var(--line-strong);
        color: var(--ink);
    }
    .okf-filter-btn.is-active {
        background: var(--accent-soft);
        color: var(--accent-strong);
        border-color: var(--accent);
        font-weight: 700;
    }
    .okf-search-input {
        margin-left: auto;
        padding: .45rem .85rem;
        border: 1px solid var(--line);
        border-radius: .5rem;
        background: var(--surface);
        color: var(--ink);
        font-size: .83rem;
        min-width: 16rem;
    }
    .okf-search-input:focus {
        outline: .15rem solid var(--accent);
        border-color: var(--accent);
    }

    .okf-table-container {
        overflow-x: auto;
        border: 1px solid var(--line);
        border-radius: .68rem;
        background: var(--surface);
        margin: 1rem 0 2.5rem;
        box-shadow: 0 .2rem .8rem rgba(0, 0, 0, .02);
    }
    .okf-review-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
        text-align: left;
    }
    .okf-review-table th {
        background: var(--surface-raised);
        padding: .85rem .95rem;
        font-weight: 700;
        color: var(--ink);
        border-bottom: 1px solid var(--line-strong);
        white-space: nowrap;
    }
    .okf-review-table td {
        padding: .85rem .95rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
    }
    .okf-review-table tr:last-child td {
        border-bottom: 0;
    }
    .okf-review-table tr:hover td {
        background: color-mix(in srgb, var(--canvas) 45%, var(--surface));
    }
    .okf-concept-title-link {
        color: var(--accent-strong);
        font-size: .92rem;
        font-weight: 700;
        text-decoration: none;
    }
    .okf-concept-title-link:hover {
        color: var(--accent);
        text-decoration: underline;
    }
    .okf-concept-id-sub code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .78rem;
        color: var(--muted);
    }
    .okf-verifier-sub code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .76rem;
        color: var(--muted);
    }
    .okf-action-wrapper {
        display: flex;
        flex-direction: column;
        gap: .3rem;
    }
    .okf-action-pill {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        padding: .2rem .55rem;
        border-radius: .35rem;
        font-size: .75rem;
        font-weight: 750;
        letter-spacing: -.01em;
    }
    .okf-action-pill.pill-action {
        background: color-mix(in srgb, #d19a66 16%, var(--surface));
        color: #d19a66;
        border: 1px solid color-mix(in srgb, #d19a66 45%, transparent);
    }
    .okf-action-pill.pill-clean {
        background: color-mix(in srgb, #98c379 16%, var(--surface));
        color: #98c379;
        border: 1px solid color-mix(in srgb, #98c379 45%, transparent);
    }
    .okf-action-pill.pill-error {
        background: color-mix(in srgb, #e06c75 16%, var(--surface));
        color: #e06c75;
        border: 1px solid color-mix(in srgb, #e06c75 45%, transparent);
    }
    .okf-action-pill.pill-info {
        background: var(--surface-raised);
        color: var(--muted);
        border: 1px solid var(--line);
    }
    .okf-action-detail-text {
        font-size: .78rem;
        color: var(--muted);
        line-height: 1.35;
    }
    .okf-focus-text {
        font-size: .84rem;
        color: var(--ink);
        line-height: 1.4;
    }
    .okf-priority-1-section {
        margin: 1.8rem 0;
    }
    .okf-cta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.25rem;
        margin: 1.5rem 0 2rem;
    }
    .okf-cta-btn {
        display: inline-flex;
        align-items: center;
        padding: .55rem 1.15rem;
        background: var(--accent);
        color: #ffffff !important;
        border-radius: .45rem;
        font-weight: 700;
        font-size: .86rem;
        text-decoration: none !important;
        transition: opacity .15s ease;
    }
    .okf-cta-btn:hover {
        opacity: .9;
    }
    .okf-secondary-link {
        font-size: .86rem;
        font-weight: 650;
        color: var(--accent-strong);
        text-decoration: none;
    }
    .okf-secondary-link:hover {
        text-decoration: underline;
    }
    .okf-home-governance {
        margin-bottom: 2rem;
    }

    .okf-diagnostics-list {
        display: flex;
        flex-direction: column;
        gap: .55rem;
        margin: 1rem 0;
    }
    .okf-diagnostic-item {
        padding: .75rem .95rem;
        border: 1px solid var(--line);
        border-radius: .5rem;
        background: var(--surface);
        font-size: .83rem;
        line-height: 1.45;
    }
    .okf-diagnostic-item code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .84em;
        background: var(--surface-raised);
        padding: .1em .3em;
        border-radius: .25rem;
        border: 1px solid var(--line);
        margin: 0 .3rem;
    }

    @media (prefers-color-scheme: light) {
        .okf-status-stable, .okf-trust-human, .okf-action-pill.pill-clean { color: #50a14f; }
        .okf-status-draft, .okf-trust-generated, .okf-action-pill.pill-action, .okf-stat-card.is-action .okf-stat-value { color: #986801; }
        .okf-status-deprecated, .okf-action-pill.pill-error { color: #e45649; }
        .okf-auth-normative { color: #4078f2; }
        .okf-auth-exploratory { color: #a626a4; }
        .okf-alert-banner { border-left-color: #986801; }
    }

    @media print {
        .site-header, .sidebar, .outline, .article-footer { display: none; }
        .site-grid { display: block; }
        .content-column { padding: 0; }
    }

    @media (forced-colors: active) {
        .skip-link:focus {
            outline: .18rem solid currentColor;
            outline-offset: .18rem;
        }
        .nav-link.is-current,
        .lane-link.is-current,
        .brand-mark {
            outline: .12rem solid currentColor;
        }
        .site-header,
        .sidebar,
        .header-link,
        .mobile-menu summary {
            border: 1px solid currentColor;
        }
    }
}

@component GithubIcon = |{}| {
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.53-.49-.45-1.18-1.11-1.49-1.11-1.49-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0.84-.27 2.75 1.02 4.16-.2.55-.27 1.14-.27 1.73 0 1.26 1.08 2.2 2.42 2.2.78 0 1.52-.29 2.06-.8a7.87 7.87 0 01-2.6.39c-1.95 0-2.67-1.21-2.67-1.21-.54-1.37-1.35-1.95-1.35-1.95-.11-.25-.03-.55.17-.73 0 0 1.19.14 1.91.92.54-.18 1.1-.27 1.67-.27.56 0 1.12.09 1.66.27.72-.78 1.9-.92 1.9-.92.2.18.24.48.14.73 0 0-.82.58-1.35 1.95-.54 1.37-2.14 1.65-2.67 1.65-.53 0-1.02-.07-1.47-.2 1.25.77 1.96 1.91 1.96 3.47 0 2.49-2.02 4.48-4.53 4.92.39.32.73.95.73 1.96 0 1.42-.01 2.57-.01 2.93 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        />
    </svg>
}

@component GithubLink = |{ href }| {
    <a class="header-icon-link" href={href} aria-label="GitHub repository">
        <GithubIcon />
    </a>
}

@component ExperimentalBanner = |{}| {
    <div class="experimental-banner" role="status">
        <p class="experimental-banner-text">
            <strong>Highly experimental software.</strong>
            For testing only — not for production use.
        </p>
    </div>
}

@component SiteFooter = |{ footer, repository }| {
    <footer class="site-footer">
        <div class="footer-inner">
            @if footer != "" {
                <p class="footer-text">{footer}</p>
            }
            @if repository != "" {
                <p class="footer-links">
                    <a class="footer-github-link" href={repository}>
                        <GithubIcon />
                        <span>GitHub</span>
                    </a>
                </p>
            }
        </div>
    </footer>
}

@css {
    .header-icon-link {
        display: inline-flex;
        min-height: 2.25rem;
        min-width: 2.25rem;
        align-items: center;
        justify-content: center;
        padding: .35rem;
        border: 1px solid var(--line);
        border-radius: .55rem;
        background: var(--surface);
        color: var(--muted);
        text-decoration: none;
    }
    .header-icon-link:hover {
        border-color: var(--line-strong);
        color: var(--ink);
    }
    .header-icon-link svg {
        width: 1.1rem;
        height: 1.1rem;
    }
    .experimental-banner {
        border-bottom: 1px solid color-mix(in srgb, #d19a66 45%, var(--line));
        background: color-mix(in srgb, #d19a66 14%, var(--surface));
        padding: 1.1rem 1.5rem;
        text-align: center;
    }
    .experimental-banner-text {
        margin: 0;
        color: var(--ink);
        font-size: 1.05rem;
        line-height: 1.45;
    }
    .experimental-banner-text strong {
        font-size: 1.15rem;
        font-weight: 800;
    }
    .site-footer {
        border-top: 1px solid var(--line);
        padding: 2rem 1.5rem;
        margin-top: 0;
        background: var(--surface);
    }
    .footer-inner {
        width: min(100%, 94rem);
        margin: 0 auto;
        text-align: center;
    }
    .footer-text {
        margin: 0;
        font-size: .875rem;
        color: var(--muted);
    }
    .footer-links { margin: .75rem 0 0; }
    .footer-github-link {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--muted);
        font-size: .875rem;
        font-weight: 650;
        text-decoration: none;
    }
    .footer-github-link:hover { color: var(--ink); }
    .footer-github-link svg {
        width: 1rem;
        height: 1rem;
    }
}

@component SiteShell = |{ site, lanes, sidebar, route, title, document_title, description, outline, breadcrumbs, previous, next, resources, layout, published, updated, authors, tags, collection, collection_items }, content| {
    <html lang={site.language} class="rd-document">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <meta name="color-scheme" content="dark light" />
            <meta http-equiv="Content-Security-Policy" content={resources.csp} />
            <title>{document_title}</title>
            <link rel="stylesheet" href={resources.stylesheet} />
            @if resources.playground_css != "" {
                <link rel="stylesheet" href={resources.playground_css} />
            }
            @if resources.module_script != "" {
                <script type="module" src={resources.module_script}></script>
            }
            @if resources.chrome_script != "" {
                <script src={resources.chrome_script} defer></script>
            }
            @if description != "" {
                <meta name="description" content={description} />
            } @else if site.description != "" {
                <meta name="description" content={site.description} />
            }
            @if resources.canonical != "" {
                <link rel="canonical" href={resources.canonical} />
                <meta property="og:url" content={resources.canonical} />
            }
            <meta property="og:type" content="website" />
            <meta property="og:title" content={title} />
            <meta property="og:site_name" content={site.title} />
            @if description != "" {
                <meta property="og:description" content={description} />
            }
            @if site.social_image != "" {
                <meta property="og:image" content={"${site.base_url}${site.social_image}"} />
                <meta name="twitter:card" content="summary_large_image" />
            }
            @if site.favicon != "" {
                <link rel="icon" href={site.favicon} type="image/svg+xml" />
            }
            @if site.apple_touch_icon != "" {
                <link rel="apple-touch-icon" href={site.apple_touch_icon} />
            }
            @if published != "" {
                <meta property="article:published_time" content={published} />
            }
            @if updated != "" {
                <meta property="article:modified_time" content={updated} />
            }
            @if collection != "" {
                <meta name="rocdown:collection" content={collection} />
            }
            @for author in authors {
                <meta name="author" content={author} />
            }
            @for tag in tags {
                <meta property="article:tag" content={tag} />
            }
        </head>
        <body>
            <a class="skip-link" href="#main-content">Skip to content</a>
            <header class="site-header">
                <div class="header-inner">
                    <a class="brand" href="/" aria-label={"${site.title} home"}>
                        <span class="brand-mark" aria-hidden="true">r</span>
                        <span>{site.title}</span>
                    </a>
                    @if site.subtitle != "" {
                        <span class="header-rule" aria-hidden="true"></span>
                        <span class="header-subtitle">{site.subtitle}</span>
                    }
                    <nav class="lanes" aria-label="Sections">
                        @if !List.is_empty(lanes) {
                            @for lane in lanes {
                                <a
                                    class={if lane.current { "lane-link is-current" } else { "lane-link" }}
                                    href={lane.href}
                                    aria-current={if lane.current { "true" } else { "false" }}
                                >{lane.label}</a>
                            }
                        }
                    </nav>
                    <div class="header-actions">
                        <button type="button" class="goto-open" data-rocci-goto-open aria-label="Go to page">Go to</button>
                        @if site.repository != "" {
                            <GithubLink href={site.repository} />
                        }
                    </div>
                    <details class="mobile-menu">
                        <summary>Menu</summary>
                        <div class="mobile-panel">
                            <nav aria-label="Sections">
                                @if !List.is_empty(lanes) {
                                    @for lane in lanes {
                                        <a
                                            class={if lane.current { "lane-link is-current" } else { "lane-link" }}
                                            href={lane.href}
                                            aria-current={if lane.current { "true" } else { "false" }}
                                        >{lane.label}</a>
                                    }
                                }
                            </nav>
                            <NavList.navList items={sidebar} route={route} aria_label="Site navigation" />
                            <PageOutline.pageOutline outline={outline} />
                        </div>
                    </details>
                </div>
            </header>
            @if route == "/" {
                <ExperimentalBanner />
            }
            @if route == "/docs/" {
                <ExperimentalBanner />
            }
            <div class={
                if layout == "plain" {
                    "site-grid is-plain"
                } else if layout == "home" {
                    "site-grid is-plain"
                } else if layout == "not-found" {
                    "site-grid is-plain"
                } else {
                    "site-grid"
                }
            }>
                @if layout != "plain" {
                    @if layout != "home" {
                        @if layout != "not-found" {
                            <aside class="sidebar">
                                <NavList.navList items={sidebar} route={route} aria_label="Site navigation" />
                            </aside>
                        }
                    }
                }
                <main class="content-column" id="main-content">
                    @if layout != "home" {
                        <Breadcrumbs.breadcrumbs breadcrumbs={breadcrumbs} route={route} />
                    }
                    <article class="article" data-rd-select-root>{content}</article>
                    @if layout == "collection" {
                        <div class="collection-items">
                            @for item in collection_items {
                                <a class="collection-item" href={item.route}>{item.title}</a>
                            }
                        </div>
                    }
                    @if layout == "docs" {
                        <nav class="journey" aria-label="Page">
                            @if previous.href != "" {
                                <a class="journey-prev" href={previous.href}>← {previous.title}</a>
                            }
                            @if next.href != "" {
                                <a class="journey-next" href={next.href}>{next.title} →</a>
                            }
                        </nav>
                    }
                </main>
                @if layout != "plain" {
                    @if layout != "home" {
                        @if layout != "not-found" {
                            <PageOutline.pageOutline outline={outline} />
                        }
                    }
                }
            </div>
            <SiteFooter footer={site.footer} repository={site.repository} />
        </body>
    </html>
}
