import Html

@css {
    :scope {
        --canvas: #282c34;
        --surface: #21252b;
        --surface-raised: #2c313c;
        --ink: #abb2bf;
        --muted: #9da5b4;
        --faint: #7f848e;
        --line: #3e4451;
        --line-strong: #4b5263;
        --accent: #61afef;
        --accent-strong: #61afef;
        --accent-soft: #2c313c;
        --code: #21252b;
        --code-ink: #abb2bf;
        --syntax-keyword: #c678dd;
        --syntax-string: #98c379;
        --syntax-comment: #7f848e;
        --syntax-type: #e5c07b;
        --syntax-function: #61afef;
        --syntax-variable: #e06c75;
        --syntax-property: #d19a66;
        --syntax-operator: #56b6c2;
        --syntax-number: #d19a66;
        --syntax-tag: #e06c75;
        --syntax-punctuation: #abb2bf;
        --header-height: 4.25rem;
        color-scheme: dark light;
        background: var(--canvas);
        color: var(--ink);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 16px;
        line-height: 1.65;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
    }

    * { box-sizing: border-box; }
    body { margin: 0; background: var(--canvas); }
    a { color: inherit; }
    img { max-width: 100%; height: auto; }

    .skip-link {
        position: fixed;
        z-index: 100;
        top: .75rem;
        left: .75rem;
        padding: .65rem .9rem;
        border-radius: .5rem;
        background: var(--ink);
        color: var(--surface);
        transform: translateY(-160%);
    }
    .skip-link:focus { transform: translateY(0); }

    .site-header {
        position: sticky;
        z-index: 20;
        top: 0;
        height: var(--header-height);
        border-bottom: 1px solid color-mix(in srgb, var(--line) 88%, transparent);
        background: color-mix(in srgb, var(--canvas) 92%, transparent);
        backdrop-filter: blur(14px);
    }
    .header-inner {
        width: min(100%, 94rem);
        height: 100%;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: .7rem;
        color: var(--ink);
        font-size: 1.05rem;
        font-weight: 760;
        letter-spacing: -.025em;
        text-decoration: none;
    }
    .brand-mark {
        width: 1.7rem;
        height: 1.7rem;
        display: grid;
        place-items: center;
        border-radius: .48rem .48rem .48rem .12rem;
        background: var(--accent);
        color: #fff;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: .88rem;
        font-weight: 800;
        transform: rotate(-2deg);
    }
    .header-rule { width: 1px; height: 1.4rem; background: var(--line-strong); }
    .header-subtitle { color: var(--muted); font-size: .88rem; }
    .lanes {
        display: flex;
        flex-wrap: wrap;
        gap: .15rem .2rem;
        margin-left: .35rem;
    }
    .lanes:not(:has(.lane-link)) { display: none; }
    .lane-link {
        display: inline-flex;
        min-height: 2.25rem;
        align-items: center;
        padding: .35rem .7rem;
        border-radius: .45rem;
        color: var(--muted);
        font-size: .82rem;
        font-weight: 650;
        text-decoration: none;
    }
    .lane-link:hover { color: var(--ink); background: var(--surface); }
    .lane-link.is-current {
        color: var(--accent-strong);
        background: var(--accent-soft);
    }
    .header-actions { margin-left: auto; display: flex; align-items: center; gap: .55rem; }
    .header-link {
        display: inline-flex;
        min-height: 2.25rem;
        align-items: center;
        padding: .35rem .72rem;
        border: 1px solid var(--line);
        border-radius: .55rem;
        background: var(--surface);
        color: var(--muted);
        font-size: .82rem;
        font-weight: 650;
        text-decoration: none;
    }
    .header-link:hover { border-color: var(--line-strong); color: var(--ink); }

    .site-grid {
        width: min(100%, 94rem);
        min-height: calc(100vh - var(--header-height));
        margin: 0 auto;
        display: grid;
        grid-template-columns: 17rem minmax(0, 1fr) 13.5rem;
    }
    .sidebar {
        position: sticky;
        top: var(--header-height);
        height: calc(100vh - var(--header-height));
        padding: 2rem 1.35rem 3rem 1.5rem;
        overflow-y: auto;
        border-right: 1px solid var(--line);
    }
    .nav-section + .nav-section { margin-top: 1.65rem; }
    .nav-label {
        margin: 0 0 .42rem .68rem;
        color: var(--faint);
        font-size: .68rem;
        font-weight: 760;
        letter-spacing: .105em;
        text-transform: uppercase;
    }
    .nav-items { display: grid; gap: .08rem; }
    .nav-link {
        display: block;
        padding: .42rem .68rem;
        border-radius: .45rem;
        color: var(--muted);
        font-size: .88rem;
        line-height: 1.35;
        text-decoration: none;
    }
    .nav-link:hover { background: var(--surface); color: var(--ink); }
    .nav-link.is-current {
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 680;
    }
    .nav-category {
        position: relative;
        padding-right: 1.75rem;
        color: var(--ink);
        font-weight: 680;
    }
    .nav-category::after {
        content: "+";
        position: absolute;
        right: .68rem;
        color: var(--faint);
        font-weight: 500;
    }
    .nav-category.is-expanded::after { content: "−"; }
    .nav-category.is-expanded:not(.is-current) {
        color: var(--accent-strong);
    }
    .nav-category:not(:first-child) { margin-top: .28rem; }
    .nav-child {
        margin-left: .7rem;
        padding-left: 1rem;
        border-left: 1px solid var(--line);
        border-radius: 0 .45rem .45rem 0;
        font-size: .82rem;
    }

    .content-column { min-width: 0; padding: 3.4rem clamp(1.5rem, 5vw, 5rem) 5rem; }
    .article { width: min(100%, 46rem); margin: 0 auto; overflow-x: auto; }
    .article > :first-child { margin-top: 0; }
    .article .rd-header-1 {
        margin: 0 0 1.15rem;
        color: var(--ink);
        font-size: clamp(2.35rem, 5vw, 4.35rem);
        font-weight: 790;
        line-height: .98;
        letter-spacing: -.055em;
    }
    .article .rd-header-1 + .rd-paragraph {
        margin-top: 0;
        color: var(--muted);
        font-size: 1.15rem;
        line-height: 1.6;
    }
    .article .rd-header-2 {
        margin: 3.4rem 0 1rem;
        padding-top: .45rem;
        color: var(--ink);
        font-size: 1.58rem;
        font-weight: 745;
        line-height: 1.2;
        letter-spacing: -.025em;
    }
    .article .rd-header-3 {
        margin: 2.25rem 0 .7rem;
        color: var(--ink);
        font-size: 1.12rem;
        font-weight: 720;
        line-height: 1.3;
    }
    .article .rd-paragraph { margin: 1rem 0; }
    .article .rd-strong { color: var(--ink); font-weight: 720; }
    .article .rd-link {
        color: var(--accent-strong);
        font-weight: 560;
        text-decoration-color: color-mix(in srgb, var(--accent) 42%, transparent);
        text-decoration-thickness: .08em;
        text-underline-offset: .18em;
    }
    .article .rd-link:hover { color: var(--accent); text-decoration-color: currentColor; }
    .article .rd-list, .article .rd-list-ordered { margin: 1rem 0; padding-left: 1.35rem; }
    .article .rd-list-item, .article .rd-task-item { margin: .38rem 0; padding-left: .18rem; }
    .article .rd-blockquote {
        margin: 1.4rem 0;
        padding: 1rem 1.15rem;
        border: 1px solid var(--line);
        border-left: .25rem solid var(--accent);
        border-radius: .2rem .65rem .65rem .2rem;
        background: var(--accent-soft);
        color: color-mix(in srgb, var(--ink) 86%, var(--accent));
    }
    .article .rd-blockquote .rd-paragraph { margin: 0; }
    .article .rd-code {
        padding: .12em .34em;
        border: 1px solid var(--line);
        border-radius: .35rem;
        background: var(--surface-raised);
        color: var(--syntax-variable);
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .87em;
    }
    .article .rd-code-block {
        margin: 1.35rem 0;
        padding: 1.1rem 1.2rem;
        overflow-x: auto;
        border: 1px solid var(--line);
        border-radius: .72rem;
        background: var(--code);
        box-shadow: 0 .7rem 2rem rgba(50, 35, 25, .08);
    }
    .article .rd-code-block .rd-code {
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--code-ink);
        font-size: .86rem;
        line-height: 1.65;
    }
    .article .rd-code-block .tok-keyword { color: var(--syntax-keyword); font-weight: 600; }
    .article .rd-code-block .tok-string { color: var(--syntax-string); }
    .article .rd-code-block .tok-comment { color: var(--syntax-comment); font-style: italic; }
    .article .rd-code-block .tok-type { color: var(--syntax-type); }
    .article .rd-code-block .tok-function { color: var(--syntax-function); }
    .article .rd-code-block .tok-variable { color: var(--syntax-variable); }
    .article .rd-code-block .tok-property { color: var(--syntax-property); }
    .article .rd-code-block .tok-operator { color: var(--syntax-operator); }
    .article .rd-code-block .tok-number { color: var(--syntax-number); }
    .article .rd-code-block .tok-tag { color: var(--syntax-tag); }
    .article .rd-code-block .tok-punctuation { color: var(--syntax-punctuation); }
    .article .rd-code-block .tok-enum-member { color: var(--syntax-type); }
    .article .rd-code-block .tok-parameter { color: var(--syntax-variable); }
    .article .rd-code-block .tok-namespace { color: var(--syntax-type); }
    .article .rd-code-block .tok-definition { font-weight: 600; }
    .article .rd-code-block .tok-default-library { font-weight: 500; }
    .article .rd-table {
        width: 100%;
        margin: 1.4rem 0;
        border-spacing: 0;
        border: 1px solid var(--line);
        border-radius: .68rem;
        overflow: hidden;
        background: var(--surface);
        font-size: .9rem;
    }
    .article .rd-table-header {
        padding: .7rem .82rem;
        border-bottom: 1px solid var(--line-strong);
        background: var(--surface-raised);
        color: var(--ink);
        font-weight: 700;
        text-align: left;
    }
    .article .rd-table-cell { padding: .72rem .82rem; border-bottom: 1px solid var(--line); vertical-align: top; }
    .article .rd-table-row:last-child .rd-table-cell { border-bottom: 0; }
    .article .rd-thematic-break { margin: 3rem 0; border: 0; border-top: 1px solid var(--line); }

    .outline {
        position: sticky;
        top: var(--header-height);
        height: calc(100vh - var(--header-height));
        padding: 2.15rem 1.5rem 2rem 1.2rem;
        overflow-y: auto;
    }
    .outline-label {
        margin: 0 0 .65rem;
        color: var(--faint);
        font-size: .68rem;
        font-weight: 760;
        letter-spacing: .105em;
        text-transform: uppercase;
    }
    .outline-items { display: grid; gap: .45rem; border-left: 1px solid var(--line); }
    .outline-link {
        margin-left: -1px;
        padding-left: .8rem;
        border-left: 1px solid transparent;
        color: var(--muted);
        font-size: .78rem;
        line-height: 1.35;
        text-decoration: none;
    }
    .outline-link:hover { border-color: var(--accent); color: var(--ink); }
    .outline-link.level-3 { padding-left: 1.35rem; color: var(--faint); }
    .outline:not(:has(.outline-link)) .outline-label,
    .outline:not(:has(.outline-link)) .outline-items { display: none; }

    .breadcrumbs {
        width: min(100%, 46rem);
        margin: 0 auto 1.4rem;
        color: var(--muted);
        font-size: .82rem;
    }
    .breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem .55rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .breadcrumbs a { color: var(--muted); text-decoration: none; }
    .breadcrumbs a:hover { color: var(--ink); }
    .breadcrumbs .crumb-current { color: var(--ink); font-weight: 650; }
    .breadcrumbs li:not(:last-child)::after {
        content: "/";
        margin-left: .55rem;
        color: var(--faint);
    }

    .journey {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: .75rem 1.5rem;
        margin: 0 0 1.5rem;
    }
    .journey a {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
        color: var(--ink);
        font-weight: 650;
        text-decoration: none;
    }
    .journey a:hover { color: var(--accent-strong); }
    .journey-next { margin-left: auto; }

    .breadcrumbs:not(:has(li)),
    .journey:not(:has(a)) { display: none; }

    .article-footer {
        width: min(100%, 46rem);
        margin: 4rem auto 0;
        padding-top: 1.2rem;
        border-top: 1px solid var(--line);
        color: var(--faint);
        font-size: .8rem;
    }
    .article-footer a { color: var(--muted); }
    .mobile-menu { display: none; }

    :focus-visible { outline: .18rem solid color-mix(in srgb, var(--accent) 70%, white); outline-offset: .18rem; }

    @media (max-width: 70rem) {
        .site-grid { grid-template-columns: 16.5rem minmax(0, 1fr); }
        .outline { display: none; }
    }
    @media (max-width: 48rem) {
        .header-inner { padding: 0 1rem; }
        .header-rule, .header-subtitle, .header-link, .lanes { display: none; }
        .site-grid { display: block; }
        .sidebar { display: none; }
        .content-column { padding: 2.3rem 1.25rem 4rem; }
        .article .rd-header-1 { font-size: clamp(2.25rem, 13vw, 3.35rem); }
        .mobile-menu { position: relative; display: block; margin-left: auto; }
        .mobile-menu summary {
            padding: .38rem .7rem;
            border: 1px solid var(--line);
            border-radius: .5rem;
            background: var(--surface);
            color: var(--muted);
            font-size: .82rem;
            font-weight: 680;
            cursor: pointer;
            list-style: none;
        }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-menu[open] .mobile-panel { display: block; }
        .mobile-panel {
            position: fixed;
            top: var(--header-height);
            right: 0;
            left: 0;
            max-height: calc(100vh - var(--header-height));
            padding: 1.3rem 1rem 2rem;
            overflow-y: auto;
            border-bottom: 1px solid var(--line);
            background: var(--canvas);
            box-shadow: 0 1rem 2.5rem rgba(35, 25, 20, .12);
        }
    }

    /* OKF Concept Metadata & Governance UI */
    .okf-concept-meta {
        margin: 0 0 2.2rem;
        padding: 1.25rem 1.4rem;
        border: 1px solid var(--line);
        border-radius: .68rem;
        background: var(--surface);
        box-shadow: 0 .25rem 1rem rgba(0, 0, 0, .02);
    }
    .okf-badge-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .4rem .5rem;
        margin-bottom: .85rem;
    }
    .okf-badge {
        display: inline-flex;
        align-items: center;
        padding: .2rem .55rem;
        border-radius: .35rem;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .74rem;
        font-weight: 650;
        line-height: 1.2;
        letter-spacing: -.01em;
    }
    .okf-type {
        background: var(--surface-raised);
        color: var(--ink);
        border: 1px solid var(--line-strong);
    }
    .okf-status-stable {
        background: color-mix(in srgb, #98c379 16%, var(--surface));
        color: #98c379;
        border: 1px solid color-mix(in srgb, #98c379 40%, transparent);
    }
    .okf-status-draft {
        background: color-mix(in srgb, #d19a66 16%, var(--surface));
        color: #d19a66;
        border: 1px solid color-mix(in srgb, #d19a66 40%, transparent);
    }
    .okf-status-deprecated {
        background: color-mix(in srgb, #e06c75 16%, var(--surface));
        color: #e06c75;
        border: 1px solid color-mix(in srgb, #e06c75 40%, transparent);
    }
    .okf-auth-normative {
        background: color-mix(in srgb, #61afef 16%, var(--surface));
        color: #61afef;
        border: 1px solid color-mix(in srgb, #61afef 40%, transparent);
    }
    .okf-auth-descriptive {
        background: var(--surface-raised);
        color: var(--muted);
        border: 1px solid var(--line);
    }
    .okf-auth-exploratory {
        background: color-mix(in srgb, #c678dd 16%, var(--surface));
        color: #c678dd;
        border: 1px solid color-mix(in srgb, #c678dd 40%, transparent);
    }
    .okf-trust-human {
        background: color-mix(in srgb, #98c379 14%, var(--surface));
        color: #98c379;
        border: 1px solid color-mix(in srgb, #98c379 35%, transparent);
    }
    .okf-trust-generated {
        background: color-mix(in srgb, #d19a66 14%, var(--surface));
        color: #d19a66;
        border: 1px solid color-mix(in srgb, #d19a66 35%, transparent);
    }
    .okf-trust-unverified {
        background: var(--surface-raised);
        color: var(--faint);
        border: 1px dashed var(--line-strong);
    }
    .okf-badge-stale {
        background: color-mix(in srgb, #e06c75 14%, var(--surface));
        color: #e06c75;
        border: 1px solid color-mix(in srgb, #e06c75 35%, transparent);
    }

    .okf-alert-banner {
        display: flex;
        gap: .65rem;
        align-items: flex-start;
        margin: .85rem 0;
        padding: .75rem .95rem;
        border-radius: .45rem;
        background: color-mix(in srgb, #d19a66 12%, var(--surface));
        border: 1px solid color-mix(in srgb, #d19a66 45%, transparent);
        border-left: .28rem solid #d19a66;
        color: var(--ink);
        font-size: .86rem;
        line-height: 1.5;
    }
    .okf-alert-icon { font-size: 1.05rem; line-height: 1; flex-shrink: 0; }
    .okf-alert-content { flex: 1; }

    .okf-meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: .55rem 1rem;
        margin: .85rem 0;
        font-size: .82rem;
        color: var(--muted);
    }
    .okf-meta-label {
        font-weight: 650;
        color: var(--ink);
        margin-right: .35rem;
    }
    .okf-meta-grid code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .84em;
        background: var(--surface-raised);
        padding: .1em .3em;
        border-radius: .25rem;
        border: 1px solid var(--line);
    }

    .okf-sources-drawer {
        margin-top: .9rem;
        padding-top: .75rem;
        border-top: 1px solid var(--line);
        font-size: .83rem;
    }
    .okf-sources-drawer summary {
        cursor: pointer;
        color: var(--ink);
        font-weight: 650;
        user-select: none;
    }
    .okf-sources-drift-note {
        font-weight: 500;
        color: var(--muted);
        margin-left: .4rem;
        font-size: .8rem;
    }
    .okf-sources-table {
        width: 100%;
        margin-top: .65rem;
        border-collapse: collapse;
        font-size: .8rem;
    }
    .okf-sources-table th, .okf-sources-table td {
        padding: .5rem .65rem;
        text-align: left;
        border-bottom: 1px solid var(--line);
    }
    .okf-sources-table th {
        background: var(--surface-raised);
        color: var(--muted);
        font-weight: 650;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .okf-sources-table code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .82em;
    }

    .okf-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
        margin-top: .75rem;
    }
    .okf-tag {
        font-size: .74rem;
        color: var(--muted);
        background: var(--surface-raised);
        padding: .12rem .45rem;
        border-radius: .3rem;
        border: 1px solid var(--line);
    }

    /* OKF Review Dashboard */
    .okf-review-view {
        width: 100%;
    }
    .okf-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
        gap: .85rem;
        margin: 1.6rem 0 2.2rem;
    }
    .okf-stat-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: .68rem;
        padding: 1.1rem .85rem;
        text-align: center;
        box-shadow: 0 .15rem .6rem rgba(0, 0, 0, .02);
    }
    .okf-stat-value {
        font-size: 1.95rem;
        font-weight: 800;
        letter-spacing: -.03em;
        line-height: 1.1;
        color: var(--ink);
        margin-bottom: .25rem;
    }
    .okf-stat-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .06em;
    }
    .okf-stat-card.is-action .okf-stat-value {
        color: #d19a66;
    }

    .okf-filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .5rem;
        margin: 1.8rem 0 1rem;
    }
    .okf-filter-btn {
        display: inline-flex;
        align-items: center;
        padding: .42rem .85rem;
        border: 1px solid var(--line);
        border-radius: .5rem;
        background: var(--surface);
        color: var(--muted);
        font-size: .83rem;
        font-weight: 650;
        cursor: pointer;
        transition: all .15s ease;
    }
    .okf-filter-btn:hover {
        border-color: var(--line-strong);
        color: var(--ink);
    }
    .okf-filter-btn.is-active {
        background: var(--accent-soft);
        color: var(--accent-strong);
        border-color: var(--accent);
        font-weight: 700;
    }
    .okf-search-input {
        margin-left: auto;
        padding: .45rem .85rem;
        border: 1px solid var(--line);
        border-radius: .5rem;
        background: var(--surface);
        color: var(--ink);
        font-size: .83rem;
        min-width: 16rem;
    }
    .okf-search-input:focus {
        outline: .15rem solid var(--accent);
        border-color: var(--accent);
    }

    .okf-table-container {
        overflow-x: auto;
        border: 1px solid var(--line);
        border-radius: .68rem;
        background: var(--surface);
        margin: 1rem 0 2.5rem;
        box-shadow: 0 .2rem .8rem rgba(0, 0, 0, .02);
    }
    .okf-review-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
        text-align: left;
    }
    .okf-review-table th {
        background: var(--surface-raised);
        padding: .85rem .95rem;
        font-weight: 700;
        color: var(--ink);
        border-bottom: 1px solid var(--line-strong);
        white-space: nowrap;
    }
    .okf-review-table td {
        padding: .85rem .95rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
    }
    .okf-review-table tr:last-child td {
        border-bottom: 0;
    }
    .okf-review-table tr:hover td {
        background: color-mix(in srgb, var(--canvas) 45%, var(--surface));
    }
    .okf-concept-title-link {
        color: var(--accent-strong);
        font-size: .92rem;
        font-weight: 700;
        text-decoration: none;
    }
    .okf-concept-title-link:hover {
        color: var(--accent);
        text-decoration: underline;
    }
    .okf-concept-id-sub code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .78rem;
        color: var(--muted);
    }
    .okf-verifier-sub code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .76rem;
        color: var(--muted);
    }
    .okf-action-wrapper {
        display: flex;
        flex-direction: column;
        gap: .3rem;
    }
    .okf-action-pill {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        padding: .2rem .55rem;
        border-radius: .35rem;
        font-size: .75rem;
        font-weight: 750;
        letter-spacing: -.01em;
    }
    .okf-action-pill.pill-action {
        background: color-mix(in srgb, #d19a66 16%, var(--surface));
        color: #d19a66;
        border: 1px solid color-mix(in srgb, #d19a66 45%, transparent);
    }
    .okf-action-pill.pill-clean {
        background: color-mix(in srgb, #98c379 16%, var(--surface));
        color: #98c379;
        border: 1px solid color-mix(in srgb, #98c379 45%, transparent);
    }
    .okf-action-pill.pill-error {
        background: color-mix(in srgb, #e06c75 16%, var(--surface));
        color: #e06c75;
        border: 1px solid color-mix(in srgb, #e06c75 45%, transparent);
    }
    .okf-action-pill.pill-info {
        background: var(--surface-raised);
        color: var(--muted);
        border: 1px solid var(--line);
    }
    .okf-action-detail-text {
        font-size: .78rem;
        color: var(--muted);
        line-height: 1.35;
    }
    .okf-focus-text {
        font-size: .84rem;
        color: var(--ink);
        line-height: 1.4;
    }
    .okf-priority-1-section {
        margin: 1.8rem 0;
    }
    .okf-cta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.25rem;
        margin: 1.5rem 0 2rem;
    }
    .okf-cta-btn {
        display: inline-flex;
        align-items: center;
        padding: .55rem 1.15rem;
        background: var(--accent);
        color: #ffffff !important;
        border-radius: .45rem;
        font-weight: 700;
        font-size: .86rem;
        text-decoration: none !important;
        transition: opacity .15s ease;
    }
    .okf-cta-btn:hover {
        opacity: .9;
    }
    .okf-secondary-link {
        font-size: .86rem;
        font-weight: 650;
        color: var(--accent-strong);
        text-decoration: none;
    }
    .okf-secondary-link:hover {
        text-decoration: underline;
    }
    .okf-home-governance {
        margin-bottom: 2rem;
    }

    .okf-diagnostics-list {
        display: flex;
        flex-direction: column;
        gap: .55rem;
        margin: 1rem 0;
    }
    .okf-diagnostic-item {
        padding: .75rem .95rem;
        border: 1px solid var(--line);
        border-radius: .5rem;
        background: var(--surface);
        font-size: .83rem;
        line-height: 1.45;
    }
    .okf-diagnostic-item code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .84em;
        background: var(--surface-raised);
        padding: .1em .3em;
        border-radius: .25rem;
        border: 1px solid var(--line);
        margin: 0 .3rem;
    }

    @media (prefers-color-scheme: light) {
        :scope {
            --canvas: #fafafa;
            --surface: #ffffff;
            --surface-raised: #f0f0f1;
            --ink: #383a42;
            --muted: #696c77;
            --faint: #a0a1a7;
            --line: #e5e5e6;
            --line-strong: #d0d0d1;
            --accent: #4078f2;
            --accent-strong: #4078f2;
            --accent-soft: #eef2fb;
            --code: #f0f0f1;
            --code-ink: #383a42;
            --syntax-keyword: #a626a4;
            --syntax-string: #50a14f;
            --syntax-comment: #a0a1a7;
            --syntax-type: #c18401;
            --syntax-function: #4078f2;
            --syntax-variable: #e45649;
            --syntax-property: #986801;
            --syntax-operator: #0184bc;
            --syntax-number: #986801;
            --syntax-tag: #e45649;
            --syntax-punctuation: #383a42;
        }
        .okf-status-stable, .okf-trust-human, .okf-action-pill.pill-clean { color: #50a14f; }
        .okf-status-draft, .okf-trust-generated, .okf-action-pill.pill-action, .okf-stat-card.is-action .okf-stat-value { color: #986801; }
        .okf-status-deprecated, .okf-action-pill.pill-error { color: #e45649; }
        .okf-auth-normative { color: #4078f2; }
        .okf-auth-exploratory { color: #a626a4; }
        .okf-alert-banner { border-left-color: #986801; }
    }

    @media print {
        .site-header, .sidebar, .outline, .article-footer { display: none; }
        .site-grid { display: block; }
        .content-column { padding: 0; }
        .article { max-width: none; }
        .article .rd-link { color: inherit; }
        .article .rd-code-block {
            background: #ffffff;
            color: #111111;
            border: 1px solid #cccccc;
            box-shadow: none;
        }
        .article .rd-code-block .rd-code { color: #111111; }
        .article .rd-code-block .tok-keyword { color: #b92f19; }
        .article .rd-code-block .tok-string { color: #0d766e; }
        .article .rd-code-block .tok-comment { color: #666666; }
        .article .rd-code-block .tok-type { color: #1d4ed8; }
        .article .rd-code-block .tok-function { color: #6d28d9; }
        .article .rd-code-block .tok-variable { color: #111111; }
        .article .rd-code-block .tok-property { color: #be185d; }
        .article .rd-code-block .tok-operator { color: #444444; }
        .article .rd-code-block .tok-number { color: #b45309; }
    }

    @media (forced-colors: active) {
        .skip-link:focus,
        :focus-visible {
            outline: .18rem solid currentColor;
            outline-offset: .18rem;
        }
        .nav-link.is-current,
        .lane-link.is-current,
        .brand-mark {
            outline: .12rem solid currentColor;
        }
        .site-header,
        .sidebar,
        .article .rd-blockquote,
        .article .rd-code,
        .article .rd-code-block,
        .article .rd-table,
        .header-link,
        .mobile-menu summary {
            border: 1px solid currentColor;
        }
        .article .rd-code-block span[class^="tok-"] {
            color: inherit;
        }
        .article .rd-link { text-decoration: underline; }
    }
}

@component SiteShell = |{ site, lanes, sidebar, route, title, description, outline, breadcrumbs, previous, next, resources, layout, published, updated, authors, tags, collection }, content| {
    <html lang={site.language}>
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <meta name="color-scheme" content="dark light" />
            <meta http-equiv="Content-Security-Policy" content={resources.csp} />
            <title>{title} · {site.title}</title>
            <link rel="stylesheet" href={resources.stylesheet} />
            @if resources.playground_css != "" {
                <link rel="stylesheet" href={resources.playground_css} />
            }
            @if resources.module_script != "" {
                <script type="module" src={resources.module_script}></script>
            }
            @if description != "" {
                <meta name="description" content={description} />
            } @else if site.description != "" {
                <meta name="description" content={site.description} />
            }
            @if resources.canonical != "" {
                <link rel="canonical" href={resources.canonical} />
                <meta property="og:url" content={resources.canonical} />
            }
            <meta property="og:type" content="website" />
            <meta property="og:title" content={title} />
            <meta property="og:site_name" content={site.title} />
            @if description != "" {
                <meta property="og:description" content={description} />
            }
            @if site.social_image != "" {
                <meta property="og:image" content={"${site.base_url}${site.social_image}"} />
                <meta name="twitter:card" content="summary_large_image" />
            }
        </head>
        <body>
            <a class="skip-link" href="#main-content">Skip to content</a>
            <header class="site-header">
                <div class="header-inner">
                    <a class="brand" href="/" aria-label={"${site.title} home"}>
                        <span class="brand-mark" aria-hidden="true">r</span>
                        <span>{site.title}</span>
                    </a>
                    @if site.subtitle != "" {
                        <span class="header-rule" aria-hidden="true"></span>
                        <span class="header-subtitle">{site.subtitle}</span>
                    }
                    <nav class="lanes" aria-label="Sections">
                        @for lane in lanes {
                            <a
                                class={if lane.current { "lane-link is-current" } else { "lane-link" }}
                                href={lane.href}
                                aria-current={if lane.current { "true" } else { "false" }}
                            >{lane.label}</a>
                        }
                    </nav>
                    <div class="header-actions">
                        @if site.repository != "" {
                            <a class="header-link" href={site.repository}>Source ↗</a>
                        }
                    </div>
                    <details class="mobile-menu">
                        <summary>Menu</summary>
                        <div class="mobile-panel">
                            <nav aria-label="Sections">
                                @for lane in lanes {
                                    <a
                                        class={if lane.current { "lane-link is-current" } else { "lane-link" }}
                                        href={lane.href}
                                        aria-current={if lane.current { "true" } else { "false" }}
                                    >{lane.label}</a>
                                }
                            </nav>
                            <nav aria-label="Site navigation">
                                <div class="nav-items">
                                    @for item in sidebar {
                                        <a
                                            class={item.class_name}
                                            href={item.href}
                                            aria-current={if item.href == route { "page" } else { "false" }}
                                        >{item.title}</a>
                                    }
                                </div>
                            </nav>
                        </div>
                    </details>
                </div>
            </header>
            <div class={if layout == "plain" || layout == "home" || layout == "not-found" { "site-grid is-plain" } else { "site-grid" }}>
                @if layout != "plain" && layout != "home" && layout != "not-found" {
                    <aside class="sidebar">
                        <nav aria-label="Site navigation">
                            <div class="nav-items">
                                @for item in sidebar {
                                    <a
                                        class={item.class_name}
                                        href={item.href}
                                        aria-current={if item.href == route { "page" } else { "false" }}
                                    >{item.title}</a>
                                }
                            </div>
                        </nav>
                    </aside>
                }
                <main class="content-column" id="main-content">
                    @if layout != "home" {
                        <nav class="breadcrumbs" aria-label="Breadcrumb">
                            <ol>
                                @for crumb in breadcrumbs {
                                    <li>
                                        <a
                                            class={if crumb.href == route { "crumb-current" } else { "" }}
                                            href={crumb.href}
                                            aria-current={if crumb.href == route { "page" } else { "false" }}
                                        >{crumb.title}</a>
                                    </li>
                                }
                            </ol>
                        </nav>
                    }
                    <article class="article">{content}</article>
                    @if layout == "docs" {
                        <nav class="journey" aria-label="Page">
                            @if previous.href != "" {
                                <a class="journey-prev" href={previous.href}>← {previous.title}</a>
                            }
                            @if next.href != "" {
                                <a class="journey-next" href={next.href}>{next.title} →</a>
                            }
                        </nav>
                    }
                    @if site.footer != "" {
                        <footer class="article-footer">{site.footer}</footer>
                    }
                </main>
                @if layout != "plain" && layout != "home" && layout != "not-found" {
                    <aside class="outline" aria-label="On this page">
                        <p class="outline-label">On this page</p>
                        <div class="outline-items">
                            @for heading in outline {
                                <a
                                    class={if heading.level == "3" { "outline-link level-3" } else { "outline-link" }}
                                    href={"#${heading.id}"}
                                >{heading.title}</a>
                            }
                        </div>
                    </aside>
                }
            </div>
        </body>
    </html>
}
