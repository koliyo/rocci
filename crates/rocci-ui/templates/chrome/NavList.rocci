import Html

@css {
    .nav-items { display: grid; }
    .nav-link, .nav-category {
        display: block;
        text-decoration: none;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .nav-section {
        margin: 0;
    }
    .nav-section + .nav-section { margin-top: 0.28rem; }
    .nav-section summary {
        list-style: none;
        cursor: pointer;
        position: relative;
        padding-right: 1.75rem;
    }
    .nav-section summary::-webkit-details-marker { display: none; }
    .nav-section summary::after {
        position: absolute;
        right: 0.68rem;
        top: 50%;
        width: 0.42rem;
        height: 0.42rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translate(-0.12rem, -50%) rotate(-45deg);
        transition: transform 160ms ease;
    }
    .nav-section[open] > summary::after {
        transform: translate(-0.12rem, -65%) rotate(45deg);
    }
    .nav-section > .nav-fold {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        overflow: hidden;
    }
    .nav-section > .nav-fold > .nav-items {
        min-height: 0;
        overflow: hidden;
    }
    .nav-section[open] > .nav-fold {
        grid-template-rows: 1fr;
        opacity: 1;
    }
    .nav-items > .nav-link + .nav-section {
        margin-top: 0.08rem;
        margin-bottom: 0.16rem;
        margin-left: 0.35rem;
    }
    .nav-source {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.92em;
    }
}

@component NavLink = |{ item, route }| {
    <a
        class={item.class_name}
        href={item.href}
        aria-current={if item.href == route { "page" } else { "false" }}
    >{item.title}</a>
}

@component NavNested = |{ item, route }| {
    @if List.any(item.items, |child| child.href == route) {
        <details class="nav-section" data-rocci-nav-section={item.items_label} data-rocci-nav-current="" open>
            <NavGroupInner group={{ title: item.items_label, href: "", open: True, items: item.items }} route={route} />
        </details>
    } @else if item.open {
        <details class="nav-section" data-rocci-nav-section={item.items_label} open>
            <NavGroupInner group={{ title: item.items_label, href: "", open: True, items: item.items }} route={route} />
        </details>
    } @else {
        <details class="nav-section" data-rocci-nav-section={item.items_label}>
            <NavGroupInner group={{ title: item.items_label, href: "", open: False, items: item.items }} route={route} />
        </details>
    }
}

@component NavEntry = |{ item, route }| {
    @if List.is_empty(item.items) {
        <NavLink item={item} route={route} />
    } @else {
        {
            <NavLink item={item} route={route} />
            <NavNested item={item} route={route} />
        }
    }
}

@component NavGroupInner = |{ group, route }| {
    <summary class="nav-category">
        <span class="nav-link nav-category">{group.title}</span>
    </summary>
    <div class="nav-fold">
        <div class="nav-items">
            @for item in group.items {
                <NavEntry item={item} route={route} />
            }
        </div>
    </div>
}

@component NavList = |{ items, route, aria_label }| {
    <nav aria-label={aria_label}>
        <div class="nav-items">
            @for group in items {
                @if List.is_empty(group.items) {
                    <a
                        class={if group.href == route { "nav-link is-current" } else { "nav-link" }}
                        href={group.href}
                        aria-current={if group.href == route { "page" } else { "false" }}
                    >{group.title}</a>
                } @else if List.any(group.items, |item| item.href == route || List.any(item.items, |child| child.href == route)) {
                    <details class="nav-section" data-rocci-nav-section={group.title} data-rocci-nav-current="" open>
                        <NavGroupInner group={group} route={route} />
                    </details>
                } @else if group.open {
                    <details class="nav-section" data-rocci-nav-section={group.title} open>
                        <NavGroupInner group={group} route={route} />
                    </details>
                } @else {
                    <details class="nav-section" data-rocci-nav-section={group.title}>
                        <NavGroupInner group={group} route={route} />
                    </details>
                }
            }
        </div>
    </nav>
}

@fixture{target: NavList}
navListOpen = {
    items: [
        {
            title: "Start",
            href: "/",
            open: False,
            items: [
                { title: "What is Rocci", href: "/start/what-is-rocci/", class_name: "nav-link nav-child", open: False, items_label: "", items: [] },
            ],
        },
        {
            title: "Tutorials",
            href: "/tutorials/",
            open: True,
            items: [
                { title: "Build your first component", href: "/tutorials/first-component/", class_name: "nav-link nav-child is-current", open: False, items_label: "", items: [] },
                { title: "Build your first standalone app", href: "/tutorials/first-app/", class_name: "nav-link nav-child", open: False, items_label: "", items: [] },
            ],
        },
        {
            title: "Status",
            href: "/status/",
            open: False,
            items: [],
        },
    ],
    route: "/tutorials/first-component/",
    aria_label: "Site navigation",
}
