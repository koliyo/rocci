import Html

covers_route = |group, route| {
    on_self = group.href == route
    on_items = List.any(group.items, |item| item.href == route)
    on_children = List.any(
        group.children,
        |child| child.href == route or List.any(child.items, |item| item.href == route),
    )
    on_self or on_items or on_children
}

is_leaf_group = |group| List.is_empty(group.items) and List.is_empty(group.children)

nested_covers = |group, route|
    group.href == route or List.any(group.items, |item| item.href == route)

section_key = |prefix, title|
    if prefix == "" {
        title
    } else {
        "${prefix}/${title}"
    }

@css {
    .nav-items { display: grid; }
    .nav-link, .nav-category {
        display: block;
        text-decoration: none;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .nav-section {
        margin: 0;
    }
    .nav-section + .nav-section { margin-top: 0.28rem; }
    .nav-section summary {
        list-style: none;
        cursor: pointer;
        position: relative;
        z-index: 1;
        padding-right: 1.75rem;
    }
    .nav-section summary::-webkit-details-marker { display: none; }
    .nav-section summary::after {
        position: absolute;
        right: 0.68rem;
        top: 50%;
        width: 0.42rem;
        height: 0.42rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translate(-0.12rem, -50%) rotate(-45deg);
        transition: transform 160ms ease;
    }
    .nav-section[open] > summary::after {
        transform: translate(-0.12rem, -65%) rotate(45deg);
    }
    .nav-section > .nav-fold {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        overflow: hidden;
        transition: grid-template-rows 180ms ease, opacity 180ms ease;
    }
    .nav-section > .nav-fold > .nav-items {
        min-height: 0;
    }
    .nav-section[open] > .nav-fold {
        grid-template-rows: 1fr;
        opacity: 1;
        overflow: visible;
    }
    .nav-section[open] > .nav-fold > .nav-items {
        min-height: min-content;
    }
    @media (prefers-reduced-motion: reduce) {
        .nav-section > .nav-fold { transition: none; }
        .nav-section summary::after { transition: none; }
    }
    .nav-items > .nav-link + .nav-section {
        margin-top: 0.08rem;
        margin-bottom: 0.16rem;
    }
    .nav-fold > .nav-items > .nav-section {
        margin: 0;
    }
    .nav-fold .nav-fold > .nav-items > .nav-link {
        margin-left: 1.4rem;
    }
    .nav-source {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.92em;
    }
}

@component NestedGroupInner = |{ group, route }| {
    <summary class="nav-category">
        @if group.href == "" {
            <span class="nav-link nav-category nav-child">{group.title}</span>
        } @else {
            <a
                class={if group.href == route { "nav-link nav-category nav-child is-current" } else { "nav-link nav-category nav-child" }}
                href={group.href}
            >{group.title}</a>
        }
    </summary>
    <div class="nav-fold">
        <div class="nav-items">
            @for item in group.items {
                <a
                    class={item.class_name}
                    href={item.href}
                    aria-current={if item.href == route { "page" } else { "false" }}
                >{item.title}</a>
            }
        </div>
    </div>
}

@component NavGroupInner = |{ group, route, key_prefix }| {
    <summary class="nav-category">
        @if group.href == "" {
            <span class="nav-link nav-category">{group.title}</span>
        } @else {
            <a
                class={if group.href == route { "nav-link nav-category is-current" } else { "nav-link nav-category" }}
                href={group.href}
            >{group.title}</a>
        }
    </summary>
    <div class="nav-fold">
        <div class="nav-items">
            @for item in group.items {
                <a
                    class={item.class_name}
                    href={item.href}
                    aria-current={if item.href == route { "page" } else { "false" }}
                >{item.title}</a>
            }
            @for child in group.children {
                @if List.is_empty(child.items) {
                    <a
                        class={if child.href == route { "nav-link is-current" } else { "nav-link" }}
                        href={child.href}
                        aria-current={if child.href == route { "page" } else { "false" }}
                    >{child.title}</a>
                } @else if nested_covers(child, route) {
                    <details class="nav-section" data-rocci-nav-section={section_key(key_prefix, child.title)} data-rocci-nav-current="" open>
                        <NestedGroupInner group={child} route={route} />
                    </details>
                } @else if child.open {
                    <details class="nav-section" data-rocci-nav-section={section_key(key_prefix, child.title)} open>
                        <NestedGroupInner group={child} route={route} />
                    </details>
                } @else {
                    <details class="nav-section" data-rocci-nav-section={section_key(key_prefix, child.title)}>
                        <NestedGroupInner group={child} route={route} />
                    </details>
                }
            }
        </div>
    </div>
}

@component NavList = |{ items, route, aria_label }| {
    <nav aria-label={aria_label}>
        <div class="nav-items">
            @for group in items {
                @if is_leaf_group(group) {
                    <a
                        class={if group.href == route { "nav-link is-current" } else { "nav-link" }}
                        href={group.href}
                        aria-current={if group.href == route { "page" } else { "false" }}
                    >{group.title}</a>
                } @else if covers_route(group, route) {
                    <details class="nav-section" data-rocci-nav-section={section_key("", group.title)} data-rocci-nav-current="" open>
                        <NavGroupInner group={group} route={route} key_prefix={group.title} />
                    </details>
                } @else if group.open {
                    <details class="nav-section" data-rocci-nav-section={section_key("", group.title)} open>
                        <NavGroupInner group={group} route={route} key_prefix={group.title} />
                    </details>
                } @else {
                    <details class="nav-section" data-rocci-nav-section={section_key("", group.title)}>
                        <NavGroupInner group={group} route={route} key_prefix={group.title} />
                    </details>
                }
            }
        </div>
    </nav>
}

