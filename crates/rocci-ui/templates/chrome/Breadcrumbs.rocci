import Html

@component Breadcrumbs = |{ breadcrumbs, route }| {
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
            @for crumb in breadcrumbs {
                <li>
                    @if crumb.href == route {
                        <span class="crumb-current" aria-current="page">{crumb.title}</span>
                    } @else {
                        <a href={crumb.href}>{crumb.title}</a>
                    }
                </li>
            }
        </ol>
    </nav>
}
