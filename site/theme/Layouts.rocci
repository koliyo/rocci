import Html
import Breadcrumbs
import Components
import NavList
import PageOutline

@component ArticleFooter = |{ view }| {
    <footer class="article-footer">
        @if view.site.footer != "" {
            <p class="article-footer-text">{view.site.footer}</p>
        }
        <Components.FooterLinks repository={view.site.repository} />
    </footer>
}

@component Home = |{ view }, content| {
    <div class="layout-home" data-route={view.route}>
        <main class="home-main" id="main-content">
            <article class="article">{content}</article>
        </main>
    </div>
}

@component NavigatedFrame = |{ view, show_journey }, content| {
    <div class="layout-navigated">
        <aside class="sidebar" id="site-nav">
            <p class="nav-label">In this section</p>
            <NavList.navList items={view.sidebar} route={view.route} aria_label="In this section" />
        </aside>
        <main class="content-column" id="main-content">
            <Breadcrumbs.breadcrumbs breadcrumbs={view.breadcrumbs} route={view.route} />
            @if !List.is_empty(view.outline) {
                <details class="outline-fallback">
                    <summary>On this page</summary>
                    <PageOutline.pageOutline outline={view.outline} />
                </details>
            }
            <article class="article">{content}</article>
            @if show_journey {
                <nav class="journey" aria-label="Page journey">
                    @if view.previous.href != "" {
                        <a class="journey-prev" href={view.previous.href}>← {view.previous.title}</a>
                    }
                    @if view.next.href != "" {
                        <a class="journey-next" href={view.next.href}>{view.next.title} →</a>
                    }
                </nav>
            }
            <ArticleFooter view={view} />
        </main>
        @if !List.is_empty(view.outline) {
            <PageOutline.pageOutline outline={view.outline} />
        }
    </div>
}

@component Product = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={False}>{content}</NavigatedFrame>
}

@component Section = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={False}>{content}</NavigatedFrame>
}

@component Docs = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={True}>{content}</NavigatedFrame>
}

@component Faq = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={False}>{content}</NavigatedFrame>
}

@component Plain = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={True}>{content}</NavigatedFrame>
}

@component NotFound = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={False}>{content}</NavigatedFrame>
}

@component Playground = |{ view }, content| {
    <div class="layout-playground">
        <main class="playground-main" id="main-content">
            <div class="playground-intro">{content}</div>
            <div
                id="playground-root"
                class="playground-mount"
                data-session={view.resources.playground_session}
            >
                <p class="playground-fallback">Live lowering needs JavaScript and WebAssembly in this browser. HTML preview is not available without a Roc compiler in WASM.</p>
            </div>
        </main>
    </div>
}

@css {
    :scope.layout-navigated {
        position: relative;
        display: grid;
        grid-template-columns: var(--rocci-nav-width, 16rem) minmax(0, 1fr) var(--rocci-outline-width, 14rem);
        gap: 2rem;
        max-width: 86rem;
        min-height: 100%;
        margin: 0 auto;
        padding: 1.5rem 1rem;
    }
    @media (max-width: 64rem) {
        :scope.layout-navigated {
            grid-template-columns: var(--rocci-nav-width, 14rem) minmax(0, 1fr);
        }
        :scope.layout-navigated > .outline {
            display: none;
        }
        .rocci-col-resizer[data-rocci-resize="outline"] { display: none; }
        :scope.layout-navigated .outline-fallback { display: block; }
    }
    @media (max-width: 48rem) {
        :scope.layout-navigated {
            grid-template-columns: minmax(0, 1fr);
        }
        .sidebar {
            display: none;
        }
        .rocci-col-resizer { display: none; }
        :scope.layout-navigated .outline-fallback, :scope.layout-navigated > .outline {
            display: none;
        }
        .mobile-panel .outline {
            display: block;
        }
        .mobile-panel .outline:not(:has(.outline-link)) {
            display: none;
        }
    }
    .layout-home {
        max-width: 54rem;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
    }
    .sidebar {
        position: sticky;
        top: var(--header-height);
        align-self: start;
        height: calc(100vh - var(--header-height));
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding-bottom: 2rem;
        scrollbar-width: thin;
        scrollbar-color: var(--line) transparent;
    }
    .sidebar::-webkit-scrollbar {
        width: 5px;
    }
    .sidebar::-webkit-scrollbar-track {
        background: transparent;
    }
    .sidebar::-webkit-scrollbar-thumb {
        background: var(--line);
        border-radius: 999px;
    }
    .rocci-col-resizer {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 11px;
        max-width: 11px;
        z-index: 5;
        cursor: col-resize;
        touch-action: none;
        background: transparent;
        justify-self: start;
        box-sizing: border-box;
    }
    .rocci-col-resizer[data-rocci-resize="nav"] {
        grid-column: 1 / 2;
        grid-row: 1 / -1;
        left: auto;
        right: -5px;
    }
    .rocci-col-resizer[data-rocci-resize="outline"] {
        grid-column: -2 / -1;
        grid-row: 1 / -1;
        left: -5px;
        right: auto;
    }
    .rocci-col-resizer::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 5px;
        width: 1px;
        background: transparent;
    }
    .rocci-col-resizer:hover::after,
    .rocci-col-resizer:focus-visible::after,
    .rocci-col-resizer.is-active::after { background: var(--accent); }
    .nav-label, .outline-fallback > summary {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .outline-fallback { display: none; margin: 0 0 1.5rem; }
    .layout-navigated > .outline:not(:has(.outline-link)) { display: none; }
    .outline-fallback > summary {
        min-height: 2.75rem;
        cursor: pointer;
    }
    .outline-fallback .outline {
        position: static;
        height: auto;
        overflow: visible;
        padding: 0.5rem 0 1rem;
    }
    .nav-section { margin: 0; }
    .nav-section + .nav-section { margin-top: 0.28rem; }
    .nav-section summary {
        list-style: none;
        cursor: pointer;
        position: relative;
        padding-right: 1.75rem;
    }
    .nav-section summary::-webkit-details-marker { display: none; }
    .nav-section summary::after {
        position: absolute;
        right: 0.68rem;
        top: 50%;
        width: 0.42rem;
        height: 0.42rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translate(-0.12rem, -50%) rotate(-45deg);
        transition: transform 160ms ease;
        color: var(--faint);
    }
    .nav-section[open] > summary::after {
        transform: translate(-0.12rem, -65%) rotate(45deg);
    }
    .nav-link {
        padding: 0.42rem 0.68rem;
        border-radius: 0.45rem;
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.35;
    }
    .nav-link:hover { background: var(--surface); color: var(--ink); }
    .nav-link.is-current {
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 680;
    }
    .nav-category {
        color: var(--ink);
        font-weight: 680;
    }
    .nav-section[open] > summary .nav-category:not(.is-current) {
        color: var(--accent-strong);
    }
    .nav-child {
        margin-left: 0.7rem;
        padding-left: 1rem;
        border-left: 1px solid var(--line);
        border-radius: 0 0.45rem 0.45rem 0;
        font-size: 0.82rem;
    }
    .nav-fold > .nav-items > .nav-section {
        margin: 0;
    }
    .nav-fold .nav-fold > .nav-items > .nav-link {
        margin-left: 1.4rem;
    }
    .outline {
        position: sticky;
        top: 4.5rem;
        height: calc(100vh - 5rem);
        overflow-y: auto;
        font-size: 0.875rem;
    }
    .outline-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--muted);
    }
    .outline-link {
        display: block;
        padding: 0.25rem 0;
        color: var(--muted);
        text-decoration: none;
    }
    .outline-link:hover,
    .outline-link.is-current,
    .outline-link[aria-current="location"] {
        color: var(--accent);
    }
    .outline-link.level-3 {
        padding-left: 0.75rem;
    }
    .breadcrumbs {
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
    }
    .breadcrumbs ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .breadcrumbs li+li::before {
        content: "/";
        margin-right: 0.5rem;
        color: var(--faint);
    }
    .breadcrumbs a {
        color: var(--muted);
        text-decoration: none;
    }
    .breadcrumbs .crumb-current {
        color: inherit;
        font-weight: 500;
    }
    .journey {
        display: flex;
        justify-content: space-between;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
    }
    .journey a {
        text-decoration: none;
        color: var(--accent);
        font-weight: 500;
    }
    .article-footer {
        margin-top: 2.5rem;
        font-size: 0.875rem;
        color: var(--muted);
        text-align: center;
    }
    .article-footer-text { margin: 0; }
    .layout-home .rd-docs-note,
    .layout-home .rd-docs-caution {
        max-width: 36rem;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
    }
    .article-footer .footer-links { margin: .65rem 0 0; }
    .article-footer .footer-link { color: var(--muted); }
    .article-footer .footer-link:hover { color: var(--ink); }
    @media (min-width: 48.01rem) {
        :scope.layout-navigated {
            height: 100%;
            min-height: 0;
            grid-template-rows: minmax(0, 1fr);
        }
        .sidebar {
            position: static;
            top: auto;
            align-self: stretch;
            height: auto;
            max-height: 100%;
            min-height: 0;
        }
        .content-column {
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
        }
        :scope.layout-navigated > .outline {
            position: static;
            top: auto;
            align-self: stretch;
            height: auto;
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
        }
    }
    :scope.layout-playground {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        padding: 0;
    }
    .playground-main {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
    }
    .playground-intro {
        flex: 0 0 auto;
        max-width: 86rem;
        width: 100%;
        margin: 0 auto;
        padding: 1rem 1rem 0.75rem;
    }
    .playground-intro .article > :first-child { margin-top: 0; }
    .playground-intro .article > :last-child { margin-bottom: 0; }
    .playground-mount {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
        border-top: 1px solid var(--line);
    }
    .playground-fallback {
        margin: 1.25rem 1rem;
        color: var(--muted);
    }
}
