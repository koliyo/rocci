import Html
import Breadcrumbs
import NavList
import PageOutline

@component ArticleFooter = |{ view }| {
    @if view.site.footer != "" {
        <footer class="article-footer">{view.site.footer}</footer>
    }
}

@component Home = |{ view }, content| {
    <div class="layout-home">
        <main class="home-main" id="main-content">
            <article class="article">{content}</article>
            <section class="home-recent-news">
                <div class="section-heading">
                    <h2 class="section-title">Latest Updates</h2>
                    <a class="section-more" href="/news/">View all news →</a>
                </div>
                <div class="news-grid">
                    @for item in view.collection_items {
                        <div class="news-item">
                            <time class="news-date">{item.published}</time>
                            <h3 class="news-item-title"><a href={item.route}>{item.title}</a></h3>
                            @if item.summary != "" {
                                <p class="news-item-summary">{item.summary}</p>
                            }
                        </div>
                    }
                </div>
            </section>
            <ArticleFooter view={view} />
        </main>
    </div>
}

@component Product = |{ view }, content| {
    <div class="layout-product">
        <main class="product-main" id="main-content">
            <article class="article">{content}</article>
            <ArticleFooter view={view} />
        </main>
    </div>
}

@component Section = |{ view }, content| {
    <div class="layout-section">
        <main class="section-main" id="main-content">
            <Breadcrumbs.breadcrumbs breadcrumbs={view.breadcrumbs} route={view.route} />
            <article class="article">{content}</article>
        </main>
    </div>
}

@component Docs = |{ view }, content| {
    <div class="layout-docs">
        <aside class="sidebar">
            <NavList.navList items={view.sidebar} route={view.route} aria_label="Documentation navigation" />
        </aside>
        <main class="content-column" id="main-content">
            <Breadcrumbs.breadcrumbs breadcrumbs={view.breadcrumbs} route={view.route} />
            <article class="article">{content}</article>
            <nav class="journey" aria-label="Page journey">
                @if view.previous.href != "" {
                    <a class="journey-prev" href={view.previous.href}>← {view.previous.title}</a>
                }
                @if view.next.href != "" {
                    <a class="journey-next" href={view.next.href}>{view.next.title} →</a>
                }
            </nav>
            <ArticleFooter view={view} />
        </main>
        <PageOutline.pageOutline outline={view.outline} />
    </div>
}

@component NewsIndex = |{ view }, content| {
    <div class="layout-news-index">
        <main class="news-main" id="main-content">
            <article class="article">{content}</article>
            <div class="collection-feed">
                <div class="collection-feed-header">
                    <h2 class="feed-title">All Announcements</h2>
                    <a class="feed-link" href="/news/feed.xml">RSS / Atom Feed ↗</a>
                </div>
                <div class="news-list">
                    @for item in view.collection_items {
                        <article class="news-card">
                            <div class="news-card-meta">
                                <time class="news-date">{item.published}</time>
                            </div>
                            <h2 class="news-card-title"><a href={item.route}>{item.title}</a></h2>
                            @if item.summary != "" {
                                <p class="news-card-summary">{item.summary}</p>
                            }
                        </article>
                    }
                </div>
            </div>
            <ArticleFooter view={view} />
        </main>
    </div>
}

@component NewsPost = |{ view }, content| {
    <div class="layout-news-post">
        <main class="news-post-main" id="main-content">
            <header class="post-header">
                @if view.published != "" {
                    <time class="post-date">{view.published}</time>
                }
            </header>
            <article class="article">{content}</article>
            <div class="post-footer">
                <a class="back-link" href="/news/">← Back to news</a>
            </div>
        </main>
    </div>
}

@component Plain = |{ view }, content| {
    <div class="layout-plain">
        <main class="plain-main" id="main-content">
            <article class="article">{content}</article>
            <ArticleFooter view={view} />
        </main>
    </div>
}

@component NotFound = |{ view }, content| {
    <div class="layout-not-found">
        <main class="not-found-main" id="main-content">
            <article class="article">{content}</article>
            <ArticleFooter view={view} />
        </main>
    </div>
}

@css {
    :scope.layout-docs {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr) 14rem;
        gap: 2rem;
        max-width: 86rem;
        margin: 0 auto;
        padding: 1.5rem 1rem;
    }
    @media (max-width: 64rem) {
        :scope.layout-docs {
            grid-template-columns: 14rem minmax(0, 1fr);
        }
        .outline {
            display: none;
        }
    }
    @media (max-width: 48rem) {
        :scope.layout-docs {
            grid-template-columns: minmax(0, 1fr);
        }
        .sidebar {
            display: none;
        }
        .outline {
            display: none;
        }
        .mobile-panel .outline {
            display: block;
        }
        .mobile-panel .outline:not(:has(.outline-link)) {
            display: none;
        }
    }
    .layout-home, .layout-product, .layout-section, .layout-news-index, .layout-news-post, .layout-plain, .layout-not-found {
        max-width: 54rem;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
    }
    .sidebar {
        position: sticky;
        top: 4.5rem;
        height: calc(100vh - 5rem);
        overflow-y: auto;
    }
    .nav-items { gap: 0.08rem; }
    .nav-link {
        padding: 0.42rem 0.68rem;
        border-radius: 0.45rem;
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.35;
    }
    .nav-link:hover { background: var(--surface); color: var(--ink); }
    .nav-link.is-current {
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 680;
    }
    .nav-category {
        position: relative;
        padding-right: 1.75rem;
        color: var(--ink);
        font-weight: 680;
    }
    .nav-category::after {
        content: "+";
        position: absolute;
        right: 0.68rem;
        color: var(--faint);
        font-weight: 500;
    }
    .nav-category.is-expanded::after { content: "−"; }
    .nav-category.is-expanded:not(.is-current) {
        color: var(--accent-strong);
    }
    .nav-category:not(:first-child) { margin-top: 0.28rem; }
    .nav-child {
        margin-left: 0.7rem;
        padding-left: 1rem;
        border-left: 1px solid var(--line);
        border-radius: 0 0.45rem 0.45rem 0;
        font-size: 0.82rem;
    }
    .outline {
        position: sticky;
        top: 4.5rem;
        height: calc(100vh - 5rem);
        overflow-y: auto;
        font-size: 0.875rem;
    }
    .outline-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--muted);
    }
    .outline-link {
        display: block;
        padding: 0.25rem 0;
        color: var(--muted);
        text-decoration: none;
    }
    .outline-link:hover {
        color: var(--accent);
    }
    .outline-link.level-3 {
        padding-left: 0.75rem;
    }
    .breadcrumbs {
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
    }
    .breadcrumbs ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .breadcrumbs li+li::before {
        content: "/";
        margin-right: 0.5rem;
        color: var(--faint);
    }
    .breadcrumbs a {
        color: var(--muted);
        text-decoration: none;
    }
    .breadcrumbs a.crumb-current {
        color: inherit;
        font-weight: 500;
    }
    .journey {
        display: flex;
        justify-content: space-between;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
    }
    .journey a {
        text-decoration: none;
        color: var(--accent);
        font-weight: 500;
    }
    .article-footer {
        margin-top: 2.5rem;
        font-size: 0.875rem;
        color: var(--muted);
    }
    .post-date {
        font-size: 0.875rem;
        color: var(--muted);
    }
    .post-footer {
        margin-top: 2rem;
    }
    .back-link {
        text-decoration: none;
        color: var(--accent);
        font-weight: 500;
    }
    .home-recent-news, .collection-feed {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
    }
    .section-heading, .collection-feed-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1.5rem;
    }
    .section-title, .feed-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
    }
    .section-more, .feed-link {
        font-size: 0.875rem;
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
    }
    .news-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        gap: 1.25rem;
    }
    .news-item {
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        padding: 1.25rem;
        background: var(--surface);
    }
    .news-item-title {
        font-size: 1.125rem;
        margin: 0.25rem 0 0.5rem;
    }
    .news-item-title a, .news-card-title a {
        text-decoration: none;
        color: inherit;
    }
    .news-item-title a:hover, .news-card-title a:hover {
        color: var(--accent);
    }
    .news-item-summary, .news-card-summary {
        font-size: 0.875rem;
        color: var(--muted);
        margin: 0;
    }
    .news-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .news-card {
        border-bottom: 1px solid var(--line);
        padding-bottom: 1.5rem;
    }
    .news-card-title {
        font-size: 1.35rem;
        margin: 0.25rem 0 0.5rem;
    }
}
