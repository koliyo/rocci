import Html
import Breadcrumbs
import NavList
import PageOutline

@component ArticleFooter = |{ view }| {
    @if view.site.footer != "" {
        <footer class="article-footer">{view.site.footer}</footer>
    }
}

@component Home = |{ view }, content| {
    <div class="layout-home">
        <main class="home-main" id="main-content">
            <article class="article">{content}</article>
            <ArticleFooter view={view} />
        </main>
    </div>
}

@component NavigatedFrame = |{ view, show_journey }, content| {
    <div class="layout-navigated">
        <aside class="sidebar">
            <p class="nav-label">In this section</p>
            <NavList.navList items={view.sidebar} route={view.route} aria_label="In this section" />
        </aside>
        <main class="content-column" id="main-content">
            <Breadcrumbs.breadcrumbs breadcrumbs={view.breadcrumbs} route={view.route} />
            @if !List.is_empty(view.outline) {
                <details class="outline-fallback">
                    <summary>On this page</summary>
                    <PageOutline.pageOutline outline={view.outline} />
                </details>
            }
            <article class="article">{content}</article>
            @if show_journey {
                <nav class="journey" aria-label="Page journey">
                    @if view.previous.href != "" {
                        <a class="journey-prev" href={view.previous.href}>← {view.previous.title}</a>
                    }
                    @if view.next.href != "" {
                        <a class="journey-next" href={view.next.href}>{view.next.title} →</a>
                    }
                </nav>
            }
            <ArticleFooter view={view} />
        </main>
        @if !List.is_empty(view.outline) {
            <PageOutline.pageOutline outline={view.outline} />
        }
    </div>
}

@component Product = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={False}>{content}</NavigatedFrame>
}

@component Section = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={False}>{content}</NavigatedFrame>
}

@component Docs = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={True}>{content}</NavigatedFrame>
}

@component Faq = |{ view }, content| {
    <div class="layout-faq">
        <main class="faq-main" id="main-content">
            <Breadcrumbs.breadcrumbs breadcrumbs={view.breadcrumbs} route={view.route} />
            @if !List.is_empty(view.outline) {
                <details class="faq-contents">
                    <summary>Questions on this page</summary>
                    <PageOutline.pageOutline outline={view.outline} />
                </details>
            }
            <article class="article">{content}</article>
            <ArticleFooter view={view} />
        </main>
    </div>
}

@component Plain = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={True}>{content}</NavigatedFrame>
}

@component NotFound = |{ view }, content| {
    <NavigatedFrame view={view} show_journey={False}>{content}</NavigatedFrame>
}

@css {
    :scope.layout-navigated {
        display: grid;
        grid-template-columns: 16rem minmax(0, 1fr) 14rem;
        gap: 2rem;
        max-width: 86rem;
        margin: 0 auto;
        padding: 1.5rem 1rem;
    }
    @media (max-width: 64rem) {
        :scope.layout-navigated {
            grid-template-columns: 14rem minmax(0, 1fr);
        }
        :scope.layout-navigated > .outline {
            display: none;
        }
        :scope.layout-navigated .outline-fallback { display: block; }
    }
    @media (max-width: 48rem) {
        :scope.layout-navigated {
            grid-template-columns: minmax(0, 1fr);
        }
        .sidebar {
            display: none;
        }
        :scope.layout-navigated .outline-fallback, :scope.layout-navigated > .outline {
            display: none;
        }
        .mobile-panel .outline {
            display: block;
        }
        .mobile-panel .outline:not(:has(.outline-link)) {
            display: none;
        }
    }
    .layout-home, .layout-faq {
        max-width: 54rem;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
    }
    .sidebar {
        position: sticky;
        top: 4.5rem;
        height: calc(100vh - 5rem);
        overflow-y: auto;
    }
    .nav-label, .outline-fallback > summary, .faq-contents > summary {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .outline-fallback { display: none; margin: 0 0 1.5rem; }
    .layout-navigated > .outline:not(:has(.outline-link)) { display: none; }
    .outline-fallback > summary, .faq-contents > summary {
        min-height: 2.75rem;
        cursor: pointer;
    }
    .outline-fallback .outline, .faq-contents .outline {
        position: static;
        height: auto;
        overflow: visible;
        padding: 0.5rem 0 1rem;
    }
    .faq-contents { margin: 0 0 1.5rem; }
    .nav-section { margin: 0; }
    .nav-section + .nav-section { margin-top: 0.28rem; }
    .nav-section summary {
        list-style: none;
        cursor: pointer;
        position: relative;
        padding-right: 1.75rem;
    }
    .nav-section summary::-webkit-details-marker { display: none; }
    .nav-section summary::after {
        content: "+";
        position: absolute;
        right: 0.68rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--faint);
        font-weight: 500;
    }
    .nav-section[open] > summary::after { content: "−"; }
    .nav-link {
        padding: 0.42rem 0.68rem;
        border-radius: 0.45rem;
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.35;
    }
    .nav-link:hover { background: var(--surface); color: var(--ink); }
    .nav-link.is-current {
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 680;
    }
    .nav-category {
        color: var(--ink);
        font-weight: 680;
    }
    .nav-section[open] > summary .nav-category:not(.is-current) {
        color: var(--accent-strong);
    }
    .nav-child {
        margin-left: 0.7rem;
        padding-left: 1rem;
        border-left: 1px solid var(--line);
        border-radius: 0 0.45rem 0.45rem 0;
        font-size: 0.82rem;
    }
    .outline {
        position: sticky;
        top: 4.5rem;
        height: calc(100vh - 5rem);
        overflow-y: auto;
        font-size: 0.875rem;
    }
    .outline-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--muted);
    }
    .outline-link {
        display: block;
        padding: 0.25rem 0;
        color: var(--muted);
        text-decoration: none;
    }
    .outline-link:hover {
        color: var(--accent);
    }
    .outline-link.level-3 {
        padding-left: 0.75rem;
    }
    .breadcrumbs {
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
    }
    .breadcrumbs ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .breadcrumbs li+li::before {
        content: "/";
        margin-right: 0.5rem;
        color: var(--faint);
    }
    .breadcrumbs a {
        color: var(--muted);
        text-decoration: none;
    }
    .breadcrumbs .crumb-current {
        color: inherit;
        font-weight: 500;
    }
    .journey {
        display: flex;
        justify-content: space-between;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
    }
    .journey a {
        text-decoration: none;
        color: var(--accent);
        font-weight: 500;
    }
    .article-footer {
        margin-top: 2.5rem;
        font-size: 0.875rem;
        color: var(--muted);
    }
}
