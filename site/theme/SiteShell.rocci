import Html
import Layouts
import NavList
import PageOutline

@component SiteShell = |view, content| {
    <html lang={view.site.language}>
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <meta name="color-scheme" content="light dark" />
            <meta http-equiv="Content-Security-Policy" content={view.resources.csp} />
            <title>{view.title} · {view.site.title}</title>
            <link rel="stylesheet" href={view.resources.stylesheet} />
            @if view.description != "" {
                <meta name="description" content={view.description} />
            } @else if view.site.description != "" {
                <meta name="description" content={view.site.description} />
            }
            @if view.resources.canonical != "" {
                <link rel="canonical" href={view.resources.canonical} />
                <meta property="og:url" content={view.resources.canonical} />
            }
            @if view.resources.module_script != "" {
                <script type="module" src={view.resources.module_script}></script>
            }
            @if view.resources.chrome_script != "" {
                <script src={view.resources.chrome_script} defer></script>
            }
            <meta property="og:type" content="website" />
            <meta property="og:title" content={view.title} />
            <meta property="og:site_name" content={view.site.title} />
            @if view.description != "" {
                <meta property="og:description" content={view.description} />
            }
            @if view.site.social_image != "" {
                <meta property="og:image" content={"${view.site.base_url}${view.site.social_image}"} />
                <meta name="twitter:card" content="summary_large_image" />
            }
            @if view.site.favicon != "" {
                <link rel="icon" href={view.site.favicon} type="image/svg+xml" />
            }
            @if view.site.apple_touch_icon != "" {
                <link rel="apple-touch-icon" href={view.site.apple_touch_icon} />
            }
            <link rel="alternate" type="application/atom+xml" title={"${view.site.title} News"} href="/news/feed.xml" />
        </head>
        <body>
            <a class="skip-link" href="#main-content">Skip to content</a>
            <header class="site-header">
                <div class="header-inner">
                    <a class="brand" href="/" aria-label={"${view.site.title} home"}>
                        @if view.site.favicon != "" {
                            <span class="brand-mark" aria-hidden="true">
                                <img src={view.site.favicon} alt="" width="28" height="28" />
                            </span>
                        }
                        <span>{view.site.title}</span>
                    </a>
                    @if view.site.subtitle != "" {
                        <span class="header-rule" aria-hidden="true"></span>
                        <span class="header-subtitle">{view.site.subtitle}</span>
                    }
                    <nav class="lanes" aria-label="Sections">
                        @if !List.is_empty(view.lanes) {
                            @for lane in view.lanes {
                                <a
                                    class={if lane.current { "lane-link is-current" } else { "lane-link" }}
                                    href={lane.href}
                                    aria-current={if lane.current { "true" } else { "false" }}
                                >{lane.label}</a>
                            }
                        }
                    </nav>
                    <div class="header-actions">
                        <button type="button" class="goto-open" data-rocci-goto-open aria-label="Go to page">Go to</button>
                        @if view.site.repository != "" {
                            <a class="header-link" href={view.site.repository}>Source ↗</a>
                        }
                    </div>
                    <details class="mobile-menu">
                        <summary>Menu</summary>
                        <div class="mobile-panel">
                            <nav class="mobile-lanes" aria-label="Sections">
                                @if !List.is_empty(view.lanes) {
                                    @for lane in view.lanes {
                                        <a
                                            class={if lane.current { "lane-link is-current" } else { "lane-link" }}
                                            href={lane.href}
                                            aria-current={if lane.current { "true" } else { "false" }}
                                        >{lane.label}</a>
                                    }
                                }
                            </nav>
                            @match view.layout {
                                "home" => <></>
                                "product" => <></>
                                "section" => <></>
                                "news-index" => <></>
                                "news-post" => <></>
                                "plain" => <></>
                                "not-found" => <></>
                                _ => <>
                                    <NavList.navList items={view.sidebar} route={view.route} aria_label="Documentation navigation" />
                                    <PageOutline.pageOutline outline={view.outline} />
                                </>
                            }
                        </div>
                    </details>
                </div>
            </header>
            <div class="site-container">
                @match view.layout {
                    "home" => <Layouts.Home view={view}>{content}</Layouts.Home>
                    "product" => <Layouts.Product view={view}>{content}</Layouts.Product>
                    "section" => <Layouts.Section view={view}>{content}</Layouts.Section>
                    "news-index" => <Layouts.NewsIndex view={view}>{content}</Layouts.NewsIndex>
                    "news-post" => <Layouts.NewsPost view={view}>{content}</Layouts.NewsPost>
                    "plain" => <Layouts.Plain view={view}>{content}</Layouts.Plain>
                    "not-found" => <Layouts.NotFound view={view}>{content}</Layouts.NotFound>
                    _ => <Layouts.Docs view={view}>{content}</Layouts.Docs>
                }
            </div>
            <footer class="site-footer">
                <div class="footer-inner">
                    <p class="footer-text">{view.site.footer}</p>
                </div>
            </footer>
        </body>
    </html>
}

@css {
    .skip-link {
        position: absolute;
        top: -3rem;
        left: 1rem;
        background: var(--accent);
        color: #ffffff;
        padding: 0.5rem 1rem;
        border-radius: 0.25rem;
        z-index: 100;
        transition: top 0.1s ease;
    }
    .skip-link:focus {
        top: 1rem;
    }
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        height: var(--header-height);
        background: color-mix(in srgb, var(--canvas) 92%, transparent);
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(14px);
    }
    .header-inner {
        max-width: 86rem;
        height: 100%;
        margin: 0 auto;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
        color: inherit;
    }
    .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        flex-shrink: 0;
    }
    .brand-mark img {
        display: block;
        width: 1.75rem;
        height: 1.75rem;
    }
    .header-rule {
        width: 1px;
        height: 1.25rem;
        background: var(--line);
    }
    .header-subtitle {
        font-size: 0.875rem;
        color: var(--muted);
    }
    .lanes {
        display: flex;
        gap: 1rem;
        margin-left: auto;
    }
    .lane-link {
        text-decoration: none;
        color: var(--muted);
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
    }
    .lane-link:hover, .lane-link.is-current {
        color: var(--ink);
    }
    .lane-link.is-current {
        background: var(--accent-soft);
        color: var(--accent-strong);
    }
    .header-actions {
        display: flex;
        align-items: center;
    }
    .header-link {
        text-decoration: none;
        color: var(--muted);
        font-size: 0.875rem;
    }
    .goto-open {
        margin-right: 0.75rem;
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        padding: 0.25rem 0.65rem;
        border: 1px solid var(--line);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--muted);
        font: inherit;
        font-size: 0.8125rem;
        font-weight: 650;
        cursor: pointer;
    }
    .goto-open:hover {
        color: var(--ink);
    }
    .mobile-menu { display: none; }
    @media (max-width: 48rem) {
        .header-inner { gap: 0.75rem; }
        .header-rule, .header-subtitle, .header-link, .lanes { display: none; }
        .goto-open { min-height: 2.75rem; }
        .mobile-menu { position: relative; display: block; margin-left: auto; }
        .mobile-menu summary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2.75rem;
            min-width: 2.75rem;
            padding: 0 0.85rem;
            border: 1px solid var(--line);
            border-radius: 0.5rem;
            background: var(--surface);
            color: var(--muted);
            font-size: 0.82rem;
            font-weight: 680;
            cursor: pointer;
            list-style: none;
        }
        .mobile-menu summary::-webkit-details-marker { display: none; }
        .mobile-panel { display: none; }
        .mobile-menu[open] .mobile-panel { display: block; }
        .mobile-panel {
            position: fixed;
            top: var(--header-height);
            right: 0;
            left: 0;
            z-index: 40;
            max-height: calc(100vh - var(--header-height));
            padding: 1.3rem 1rem 2rem;
            overflow-y: auto;
            border-bottom: 1px solid var(--line);
            background: var(--canvas);
            box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.18);
        }
        .mobile-lanes {
            display: grid;
            gap: 0.15rem;
            margin: 0 0 1.15rem;
        }
        .mobile-panel .lane-link {
            display: flex;
            align-items: center;
            min-height: 2.75rem;
            padding: 0 0.7rem;
        }
        .mobile-panel .nav-link {
            min-height: 2.75rem;
            display: flex;
            align-items: center;
        }
        .mobile-panel .outline {
            position: static;
            height: auto;
            overflow: visible;
            margin-top: 1.25rem;
        }
        .mobile-panel .outline:not(:has(.outline-link)) { display: none; }
    }
    @media print {
        .mobile-menu { display: none; }
    }
    .site-footer {
        border-top: 1px solid var(--line);
        padding: 2rem 1rem;
        margin-top: 4rem;
        background: var(--surface);
    }
    .footer-inner {
        max-width: 86rem;
        margin: 0 auto;
        text-align: center;
    }
    .footer-text {
        font-size: 0.875rem;
        color: var(--muted);
        margin: 0;
    }
}
