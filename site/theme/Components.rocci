import Html

@component GithubIcon = |{}| {
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.53-.49-.45-1.18-1.11-1.49-1.11-1.49-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0.84-.27 2.75 1.02 4.16-.2.55-.27 1.14-.27 1.73 0 1.26 1.08 2.2 2.42 2.2.78 0 1.52-.29 2.06-.8a7.87 7.87 0 01-2.6.39c-1.95 0-2.67-1.21-2.67-1.21-.54-1.37-1.35-1.95-1.35-1.95-.11-.25-.03-.55.17-.73 0 0 1.19.14 1.91.92.54-.18 1.1-.27 1.67-.27.56 0 1.12.09 1.66.27.72-.78 1.9-.92 1.9-.92.2.18.24.48.14.73 0 0-.82.58-1.35 1.95-.54 1.37-2.14 1.65-2.67 1.65-.53 0-1.02-.07-1.47-.2 1.25.77 1.96 1.91 1.96 3.47 0 2.49-2.02 4.48-4.53 4.92.39.32.73.95.73 1.96 0 1.42-.01 2.57-.01 2.93 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        />
    </svg>
}

@component GithubLink = |{ href }| {
    <a class="header-icon-link" href={href} aria-label="GitHub repository">
        <GithubIcon />
    </a>
}

@component ExperimentalBanner = |{}| {
    <div class="experimental-banner" role="status">
        <p class="experimental-banner-text">
            <strong>Highly experimental software.</strong>
            For testing only — not for production use.
        </p>
    </div>
}

@component SiteFooter = |{ footer, repository }| {
    <footer class="site-footer">
        <div class="footer-inner">
            @if footer != "" {
                <p class="footer-text">{footer}</p>
            }
            @if repository != "" {
                <p class="footer-links">
                    <a class="footer-github-link" href={repository}>
                        <GithubIcon />
                        <span>GitHub</span>
                    </a>
                </p>
            }
        </div>
    </footer>
}

@component CardInner = |{ title, description, tag }| {
    <>
        <div class="rd-card-header">
            <span class="rd-card-title">{title}</span>
            @if tag != "" {
                <span class="rd-card-tag">{tag}</span>
            }
        </div>
        @if description != "" {
            <p class="rd-card-desc">{description}</p>
        }
    </>
}

@component Card = |{ title, href ?? "", description ?? "", tag ?? "" }| {
    <div class="rd-card">
        @if href != "" {
            <a class="rd-card-link" href={href}>
                <CardInner title={title} description={description} tag={tag} />
            </a>
        } @else {
            <CardInner title={title} description={description} tag={tag} />
        }
    </div>
}

@component CardGrid = |{}, content| {
    <div class="rd-card-grid">
        {content}
    </div>
}

@component Hero = |{ title, subtitle ?? "", cta_label ?? "", cta_href ?? "" }| {
    <section class="rd-hero">
        <h1 class="rd-hero-title">{title}</h1>
        @if subtitle != "" {
            <p class="rd-hero-subtitle">{subtitle}</p>
        }
        @if cta_label != "" {
            @if cta_href != "" {
                <div class="rd-hero-actions">
                    <a class="rd-btn primary" href={cta_href}>{cta_label}</a>
                </div>
            }
        }
    </section>
}

@component Badge = |{ label, tone ?? "neutral" }| {
    <span class={"rd-badge tone-${tone}"}>{label}</span>
}

@css {
    .header-icon-link {
        display: inline-flex;
        min-height: 2.25rem;
        min-width: 2.25rem;
        align-items: center;
        justify-content: center;
        padding: .35rem;
        border: 1px solid var(--line);
        border-radius: .55rem;
        background: var(--surface);
        color: var(--muted);
        text-decoration: none;
    }
    .header-icon-link:hover {
        border-color: var(--line-strong);
        color: var(--ink);
    }
    .header-icon-link svg {
        width: 1.1rem;
        height: 1.1rem;
    }
    .experimental-banner {
        border-bottom: 1px solid color-mix(in srgb, #d19a66 45%, var(--line));
        background: color-mix(in srgb, #d19a66 14%, var(--surface));
        padding: 1.1rem 1.5rem;
        text-align: center;
    }
    .experimental-banner-text {
        margin: 0;
        color: var(--ink);
        font-size: 1.05rem;
        line-height: 1.45;
    }
    .experimental-banner-text strong {
        font-size: 1.15rem;
        font-weight: 800;
    }
    .footer-links {
        margin: .75rem 0 0;
    }
    .footer-github-link {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--muted);
        font-size: .875rem;
        font-weight: 650;
        text-decoration: none;
    }
    .footer-github-link:hover {
        color: var(--ink);
    }
    .footer-github-link svg {
        width: 1rem;
        height: 1rem;
    }
    .rd-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        gap: 1.25rem;
        margin: 1.5rem 0;
    }
    .rd-card {
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        padding: 1.25rem;
        background: var(--surface);
        transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .rd-card:hover {
        border-color: var(--accent);
        transform: translateY(-1px);
    }
    @media (prefers-reduced-motion: reduce) {
        .rd-card { transition: none; }
        .rd-card:hover { transform: none; }
    }
    .rd-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .rd-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }
    .rd-card-title {
        font-weight: 600;
        font-size: 1.125rem;
    }
    .rd-card-tag {
        font-size: 0.75rem;
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        background: var(--surface-raised);
        color: var(--muted);
    }
    .rd-card-desc {
        color: var(--muted);
        font-size: 0.875rem;
        line-height: 1.4;
        margin: 0;
    }
    .rd-hero {
        padding: 3rem 0 2rem;
        text-align: center;
    }
    .rd-hero-title {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.15;
        margin-bottom: 1rem;
    }
    .rd-hero-subtitle {
        font-size: 1.25rem;
        color: var(--muted);
        max-width: 42rem;
        margin: 0 auto 1.5rem;
    }
    .rd-btn {
        display: inline-block;
        padding: 0.625rem 1.25rem;
        border-radius: 0.375rem;
        font-weight: 500;
        text-decoration: none;
    }
    .rd-btn.primary {
        background: var(--accent);
        color: #ffffff;
    }
    .rd-badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
    }
}
