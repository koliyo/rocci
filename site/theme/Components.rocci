import Html

@component GithubIcon = |{}| {
    <svg viewBox="0 0 98 96" width="16" height="16" aria-hidden="true">
        <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 8.456 11.404 6.017 14.235 4.585.44-3.55 1.686-6.017 3.074-7.412-10.807-1.226-22.168-5.226-22.168-23.4 0-5.176 1.885-9.39 4.948-12.685-.48-1.226-2.163-6.275.48-13.06 0 0 4.023-1.304 13.15 4.944 3.757-1.06 7.798-1.59 11.882-1.59 4.085 0 8.126.529 11.884 1.59 9.126-6.248 13.147-4.944 13.147-4.944 2.644 6.785.97 11.834.48 13.06 3.066 3.296 4.947 7.51 4.947 12.684 0 18.26-11.404 22.13-22.27 23.293 1.778 1.548 3.316 4.481 3.316 9.126 0 6.585-.08 11.879-.08 13.646 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"
        />
    </svg>
}

@component GithubLink = |{ href }| {
    <a class="header-icon-link" href={href} aria-label="GitHub repository">
        <GithubIcon />
    </a>
}

@component ExperimentalBanner = |{}| {
    <div class="experimental-banner" role="status">
        <p class="experimental-banner-text">
            <strong>Highly experimental software.</strong>
            For testing only — not for production use.
        </p>
    </div>
}

@component SiteFooter = |{ footer, repository }| {
    <footer class="site-footer">
        <div class="footer-inner">
            @if footer != "" {
                <p class="footer-text">{footer}</p>
            }
            @if repository != "" {
                <p class="footer-links">
                    <a class="footer-github-link" href={repository}>
                        <GithubIcon />
                        <span>GitHub</span>
                    </a>
                </p>
            }
        </div>
    </footer>
}

@component CardInner = |{ title, description, tag }| {
    <>
        <div class="rd-card-header">
            <span class="rd-card-title">{title}</span>
            @if tag != "" {
                <span class="rd-card-tag">{tag}</span>
            }
        </div>
        @if description != "" {
            <p class="rd-card-desc">{description}</p>
        }
    </>
}

@component Card = |{ title, href ?? "", description ?? "", tag ?? "" }| {
    <div class="rd-card">
        @if href != "" {
            <a class="rd-card-link" href={href}>
                <CardInner title={title} description={description} tag={tag} />
            </a>
        } @else {
            <CardInner title={title} description={description} tag={tag} />
        }
    </div>
}

@component CardGrid = |{}, content| {
    <div class="rd-card-grid">
        {content}
    </div>
}

@component Hero = |{ title, subtitle ?? "", cta_label ?? "", cta_href ?? "" }| {
    <section class="rd-hero">
        <h1 class="rd-hero-title">{title}</h1>
        @if subtitle != "" {
            <p class="rd-hero-subtitle">{subtitle}</p>
        }
        @if cta_label != "" {
            @if cta_href != "" {
                <div class="rd-hero-actions">
                    <a class="rd-btn primary" href={cta_href}>{cta_label}</a>
                </div>
            }
        }
    </section>
}

@component Badge = |{ label, tone ?? "neutral" }| {
    <span class={"rd-badge tone-${tone}"}>{label}</span>
}

@css {
    .header-icon-link {
        display: inline-flex;
        min-height: 2.25rem;
        min-width: 2.25rem;
        align-items: center;
        justify-content: center;
        color: var(--ink);
        text-decoration: none;
    }
    .header-icon-link:hover {
        color: var(--accent-strong);
    }
    .header-icon-link svg {
        width: 1.25rem;
        height: 1.25rem;
    }
    .experimental-banner {
        border-bottom: 1px solid color-mix(in srgb, #d19a66 45%, var(--line));
        background: color-mix(in srgb, #d19a66 14%, var(--surface));
        padding: 1.1rem 1.5rem;
        text-align: center;
    }
    .experimental-banner-text {
        margin: 0;
        color: var(--ink);
        font-size: 1.05rem;
        line-height: 1.45;
    }
    .experimental-banner-text strong {
        font-size: 1.15rem;
        font-weight: 800;
    }
    .footer-links {
        margin: .75rem 0 0;
        text-align: center;
    }
    .footer-github-link {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--muted);
        font-size: .875rem;
        font-weight: 650;
        text-decoration: none;
    }
    .footer-github-link:hover {
        color: var(--ink);
    }
    .footer-github-link svg {
        width: 1rem;
        height: 1rem;
    }
    .rd-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        gap: 1.25rem;
        margin: 1.5rem 0;
    }
    .rd-card {
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        padding: 1.25rem;
        background: var(--surface);
        transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .rd-card:hover {
        border-color: var(--accent);
        transform: translateY(-1px);
    }
    @media (prefers-reduced-motion: reduce) {
        .rd-card { transition: none; }
        .rd-card:hover { transform: none; }
    }
    .rd-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .rd-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }
    .rd-card-title {
        font-weight: 600;
        font-size: 1.125rem;
    }
    .rd-card-tag {
        font-size: 0.75rem;
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        background: var(--surface-raised);
        color: var(--muted);
    }
    .rd-card-desc {
        color: var(--muted);
        font-size: 0.875rem;
        line-height: 1.4;
        margin: 0;
    }
    .rd-hero {
        padding: 3rem 0 2rem;
        text-align: center;
    }
    .rd-hero-title {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.15;
        margin-bottom: 1rem;
    }
    .rd-hero-subtitle {
        font-size: 1.25rem;
        color: var(--muted);
        max-width: 42rem;
        margin: 0 auto 1.5rem;
    }
    .rd-btn {
        display: inline-block;
        padding: 0.625rem 1.25rem;
        border-radius: 0.375rem;
        font-weight: 500;
        text-decoration: none;
    }
    .rd-btn.primary {
        background: var(--accent);
        color: #ffffff;
    }
    .rd-badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.125rem 0.5rem;
        border-radius: 0.25rem;
    }
}
