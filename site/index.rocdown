@page {
    layout: "home",
    meta: {
        title: "Rocci · Roc-native interfaces & Markdown-first documents",
        description: "Build Roc-native interfaces, Markdown-first documents, and lightweight desktop apps with functional purity and the open web platform.",
    },
}

@roc {
import pf.Env
import pf.Path
import pf.Sqlite
import Origin

clicks_ddl = "id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL, tz TEXT NOT NULL, country TEXT NOT NULL, city TEXT NOT NULL, region TEXT NOT NULL"

ensure_clicks! = |db| {
    create = "CREATE TABLE IF NOT EXISTS clicks (${clicks_ddl})"
    Sqlite.execute!({ db, query: create, params: {} })?
    row : { sql : Str }
    row = Sqlite.query!(
        {
            db,
            query: "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'clicks'",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    if Str.contains(row.sql, clicks_ddl) {
        Ok({})
    } else {
        Sqlite.execute!({ db, query: "DROP TABLE IF EXISTS clicks", params: {} })?
        Sqlite.execute!({ db, query: create, params: {} })?
        Ok({})
    }
}
}

@context { db : Sqlite.Db }

@init {
    db_path =
        match Env.var!("DB_PATH") {
            Ok(path) => Path.from_os_str(path)
            Err(_) => Path.utf8("./counter.db")
        }
    db = Sqlite.open!(Sqlite.default_config(db_path))?
    Sqlite.execute!(
        {
            db,
            query: "CREATE TABLE IF NOT EXISTS counter (id INTEGER PRIMARY KEY, value INTEGER NOT NULL)",
            params: {},
        },
    )?
    Sqlite.execute!(
        {
            db,
            query: "INSERT OR IGNORE INTO counter (id, value) VALUES (1, 0)",
            params: {},
        },
    )?
    ensure_clicks!(db)?
    { db: db }
}

@patch("/actions/counter/sync") = |{ db }, request| {
    _ = request
    now_row : { now : I64 }
    now_row = Sqlite.query!(
        {
            db,
            query: "SELECT CAST(strftime('%s', 'now') AS INTEGER) AS now",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    count_row : { value : I64 }
    count_row = Sqlite.query!(
        {
            db,
            query: "SELECT value FROM counter WHERE id = 1",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    rows : List({ ts : I64, tz : Str, country : Str, city : Str, region : Str })
    rows = Sqlite.query_many!(
        {
            db,
            query: "SELECT ts, tz, country, city, region FROM clicks ORDER BY id DESC LIMIT 20",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    clicks = List.map(
        rows,
        |row| {
            mapped = Origin.lookup(row.tz)
            {
                flag: mapped.flag,
                place: Origin.place_label({
                    country: row.country,
                    city: row.city,
                    region: row.region,
                    flag: mapped.flag,
                }),
                ago: Origin.relative_ago(now_row.now, row.ts),
                ts: row.ts.to_str(),
            }
        },
    )
    counterLive({ count: count_row.value, clicks })
}

@patch("/actions/counter/increment") = |{ db }, request| {
    body =
        match request.body().with_limit(8 * 1024).read_all!() {
            Ok(bytes) => Str.from_utf8_lossy(bytes)
            Err(_) => ""
        }
    tz_raw = Origin.signal_str(body, "tz")
    tz = if tz_raw == "" { "UTC" } else { tz_raw }
    place = Origin.lookup(tz)
    now_row : { now : I64 }
    now_row = Sqlite.query!(
        {
            db,
            query: "SELECT CAST(strftime('%s', 'now') AS INTEGER) AS now",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    now = now_row.now
    Sqlite.execute!(
        {
            db,
            query: "INSERT INTO clicks (ts, tz, country, city, region) VALUES (:ts, :tz, :country, :city, :region)",
            params: {
                ts: now,
                tz: tz,
                country: place.country,
                city: place.city,
                region: place.region,
            },
        },
    )?
    Sqlite.execute!(
        {
            db,
            query: "DELETE FROM clicks WHERE id NOT IN (SELECT id FROM clicks ORDER BY id DESC LIMIT 20)",
            params: {},
        },
    )?
    Sqlite.execute!(
        {
            db,
            query: "UPDATE counter SET value = value + 1 WHERE id = 1",
            params: {},
        },
    )?
    count_row : { value : I64 }
    count_row = Sqlite.query!(
        {
            db,
            query: "SELECT value FROM counter WHERE id = 1",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    rows : List({ ts : I64, tz : Str, country : Str, city : Str, region : Str })
    rows = Sqlite.query_many!(
        {
            db,
            query: "SELECT ts, tz, country, city, region FROM clicks ORDER BY id DESC LIMIT 20",
            params: {},
            limits: Sqlite.default_query_limits,
        },
    )?
    clicks = List.map(
        rows,
        |row| {
            mapped = Origin.lookup(row.tz)
            {
                flag: mapped.flag,
                place: Origin.place_label({
                    country: row.country,
                    city: row.city,
                    region: row.region,
                    flag: mapped.flag,
                }),
                ago: Origin.relative_ago(now, row.ts),
                ts: row.ts.to_str(),
            }
        },
    )
    counterLive({ count: count_row.value, clicks })
}

@component
CounterPanel = |{ count }| {
    @css {
        .eyebrow {
            margin: 0 0 0.35rem;
            color: var(--accent);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        output {
            display: block;
            color: var(--ink);
            font-family: ui-monospace, monospace;
            font-size: 3.5rem;
            font-weight: 650;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.04em;
        }
    }
    <div id="counter-panel">
        <p class="eyebrow">Live shared count</p>
        <output>{count.to_str()}</output>
    </div>
}

@component
CounterFeed = |{ clicks }| {
    @css {
        .feed {
            margin: 1.35rem 0 0;
            padding: 0;
            list-style: none;
        }
        .feed li {
            display: grid;
            grid-template-columns: auto 1fr auto;
            gap: 0.65rem 0.85rem;
            align-items: baseline;
            padding: 0.55rem 0;
            border-top: 1px solid var(--line);
            font-size: 0.92rem;
        }
        .feed .flag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 2rem;
            padding: 0.15rem 0.35rem;
            border-radius: 6px;
            background: var(--canvas);
            border: 1px solid var(--line);
            color: var(--ink);
            font-family: ui-monospace, monospace;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.04em;
        }
        .feed .where {
            color: var(--ink);
            font-size: 0.92rem;
        }
        .feed time {
            color: var(--muted);
            font-size: 0.8rem;
            white-space: nowrap;
        }
        .empty {
            margin: 1.35rem 0 0;
            color: var(--muted);
            font-size: 0.9rem;
        }
    }
    <div id="counter-feed">
        @if List.is_empty(clicks) {
            <p class="empty">No clicks yet - be the first visitor.</p>
        } @else {
            <ul class="feed" aria-label="Recent increments">
                @for click in clicks {
                    <li>
                        <span class="flag" aria-hidden="true">{click.flag}</span>
                        <div class="where">{click.place}</div>
                        <time datetime={click.ts}>{click.ago}</time>
                    </li>
                }
            </ul>
        }
    </div>
}

@component
CounterLive = |{ count, clicks }|
    <>
        <CounterPanel count={count} />
        <CounterFeed clicks={clicks} />
    </>

@component
CounterCard = |{ count, clicks }| {
    @css {
        section {
            margin: 1.25rem 0 0;
            padding: 1.15rem 1.25rem;
            border: 1px solid var(--line);
            border-radius: 16px;
            background: var(--surface);
        }
        .actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 1.25rem;
        }
        button {
            appearance: none;
            border: 0;
            border-radius: 10px;
            padding: 0.7rem 1rem;
            background: var(--accent);
            color: var(--canvas);
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }
        .privacy {
            margin: 1rem 0 0;
            color: var(--muted);
            font-size: 0.8rem;
            line-height: 1.45;
        }
    }
    <section id="counter" class="counter-card">
        <div
            data-signals="{tz: ''}"
            data-init="$tz = Intl.DateTimeFormat().resolvedOptions().timeZone; @post('/actions/counter/sync')"
        ></div>
        <CounterPanel count={count} />
        <div class="actions">
            <button type="button" data-on:click=@post("/actions/counter/increment")>
                Increment
            </button>
        </div>
        <CounterFeed clicks={clicks} />
        <p class="privacy">
            Origin comes from your browser timezone - no IP address is stored.
        </p>
    </section>
}

# Roc-native interfaces and Markdown-first documents

Rocci connects Roc's compile-time guarantees with ordinary HTML, CSS, and a small desktop host. This site is the working tree for public docs: add pages under `site/`, keep chrome in `site/theme/`, and preview with `rocdown run site`.

:card-grid.begin
    :link-card[page: "docs/start/what-is-rocci", title: "Getting started", summary: "Install from source and preview a first Rocci component."]
    :link-card[page: "rocdown/index", title: "Rocdown", summary: "Markdown-first documents and static sites."]
    :link-card[page: "news/index", title: "News", summary: "Announcements and project updates."]
    :link-card[page: "project/index", title: "Project", summary: "Status, roadmap, and how to contribute."]
:card-grid.end

## Try a live island

The card below is CDN HTML plus a SQLite-backed Rocci island: shared count, last twenty clicks, and origin from your IANA timezone. The same pattern lives in `examples/rocdown/counter`.

@render CounterCard({ count: 0.I64, clicks: [] })

```rocci
@patch("/actions/counter/increment") = |{ db }, request| {
    # read tz signal, insert click, morph #counter-panel and #counter-feed
    counterLive({ count, clicks })
}
```

See [Rocci in five minutes](/docs/start/five-minutes/) to run a component locally, or [Publish a hybrid Rocdown site](/docs/guides/hybrid-sites/) for CDN plus `serve-islands`.
