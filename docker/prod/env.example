# Production (default when ROCCI_LANE=production)
ROCCI_LANE=production
ROCCI_DIST=/srv/rocci/current/dist
ROCCI_ISLANDS_CONTEXT=/srv/rocci/current/islands-context
ROCCI_HTTP_PORT=8080
COMPOSE_PROJECT_NAME=rocci-prod
ROCCI_IMAGE_TAG=prod
ROCCI_PUBLISH_LIVE=0

# Staging — use a copy at /srv/rocci-staging/.env:
# ROCCI_LANE=staging
# ROCCI_DIST=/srv/rocci-staging/current/dist
# ROCCI_ISLANDS_CONTEXT=/srv/rocci-staging/current/islands-context
# ROCCI_HTTP_PORT=8081
# COMPOSE_PROJECT_NAME=rocci-staging
# ROCCI_IMAGE_TAG=staging
# ROCCI_PUBLISH_LIVE=1
