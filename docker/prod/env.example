# Absolute CDN tree (unpacked site.tgz / dist/rocci.dev).
ROCCI_DIST=/srv/rocci/current/dist

# Directory that contains Dockerfile + the musl `islands` binary.
ROCCI_ISLANDS_CONTEXT=/srv/rocci/current/islands-context

# Host port cloudflared forwards to (Compose publishes this to Caddy :80).
ROCCI_HTTP_PORT=8080
