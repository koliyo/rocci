# Merge into the Tunnel's config (or Zero Trust Public Hostname UI).
# Do not commit credentials.json or the tunnel token.
# First-level *-example*.rocci.dev names use Universal SSL. Deep
# *.examples.* names still need ACM. Staging example hosts stay Access-gated.
# Production is hybrid only on :8080. Staging (including live examples) is :8081.
# Do not publish <id>-example.rocci.dev or *.examples.rocci.dev until advertised.
ingress:
  - hostname: staging.rocci.dev
    service: http://127.0.0.1:8081
  - hostname: live-counter-example-staging.rocci.dev
    service: http://127.0.0.1:8081
  - hostname: datastar-example-staging.rocci.dev
    service: http://127.0.0.1:8081
  - hostname: snake-example-staging.rocci.dev
    service: http://127.0.0.1:8081
  - hostname: "*.examples.staging.rocci.dev"
    service: http://127.0.0.1:8081
  - hostname: rocci.dev
    service: http://127.0.0.1:8080
  - hostname: www.rocci.dev
    service: http://127.0.0.1:8080
  - service: http_status:404
