:80 {
	root * /srv

	@hashed path /assets/*
	handle @hashed {
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		try_files {path} {path}/index.html
		file_server
		header Cache-Control "no-cache"
	}
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		root * /srv
		file_server
	}
}
