:80 {
	redir /news/introducing-rocci/ /docs/start/what-is-rocci/ 308
	redir /news/rocdown-static-collections/ /rocdown/site-config/ 308
	redir /news/rocci-desktop-apps/ /docs/tutorials/ship/ 308
	@retired_news path /news/ /news/feed.xml
	respond @retired_news 410

	handle /actions/* {
		reverse_proxy islands:8001 {
			flush_interval -1
		}
	}
	handle /sse {
		reverse_proxy islands:8001 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy islands:8001
	}
	@hashed path /assets/*
	handle @hashed {
		root * /src/site/dist
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}
	handle {
		root * /src/site/dist
		try_files {path} {path}/index.html
		file_server
		header Cache-Control "no-cache"
	}
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		root * /src/site/dist
		file_server
	}
}
