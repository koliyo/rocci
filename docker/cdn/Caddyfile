:80 {
	redir /news/introducing-rocci/ /docs/start/what-is-rocci/ 308
	redir /news/rocdown-static-collections/ /rocdown/site-config/ 308
	redir /news/rocci-desktop-apps/ /docs/tutorials/ship/ 308
	@retired_news path /news/ /news/feed.xml
	respond @retired_news 410

	handle /play/blocks/* {
		reverse_proxy blocks:8000 {
			flush_interval -1
		}
		header Cache-Control "no-cache"
	}
	handle /actions/* {
		reverse_proxy islands:8001 {
			flush_interval -1
		}
	}
	handle /sse {
		reverse_proxy islands:8001 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy islands:8001
	}
	handle /health/blocks {
		reverse_proxy blocks:8000
	}
	@hashed path /assets/*
	handle @hashed {
		root * /src/site/dist
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}
	handle {
		root * /src/site/dist
		file_server
		header Cache-Control "no-cache"
	}
}
