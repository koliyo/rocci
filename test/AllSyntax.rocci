module CounterPage exposing [counterPage]

import pf.Html
import Design

Tone : [Neutral, Positive]

@css {
    body { font-family: system-ui, sans-serif; }
}

@fixture{target: Hello}
helloSample = { name: "Roc" }

@component
Badge = |{ tone ?? Neutral }, content|
    <span class={badgeClass(tone)}>
        {content}
    </span>

## Simple greeting used by CounterPage.
@component
Hello = |{ name ?? "World" }|
    <p>Hello, {name}</p>

@component
CounterCard = |{ count }|
    <section id="counter" class="counter-card">
        <output>{Num.toStr(count)}</output>
        <Badge tone={Positive}>Current count</Badge>
    </section>

@component
CounterPage = |{ person, count }|
    <main id="counter-page">
        <Hello />
        <Hello name={person.name} />
        <CounterCard count={count} />
    </main>

@component
TodoList = |{ items, state }| {
    @match state {
        Loading => <Spinner />

        Failed(message) => <ErrorNotice message={message} />

        Ready =>
            @if List.isEmpty(items) {
                <EmptyState />
            } @else {
                <ul>
                    @for item in items {
                        <TodoRow item={item} />
                    }
                </ul>
            }
    }
}

@component
AccountActions = |{ user }| {
    @if user.isSignedIn {
        <LogoutButton />
    } @else if user.canRegister {
        <RegisterButton />
    } @else {
        <LoginButton />
    }
}

@component
FilteredList = |{ items, query }| {
    @let visible = List.keepIf(items, |item| matches(item, query))

    @if List.isEmpty(visible) {
        <EmptyState query={query} />
    } @else {
        <ItemList items={visible} />
    }
}

@component
RequestState = |{ state, active }| {
    @match state {
        Loading => <Spinner />

        Failed({ message }) => <ErrorNotice message={message} />

        Ready(items) if !List.isEmpty(items) => <ItemList items={items} />
        Ready(_) => <>
            <Heading text="Ready" />
            <Design.Button tone={if active { Positive } else { Neutral }} />
        </>
    }
}

@component
ProfileLink = |{ person, selected }|
    <a
        href={person.url}
        class={if selected { "selected" } else { "" }}
        aria-current={if selected { "page" } else { "false" }}
    >
        {person.name}
    </a>

@component
VisibleCheck = |{ user, permissions }| {
    @if isVisible({ user, permissions }) {
        <Profile />
    } @else {
        <p></p>
    }
}

@component
StatusMatch = |{ pair }| {
    @match ({ status, items }) {
        { status: Loading } => <Spinner />
        { status: Ready } => <ItemList items={items} />
    }
}

badgeClass = |tone| {
    match tone {
        Neutral => "badge"
        Positive => "badge badge--positive"
    }
}

@get:view("/") {
    counterPage({ person: { name: "Roc" }, count: 0 })
}

@post:fragment("/actions/card") {
    counterCard({ count: 0 })
}

@put:fragment("/actions/put") = |_state, _request| {
    counterCard({ count: 1 })
}

@patch:fragment("/actions/patch") {
    counterCard({ count: 2 })
}

@delete:fragment("/actions/delete-card") {
    counterCard({ count: 3 })
}

@post:command("/actions/increment") {
    { count: 0 }
}

@put:command("/actions/command-put") = |_state| {
    { count: 1 }
}

@patch:command("/actions/command-patch") {
    { items: ["a"] }
}

@delete:command("/actions/command-delete") {
    { remaining: 0 }
}

@get:live("/sse") {
    counterPage({ person: { name: "Roc" }, count: 0 })
}
